    wimpact_x_11 := time
if barstate.islast
    if onWeekly
        array<int> wRight = array.from((na(wimpact_x_1) ? timestamp("GMT+0", 2026, 3, 3, 16, 25) : wimpact_x_1), (na(wimpact_x_2) ? timestamp("GMT+0", 2026, 2, 9, 11, 1) : wimpact_x_2), timestamp("GMT+0", 2027, 9, 11, 21, 5), (na(wimpact_x_4) ? timestamp("GMT+0", 2026, 6, 23, 9, 43) : wimpact_x_4), (na(wimpact_x_5) ? timestamp("GMT+0", 2026, 6, 8, 11, 12) : wimpact_x_5), (na(wimpact_x_6) ? timestamp("GMT+0", 2026, 5, 6, 10, 51) : wimpact_x_6), timestamp("GMT+0", 2027, 9, 11, 21, 5), (na(wimpact_x_8) ? timestamp("GMT+0", 2026, 6, 3, 14, 33) : wimpact_x_8), (na(wimpact_x_9) ? timestamp("GMT+0", 2026, 8, 19, 15, 31) : wimpact_x_9), (na(wimpact_x_10) ? timestamp("GMT+0", 2026, 8, 7, 14, 30) : wimpact_x_10), (na(wimpact_x_11) ? timestamp("GMT+0", 2026, 7, 23, 14, 24) : wimpact_x_11), timestamp("GMT+0", 2027, 9, 11, 21, 5), timestamp("GMT+0", 2027, 9, 11, 21, 5))
        for i = 0 to array.size(wLeft) - 1
            rCol = array.get(wCol, i)
            wRank = array.size(wLeft) - i
            if not inspectOneRB or wRank == rbFromLast
                box.new(array.get(wLeft, i), array.get(wTop, i), array.get(wRight, i), array.get(wBottom, i), border_color=rCol, border_width=1, border_style=line.style_dashed, bgcolor=na, xloc=xloc.bar_time)
