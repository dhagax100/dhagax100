    var array<bool> wStructLow = array.new<bool>()
    if barstate.isfirst
        array.concat(wStructLow, array.from(false, false, false, false, false, false, false, false, false, false, true, true, true, true, true, true, true, true, true, true))
        array.concat(wStructLow, array.from(true, false, true, false))
    if barstate.islast
        if onWeekly
            for i = 0 to array.size(wStructX) - 1
                sYY = array.get(wStructLow, i) ? array.get(wStructY, i) - lowGap : array.get(wStructY, i)
                label.new(array.get(wStructX, i), sYY, array.get(wStructTxt, i), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=array.get(wStructCol, i), size=size.small)
    true
