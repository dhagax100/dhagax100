        array<int> wRight = array.from((na(wimpact_x_1) ? timestamp("GMT+0", 2026, 3, 3, 14, 24) : wimpact_x_1), (na(wimpact_x_2) ? timestamp("GMT+0", 2026, 2, 9, 12, 7) : wimpact_x_2), timestamp("GMT+0", 2027, 9, 11, 19, 5), (na(wimpact_x_4) ? timestamp("GMT+0", 2026, 6, 19, 4, 57) : wimpact_x_4), (na(wimpact_x_5) ? timestamp("GMT+0", 2026, 6, 8, 9, 31) : wimpact_x_5), (na(wimpact_x_6) ? timestamp("GMT+0", 2026, 5, 6, 10, 45) : wimpact_x_6), timestamp("GMT+0", 2027, 9, 11, 19, 5), (na(wimpact_x_8) ? timestamp("GMT+0", 2026, 6, 5, 13, 0) : wimpact_x_8), (na(wimpact_x_9) ? timestamp("GMT+0", 2026, 8, 19, 13, 29) : wimpact_x_9), (na(wimpact_x_10) ? timestamp("GMT+0", 2026, 8, 7, 12, 34) : wimpact_x_10), (na(wimpact_x_11) ? timestamp("GMT+0", 2026, 7, 23, 12, 43) : wimpact_x_11), timestamp("GMT+0", 2027, 9, 11, 19, 5), timestamp("GMT+0", 2027, 9, 11, 19, 5))
        for i = 0 to array.size(wLeft) - 1
