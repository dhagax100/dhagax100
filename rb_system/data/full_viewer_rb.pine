//@version=6
indicator("FXCM RB - Python Reference (Weekly + H4 + 5m BSO)", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)
// GENERATED FROM 1-MINUTE FXCM BID DATA. RB zones/lifecycle follow
// RB_Indicator_v1.pine's addRBFromSwing/tryBullARB/tryBearARB/STEP2/STEP3
// verbatim (weekly_rb_generator.py / h4_rb_engine.py). Drawing convention
// (from that pine file's own header): dashed hollow boxes; IRB
// blue(bull)/black(bear) by raw wick; ARB green; ORB red, hidden on H4/5m
// (only ever drawn on the Weekly chart here) -- flagged in that same header
// comment as a convention to double-check for RB, not silently changed here.
// Weekly chart: Weekly RB zones + swing/MSS labels + table (+ 'Inspect one
// RB only' toggle). H4 chart: H4 RB zones + table (+ 'Inspect one 4H RB
// only' toggle). 5m chart: H4 RB boxes (no table) + the 5m BSO
// entry/SL/TP lines, R:R boxes, and ledger table (+ 'Inspect one 5m BSO
// only' toggle). Every other timeframe draws nothing. All table times are
// Riyadh, labeled (RYD).
float lowGap = ta.atr(14) * 0.08
bool onWeekly = timeframe.period == "1W"
bool onH4 = timeframe.period == "240"
bool onFive = timeframe.period == "5"
bool inspectOneRB = input.bool(false, "Inspect one RB only", group="Weekly RB inspection")
int rbFromLast = input.int(1, "RB from last", minval=1, maxval=13, group="Weekly RB inspection")
bool inspectOneH4RB = input.bool(false, "Inspect one 4H RB only", group="H4 RB inspection")
int h4RbFromLast = input.int(1, "4H RB from last", minval=1, maxval=200, group="H4 RB inspection")
int focusGateNum = input.int(0, "Focus one gate only (H4/5m), 0=off", minval=0, maxval=1, group="Control gate focus", tooltip="Gate numbers match rb_control_gates.csv's own gate_index column exactly (0 doubles as off and the trivial dataset-start gate, which never has any authorized zones or entries anyway).")
var array<int> gateStart = array.new<int>()
var array<int> gateEnd = array.new<int>()
var array<int> wStructX = array.new<int>()
if barstate.isfirst
    array.concat(wStructX, array.from(timestamp("GMT+0", 2025, 12, 28, 22, 0), timestamp("GMT+0", 2026, 1, 25, 22, 0), timestamp("GMT+0", 2026, 2, 8, 22, 0), timestamp("GMT+0", 2026, 3, 22, 21, 0), timestamp("GMT+0", 2026, 4, 12, 21, 0), timestamp("GMT+0", 2026, 5, 3, 21, 0), timestamp("GMT+0", 2026, 5, 24, 21, 0), timestamp("GMT+0", 2026, 6, 14, 21, 0), timestamp("GMT+0", 2026, 7, 12, 21, 0), timestamp("GMT+0", 2026, 8, 16, 21, 0), timestamp("GMT+0", 2026, 1, 11, 22, 0), timestamp("GMT+0", 2026, 2, 1, 22, 0), timestamp("GMT+0", 2026, 3, 8, 21, 0), timestamp("GMT+0", 2026, 3, 29, 21, 0), timestamp("GMT+0", 2026, 4, 26, 21, 0), timestamp("GMT+0", 2026, 5, 17, 21, 0), timestamp("GMT+0", 2026, 6, 7, 21, 0), timestamp("GMT+0", 2026, 6, 21, 21, 0), timestamp("GMT+0", 2026, 7, 26, 21, 0), timestamp("GMT+0", 2026, 8, 30, 21, 0)))
    array.concat(wStructX, array.from(timestamp("GMT+0", 2026, 2, 1, 22, 0), timestamp("GMT+0", 2026, 3, 22, 21, 0), timestamp("GMT+0", 2026, 4, 26, 21, 0), timestamp("GMT+0", 2026, 7, 12, 21, 0)))
var array<float> wStructY = array.new<float>()
if barstate.isfirst
    array.concat(wStructY, array.from(1.17542, 1.20825, 1.19283, 1.16394, 1.18488, 1.17963, 1.16854, 1.16217, 1.14822, 1.17112, 1.15692, 1.17652, 1.14089, 1.14427, 1.16547, 1.15759, 1.14994, 1.13242, 1.13529, 1.15659))
    array.concat(wStructY, array.from(1.17652, 1.16394, 1.16547, 1.14822))
var array<string> wStructTxt = array.new<string>()
if barstate.isfirst
    array.concat(wStructTxt, array.from("▲", "▲", "▲", "▲", "▲", "▲", "▲", "▲", "▲", "▲", "▼", "▼", "▼", "▼", "▼", "▼", "▼", "▼", "▼", "▼"))
    array.concat(wStructTxt, array.from("✕", "✕", "✕", "✕"))
var array<color> wStructCol = array.new<color>()
if barstate.isfirst
    array.concat(wStructCol, array.from(color.blue, color.blue, color.blue, color.blue, color.blue, color.blue, color.blue, color.blue, color.blue, color.blue, color.black, color.black, color.black, color.black, color.black, color.black, color.black, color.black, color.black, color.black))
    array.concat(wStructCol, array.from(color.black, color.blue, color.black, color.blue))
var array<bool> wStructLow = array.new<bool>()
if barstate.isfirst
    array.concat(wStructLow, array.from(false, false, false, false, false, false, false, false, false, false, true, true, true, true, true, true, true, true, true, true))
    array.concat(wStructLow, array.from(true, false, true, false))
rbBlock1() =>
    if barstate.islast
        if onWeekly
            for i = 0 to array.size(wStructX) - 1
                sYY = array.get(wStructLow, i) ? array.get(wStructY, i) - lowGap : array.get(wStructY, i)
                label.new(array.get(wStructX, i), sYY, array.get(wStructTxt, i), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=array.get(wStructCol, i), size=size.small)
    true
