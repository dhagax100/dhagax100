//@version=6
indicator("FXCM Weekly OB - Python Reference", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)
// GENERATED FROM 1-MINUTE FXCM BID DATA. OB decisions use locked Weekly swing/MSS; displayed body uses observed first/last 60m candles; first source is close; body source offset is 0m.
// Attach to EURUSD, 1W, FXCM.
float lowGap = ta.atr(14) * 0.08
bool showOriginAudit = input.bool(true, "Show OB origin-candle audit labels")
bool inspectOneOB = input.bool(false, "Inspect one OB only", group="OB inspection")
int obFromLast = input.int(1, "OB from last", minval=1, maxval=13, group="OB inspection", tooltip="1 = latest OB, 2 = the OB before it, and so on.")
var table ledger = table.new(position.top_right, 10, 21, border_width=1)
var int impact_x_1 = na
if time <= timestamp("GMT+0", 2026, 3, 3, 8, 12) and timestamp("GMT+0", 2026, 3, 3, 8, 12) < time_close
    impact_x_1 := time
var int impact_x_3 = na
if time <= timestamp("GMT+0", 2026, 4, 14, 14, 55) and timestamp("GMT+0", 2026, 4, 14, 14, 55) < time_close
    impact_x_3 := time
var int impact_x_5 = na
if time <= timestamp("GMT+0", 2026, 6, 5, 15, 37) and timestamp("GMT+0", 2026, 6, 5, 15, 37) < time_close
    impact_x_5 := time
var int impact_x_8 = na
if time <= timestamp("GMT+0", 2026, 8, 19, 12, 49) and timestamp("GMT+0", 2026, 8, 19, 12, 49) < time_close
    impact_x_8 := time
var int impact_x_9 = na
if time <= timestamp("GMT+0", 2026, 7, 30, 13, 48) and timestamp("GMT+0", 2026, 7, 30, 13, 48) < time_close
    impact_x_9 := time
if barstate.islast
    label.new(timestamp("GMT+0", 2025, 12, 28, 22, 0), 1.17542, "▲", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=color.blue, size=size.small)
    label.new(timestamp("GMT+0", 2026, 1, 25, 22, 0), 1.20825, "▲", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=color.blue, size=size.small)
    label.new(timestamp("GMT+0", 2026, 2, 8, 22, 0), 1.19283, "▲", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=color.blue, size=size.small)
