// ICT Setup 1 (S1) — Pine Script v5
// Visualizes the exact Weekly-bias -> 4H-confirm -> 5M-entry cascade built
// in ctrader/ICT_EA_2.cs, on ONE chart, so the EA's behavior can be sanity
// checked visually before trusting it live. RUN THIS ON A 5-MINUTE CHART --
// Weekly and 4H are pulled in via request.security(); 5M is native.
//
// Rules, same as the EA:
// - BIAS (Weekly): a POI (OB, FVG, or RB -- any type) goes live on first
//   wick touch, stays live across weekly rollovers until a candle BODY
//   closes inside it, or the matching-direction swing (swing high kills a
//   bearish POI, swing low kills a bullish one) confirms after entry.
// - CONFIRM (4H): once bias is live, hunt 4H POIs (any type) matching bias
//   direction, formed at/after bias-touch time. Same two kill conditions.
//   A newly-touched 4H zone overlapping the one already watched merges
//   into it instead of restarting.
// - ENTRY (5M): once price wicks into the live 4H zone, trail a stop to
//   the newest matching 5M swing (sell-stop at swing lows for a bearish
//   cascade, buy-stop at swing highs for bullish). SL = swing candle's own
//   wick +1 pip; TP = InpRR_Target x that risk. A fill does NOT reset the
//   cascade -- it keeps hunting the same 4H zone while it stays live.
//
// Swings + MSS are the shared engine underneath all three tiers -- the
// IDENTICAL detection logic as pine/ICT_Full_OB_v24.pine, run three
// independent times (once per timeframe). "S1 ENTRY POI" marks whichever
// 4H zone is currently escalated to the 5M watch; the trailing entry
// level, SL and TP are drawn live as rays, and every simulated fill is
// marked permanently so you can review past setups.
//
// First build -- not compiled/tested in the Pine Editor yet. Same
// test-and-refine expectation as every other file in this project.
//@version=5
indicator("ICT Setup 1 (S1)", shorttitle = "S1", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500, max_bars_back = 5000)

if barstate.isfirst and timeframe.period != "5"
    runtime.error("S1 must run on a 5-minute chart (Weekly/4H are pulled in via request.security()). Switch the chart to 5m.")

// ===================== INPUTS =====================
InpDisplayFrom   = input.time(timestamp("2025-07-25"), "Display from date")
InpRR_Target     = input.float(3.0, "Reward:risk target (TP)", minval = 0.1, group = "Risk")
InpPipSize       = input.float(0.0001, "Pip size (0.0001 FX, 0.01 JPY/metals)", group = "Risk")
InpLondonStartHour  = input.int(8, "London session start hour", group = "Session")
InpNewYorkStartHour = input.int(13, "New York session start hour", group = "Session")
InpSessionWindowHrs = input.int(4, "Trading window length (hrs)", group = "Session")
InpMaxLabelsPerCategory = input.int(150, "Max swing-high/low/MSS labels per tier", minval = 1, maxval = 160)
InpMaxPoiPerCategory    = input.int(60, "Max POI boxes shown per tier/type", minval = 1, maxval = 160)
InpSwingLowGapATR = input.float(0.08, "Swing-low arrow gap (x ATR14)", minval = 0.0)
InpShowW  = input.bool(true, "Show Weekly (bias) structure", group = "Visuals")
InpShowH4 = input.bool(true, "Show 4H (confirm) structure", group = "Visuals")
InpShowM5 = input.bool(true, "Show 5M (entry) structure", group = "Visuals")

// ===================== TYPE DEFINITIONS =====================
type SwEv
    int   confirmIdx
    int   kind         // 0=high, 1=low
    int   swingIdx
    float price

type MssEv
    int   atIdx
    int   brokenIdx
    float price
    bool  toUp

type ObZone
    int   candle
    float zb
    float zt
    bool  bullish
    int   triggerK
    int   eligibleK
    int   stopK
    int   state         // 0=IFOB, 1=AOB, 2=OOB, 3=SPENT, 4=AIFOB
    int   origState
    int   preSpentState

type FvgZone
    int   leftIdx
    float zb
    float zt
    bool  bullish
    int   triggerK
    int   eligibleK
    int   stopK
    int   state          // 0=IFVG, 1=AFVG, 2=OFVG, 3=SPENT
    int   origin
    int   preSpentState

type RbZone
    int   leftIdx
    float zb
    float zt
    bool  bullish
    int   triggerK
    int   eligibleK
    int   stopK
    int   state          // 0=IRB, 1=ARB, 2=ORB, 3=SPENT
    int   origin
    int   preSpentState

// ===================== PER-TIER PERSISTENT STATE =====================
// Weekly (bias)
var wEvents = array.new<SwEv>()
var wMsses  = array.new<MssEv>()
var wObs    = array.new<ObZone>()
var wFvgs   = array.new<FvgZone>()
var wRbs    = array.new<RbZone>()
var wSwHighs = array.new<int>()
var wSwLows  = array.new<int>()
var wO = array.new<float>()
var wH = array.new<float>()
var wL = array.new<float>()
var wC = array.new<float>()
var wBT = array.new<int>()
var int   wPeakIdx = 0
var int   wTroughIdx = 0
var bool  wHaveSWH = false
var float wSwhPrice = 0.0
var int   wSwhIdx = 0
var bool  wHaveSWL = false
var float wSwlPrice = 0.0
var int   wSwlIdx = 0
var int   wRegime = 0
var int   wEi = 0
var int   wLastSWHidx = -1
var int   wLastSWLidx = -1
var int   wPendBullAifob = -1
var int   wPendBearAifob = -1
var int   wFvgBullScanUpto = -1
var int   wFvgBearScanUpto = -1

// 4H (confirm)
var h4Events = array.new<SwEv>()
var h4Msses  = array.new<MssEv>()
var h4Obs    = array.new<ObZone>()
var h4Fvgs   = array.new<FvgZone>()
var h4Rbs    = array.new<RbZone>()
var h4SwHighs = array.new<int>()
var h4SwLows  = array.new<int>()
var h4O = array.new<float>()
var h4H = array.new<float>()
var h4L = array.new<float>()
var h4C = array.new<float>()
var h4BT = array.new<int>()
var int   h4PeakIdx = 0
var int   h4TroughIdx = 0
var bool  h4HaveSWH = false
var float h4SwhPrice = 0.0
var int   h4SwhIdx = 0
var bool  h4HaveSWL = false
var float h4SwlPrice = 0.0
var int   h4SwlIdx = 0
var int   h4Regime = 0
var int   h4Ei = 0
var int   h4LastSWHidx = -1
var int   h4LastSWLidx = -1
var int   h4PendBullAifob = -1
var int   h4PendBearAifob = -1
var int   h4FvgBullScanUpto = -1
var int   h4FvgBearScanUpto = -1

// 5M (entry)
var m5Events = array.new<SwEv>()
var m5Msses  = array.new<MssEv>()
var m5Obs    = array.new<ObZone>()
var m5Fvgs   = array.new<FvgZone>()
var m5Rbs    = array.new<RbZone>()
var m5SwHighs = array.new<int>()
var m5SwLows  = array.new<int>()
var m5O = array.new<float>()
var m5H = array.new<float>()
var m5L = array.new<float>()
var m5C = array.new<float>()
var m5BT = array.new<int>()
var int   m5PeakIdx = 0
var int   m5TroughIdx = 0
var bool  m5HaveSWH = false
var float m5SwhPrice = 0.0
var int   m5SwhIdx = 0
var bool  m5HaveSWL = false
var float m5SwlPrice = 0.0
var int   m5SwlIdx = 0
var int   m5Regime = 0
var int   m5Ei = 0
var int   m5LastSWHidx = -1
var int   m5LastSWLidx = -1
var int   m5PendBullAifob = -1
var int   m5PendBearAifob = -1
var int   m5FvgBullScanUpto = -1
var int   m5FvgBearScanUpto = -1

// Shared drawing object stores (bulk-cleared & fully redrawn every last bar)
var drawnLabels = array.new<label>()
var drawnBoxes  = array.new<box>()
var drawnLines  = array.new<line>()

// ===================== MTF ACCUMULATION (push-on-close only) =====================
// Weekly and 4H bars are pulled in via request.security() and pushed into
// our own arrays only once each higher-TF bar actually closes -- so every
// bar ever in wO/h4O is fully confirmed, never a still-forming one. 5M
// uses the SAME push-on-close technique against the chart's own native
// feed, for one consistent "LastClosed = last array entry" rule across
// all three tiers (no repaint, and it matches the EA's own discipline of
// only ever acting on closed bars).
[wSecO, wSecH, wSecL, wSecC, wSecT] = request.security(syminfo.tickerid, "W", [open, high, low, close, time], lookahead = barmerge.lookahead_off)
[h4SecO, h4SecH, h4SecL, h4SecC, h4SecT] = request.security(syminfo.tickerid, "240", [open, high, low, close, time], lookahead = barmerge.lookahead_off)
wAtr  = request.security(syminfo.tickerid, "W", ta.atr(14))
h4Atr = request.security(syminfo.tickerid, "240", ta.atr(14))
m5Atr = ta.atr(14)

var float wPrevO = na
var float wPrevH = na
var float wPrevL = na
var float wPrevC = na
var int   wPrevT = na
wNewBar = false
if not na(wSecT)
    if not na(wPrevT) and wSecT != wPrevT
        array.push(wO, wPrevO)
        array.push(wH, wPrevH)
        array.push(wL, wPrevL)
        array.push(wC, wPrevC)
        array.push(wBT, wPrevT)
        wNewBar := true
    wPrevT := wSecT
    wPrevO := wSecO
    wPrevH := wSecH
    wPrevL := wSecL
    wPrevC := wSecC

var float h4PrevO = na
var float h4PrevH = na
var float h4PrevL = na
var float h4PrevC = na
var int   h4PrevT = na
h4NewBar = false
if not na(h4SecT)
    if not na(h4PrevT) and h4SecT != h4PrevT
        array.push(h4O, h4PrevO)
        array.push(h4H, h4PrevH)
        array.push(h4L, h4PrevL)
        array.push(h4C, h4PrevC)
        array.push(h4BT, h4PrevT)
        h4NewBar := true
    h4PrevT := h4SecT
    h4PrevO := h4SecO
    h4PrevH := h4SecH
    h4PrevL := h4SecL
    h4PrevC := h4SecC

var float m5PrevO = na
var float m5PrevH = na
var float m5PrevL = na
var float m5PrevC = na
var int   m5PrevT = na
m5NewBar = false
if not na(m5PrevT) and time != m5PrevT
    array.push(m5O, m5PrevO)
    array.push(m5H, m5PrevH)
    array.push(m5L, m5PrevL)
    array.push(m5C, m5PrevC)
    array.push(m5BT, m5PrevT)
    m5NewBar := true
m5PrevT := time
m5PrevO := open
m5PrevH := high
m5PrevL := low
m5PrevC := close

wSwLowGap  = wAtr * InpSwingLowGapATR
h4SwLowGap = h4Atr * InpSwingLowGapATR
m5SwLowGap = m5Atr * InpSwingLowGapATR

// ===================== SHARED HELPER FUNCTIONS (parameterized, reused by all 3 tiers) =====================
addSH(array<int> arr, int idx) =>
    sz = array.size(arr)
    doPush = sz == 0
    if not doPush
        doPush := array.get(arr, sz - 1) != idx
    if doPush
        array.push(arr, idx)

addSL(array<int> arr, int idx) =>
    sz = array.size(arr)
    doPush = sz == 0
    if not doPush
        doPush := array.get(arr, sz - 1) != idx
    if doPush
        array.push(arr, idx)

addEv(array<SwEv> arr, int cIdx, int kind, int sIdx, float pr) =>
    array.push(arr, SwEv.new(cIdx, kind, sIdx, pr))

addMss(array<MssEv> arr, int aIdx, int bIdx, float pr, bool up) =>
    array.push(arr, MssEv.new(aIdx, bIdx, pr, up))

addOB(array<ObZone> arr, int cand, float zb, float zt, bool bull, int tK, int st) =>
    eK = (st == 1 or st == 4) ? tK : -1
    array.push(arr, ObZone.new(cand, zb, zt, bull, tK, eK, -1, st, st, st))

addFVG(array<FvgZone> arr, int leftIdx, float zb, float zt, bool bull, int tK, int st) =>
    eK = (st == 1) ? tK : -1
    array.push(arr, FvgZone.new(leftIdx, zb, zt, bull, tK, eK, -1, st, st, st))

addRB(array<RbZone> arr, int leftIdx, float zb, float zt, bool bull, int tK, int st) =>
    eK = (st == 1) ? tK : -1
    array.push(arr, RbZone.new(leftIdx, zb, zt, bull, tK, eK, -1, st, st, st))

addRBFromSwing(array<RbZone> rbArr, array<float> oArr, array<float> hArr, array<float> lArr, array<float> cArr, int idx, bool isHigh, int tK, int st) =>
    if isHigh
        addRB(rbArr, idx, math.max(array.get(oArr, idx), array.get(cArr, idx)), array.get(hArr, idx), false, tK, st)
    else
        addRB(rbArr, idx, array.get(lArr, idx), math.min(array.get(oArr, idx), array.get(cArr, idx)), true, tK, st)

tryCreateIFVGs(array<FvgZone> fvgArr, array<float> hArr, array<float> lArr, int lo, int hi, bool bullish, int triggerK) =>
    if hi >= lo + 2
        for c3 = lo + 2 to hi
            c1 = c3 - 2
            if bullish
                h1 = array.get(hArr, c1)
                l3 = array.get(lArr, c3)
                if h1 < l3
                    addFVG(fvgArr, c1, h1, l3, true, triggerK, 0)
            else
                l1 = array.get(lArr, c1)
                h3 = array.get(hArr, c3)
                if l1 > h3
                    addFVG(fvgArr, c1, h3, l1, false, triggerK, 0)

tryCreateAFVGs(array<FvgZone> fvgArr, array<float> hArr, array<float> lArr, int lo, int hi, bool bullish, int triggerK, float guardPrice) =>
    if hi >= lo + 2
        for c3 = lo + 2 to hi
            c1 = c3 - 2
            if bullish
                l1 = array.get(lArr, c1)
                h3 = array.get(hArr, c3)
                if l1 > h3
                    l3 = array.get(lArr, c3)
                    if l1 > guardPrice and l3 > guardPrice
                        addFVG(fvgArr, c1, h3, l1, true, triggerK, 1)
            else
                h1 = array.get(hArr, c1)
                l3 = array.get(lArr, c3)
                if h1 < l3
                    h3 = array.get(hArr, c3)
                    if h1 < guardPrice and h3 < guardPrice
                        addFVG(fvgArr, c1, h1, l3, false, triggerK, 1)

tryBullAOB(array<ObZone> obArr, array<float> oArr, array<float> hArr, array<float> lArr, array<float> cArr, int pReg, int aobSWHi, int newSwlI, float newSwlP, int k) =>
    if pReg == 1 and aobSWHi >= 0
        armedSwhPrice = array.get(hArr, aobSWHi)
        refViolated = false
        for v = aobSWHi + 1 to newSwlI
            if array.get(hArr, v) >= armedSwhPrice
                refViolated := true
        if not refViolated
            lo2 = math.max(0, math.min(aobSWHi - 1, newSwlI))
            hi2 = math.max(aobSWHi - 1, newSwlI)
            best2 = -1
            for x = lo2 to hi2
                if x >= 0
                    cX = array.get(cArr, x)
                    oX = array.get(oArr, x)
                    okB2 = false
                    if cX > oX
                        okB2 := best2 == -1 or cX > array.get(cArr, best2)
                    if okB2
                        best2 := x
            if best2 != -1 and array.get(lArr, best2) > newSwlP
                oB = array.get(oArr, best2)
                cB = array.get(cArr, best2)
                addOB(obArr, best2, math.min(oB, cB), math.max(oB, cB), true, k, 1)

tryBearAOB(array<ObZone> obArr, array<float> oArr, array<float> hArr, array<float> lArr, array<float> cArr, int pReg, int aobSWLi, int newSwhI, float newSwhP, int k) =>
    if pReg == 2 and aobSWLi >= 0
        armedSwlPrice = array.get(lArr, aobSWLi)
        refViolated = false
        for v = aobSWLi + 1 to newSwhI
            if array.get(lArr, v) <= armedSwlPrice
                refViolated := true
        if not refViolated
            lo2 = math.max(0, math.min(aobSWLi - 1, newSwhI))
            hi2 = math.max(aobSWLi - 1, newSwhI)
            best2 = -1
            for x = lo2 to hi2
                if x >= 0
                    cX = array.get(cArr, x)
                    oX = array.get(oArr, x)
                    okB2 = false
                    if cX < oX
                        okB2 := best2 == -1 or cX < array.get(cArr, best2)
                    if okB2
                        best2 := x
            if best2 != -1 and array.get(hArr, best2) < newSwhP
                oB = array.get(oArr, best2)
                cB = array.get(cArr, best2)
                addOB(obArr, best2, math.min(oB, cB), math.max(oB, cB), false, k, 1)

tryBullAFVG(array<FvgZone> fvgArr, array<float> hArr, array<float> lArr, int pReg, int aobSWHi, int newSwlI, float newSwlP, int k) =>
    if pReg == 1 and aobSWHi >= 0
        armedSwhPrice = array.get(hArr, aobSWHi)
        refViolated = false
        for v = aobSWHi + 1 to newSwlI
            if array.get(hArr, v) >= armedSwhPrice
                refViolated := true
        if not refViolated
            lo2 = math.max(0, math.min(aobSWHi - 1, newSwlI))
            hi2 = math.max(aobSWHi - 1, newSwlI)
            tryCreateAFVGs(fvgArr, hArr, lArr, lo2, hi2, true, k, newSwlP)

tryBearAFVG(array<FvgZone> fvgArr, array<float> hArr, array<float> lArr, int pReg, int aobSWLi, int newSwhI, float newSwhP, int k) =>
    if pReg == 2 and aobSWLi >= 0
        armedSwlPrice = array.get(lArr, aobSWLi)
        refViolated = false
        for v = aobSWLi + 1 to newSwhI
            if array.get(lArr, v) <= armedSwlPrice
                refViolated := true
        if not refViolated
            lo2 = math.max(0, math.min(aobSWLi - 1, newSwhI))
            hi2 = math.max(aobSWLi - 1, newSwhI)
            tryCreateAFVGs(fvgArr, hArr, lArr, lo2, hi2, false, k, newSwhP)

tryBullARB(array<RbZone> rbArr, array<float> oArr, array<float> hArr, array<float> lArr, array<float> cArr, int pReg, int aobSWHi, int newSwlI, int k) =>
    if pReg == 1 and aobSWHi >= 0
        armedSwhPrice = array.get(hArr, aobSWHi)
        refViolated = false
        for v = aobSWHi + 1 to newSwlI
            if array.get(hArr, v) >= armedSwhPrice
                refViolated := true
        if not refViolated
            addRBFromSwing(rbArr, oArr, hArr, lArr, cArr, aobSWHi, true, k, 1)

tryBearARB(array<RbZone> rbArr, array<float> oArr, array<float> hArr, array<float> lArr, array<float> cArr, int pReg, int aobSWLi, int newSwhI, int k) =>
    if pReg == 2 and aobSWLi >= 0
        armedSwlPrice = array.get(lArr, aobSWLi)
        refViolated = false
        for v = aobSWLi + 1 to newSwhI
            if array.get(lArr, v) <= armedSwlPrice
                refViolated := true
        if not refViolated
            addRBFromSwing(rbArr, oArr, hArr, lArr, cArr, aobSWLi, false, k, 1)

tryBullAIFOB(array<ObZone> obArr, array<float> oArr, array<float> cArr, bool pHaveSWH, int pSwhI, int pLastSWLi, int newSwlI, int k) =>
    result = -1
    if pHaveSWH and pSwhI >= 0 and pLastSWLi >= 0
        lo = math.max(0, math.min(math.min(pLastSWLi, newSwlI), pSwhI - 1))
        hi = math.max(math.max(pLastSWLi, newSwlI), pSwhI - 1)
        best = -1
        for x = lo to hi
            if x >= 0
                cX = array.get(cArr, x)
                oX = array.get(oArr, x)
                okB = false
                if cX < oX
                    okB := best == -1 or cX < array.get(cArr, best)
                if okB
                    best := x
        if best != -1
            oB = array.get(oArr, best)
            cB = array.get(cArr, best)
            addOB(obArr, best, math.min(oB, cB), math.max(oB, cB), true, k, 4)
            result := array.size(obArr) - 1
    result

tryBearAIFOB(array<ObZone> obArr, array<float> oArr, array<float> cArr, bool pHaveSWL, int pSwlI, int pLastSWHi, int newSwhI, int k) =>
    result = -1
    if pHaveSWL and pSwlI >= 0 and pLastSWHi >= 0
        lo = math.max(0, math.min(math.min(pLastSWHi, newSwhI), pSwlI - 1))
        hi = math.max(math.max(pLastSWHi, newSwhI), pSwlI - 1)
        best = -1
        for x = lo to hi
            if x >= 0
                cX = array.get(cArr, x)
                oX = array.get(oArr, x)
                okB = false
                if cX > oX
                    okB := best == -1 or cX > array.get(cArr, best)
                if okB
                    best := x
        if best != -1
            oB = array.get(oArr, best)
            cB = array.get(cArr, best)
            addOB(obArr, best, math.min(oB, cB), math.max(oB, cB), false, k, 4)
            result := array.size(obArr) - 1
    result

// ===================== SHARED PER-BAR ENGINE (Weekly/4H/5M all call this) =====================
// Identical swing-detection + regime/MSS/OB+FVG+RB logic as pine/ICT_Full_OB_v24.pine,
// written once and called once per tier (below) with that tier's own arrays and
// state passed in/out -- avoids tripling this block, which is what pushed the
// script over Pine's 550-local-scope compile limit the first time around.
runEngine(array<float> oArr, array<float> hArr, array<float> lArr, array<float> cArr, array<SwEv> evArr, array<MssEv> mssArr, array<ObZone> obArr, array<FvgZone> fvgArr, array<RbZone> rbArr, array<int> swHArr, array<int> swLArr, int peakIdx, int troughIdx, bool haveSWH, float swhPrice, int swhIdx, bool haveSWL, float swlPrice, int swlIdx, int regime, int ei, int lastSWHidx, int lastSWLidx, int pendBullAifob, int pendBearAifob, int fvgBullScanUpto, int fvgBearScanUpto) =>
    wN = array.size(oArr)
    if wN >= 2
        i = wN - 1
        isBull = array.get(cArr, i) >= array.get(oArr, i)
        brkH = array.get(hArr, i) > array.get(hArr, i - 1)
        brkL = array.get(lArr, i) < array.get(lArr, i - 1)
        dualAct = brkH and brkL

        prevDual = false
        eCnt = array.size(evArr)
        if eCnt >= 2
            ev1 = array.get(evArr, eCnt - 1)
            ev2 = array.get(evArr, eCnt - 2)
            prevDual := (ev1.kind != ev2.kind) and (ev1.confirmIdx == ev2.confirmIdx) and (ev1.confirmIdx == i - 1)
        blockPD = prevDual and not dualAct
        evBeforeSwing = array.size(evArr)

        if not isBull
            if array.get(hArr, i) > array.get(hArr, peakIdx)
                peakIdx := i
            if brkH
                lk = array.size(evArr) > 0 ? array.get(evArr, array.size(evArr) - 1).kind : -1
                if lk != 1 and not blockPD
                    addSL(swLArr, troughIdx)
                    addEv(evArr, i, 1, troughIdx, array.get(lArr, troughIdx))
                    peakIdx := i
            if array.get(lArr, i) < array.get(lArr, troughIdx)
                troughIdx := i
            if brkL
                lk2 = array.size(evArr) > 0 ? array.get(evArr, array.size(evArr) - 1).kind : -1
                if lk2 != 0 and not blockPD
                    addSH(swHArr, peakIdx)
                    addEv(evArr, i, 0, peakIdx, array.get(hArr, peakIdx))
                    troughIdx := i
        else
            if array.get(lArr, i) < array.get(lArr, troughIdx)
                troughIdx := i
            if brkL
                lk3 = array.size(evArr) > 0 ? array.get(evArr, array.size(evArr) - 1).kind : -1
                if lk3 != 0 and not blockPD
                    addSH(swHArr, peakIdx)
                    addEv(evArr, i, 0, peakIdx, array.get(hArr, peakIdx))
                    troughIdx := i
            if array.get(hArr, i) > array.get(hArr, peakIdx)
                peakIdx := i
            if brkH
                lk4 = array.size(evArr) > 0 ? array.get(evArr, array.size(evArr) - 1).kind : -1
                if lk4 != 1 and not blockPD
                    addSL(swLArr, troughIdx)
                    addEv(evArr, i, 1, troughIdx, array.get(lArr, troughIdx))
                    peakIdx := i

        k = i
        evTotal = array.size(evArr)
        peek0 = ei
        while peek0 < evTotal
            pEv = array.get(evArr, peek0)
            if pEv.confirmIdx != k
                break
            if pEv.kind == 0
                lastSWHidx := pEv.swingIdx
            else
                lastSWLidx := pEv.swingIdx
            peek0 += 1

        prevReg = regime
        swhCons = false
        swlCons = false
        aobSWHi = swhIdx
        aobSWLi = swlIdx
        kBull = array.get(cArr, k) >= array.get(oArr, k)

        if not kBull
            if haveSWH and array.get(hArr, k) > swhPrice
                if regime == 0
                    regime := 1
                else if regime == 2
                    regime := 1
                    addMss(mssArr, k, swhIdx, swhPrice, true)
                if pendBullAifob != -1
                    obRef = array.get(obArr, pendBullAifob)
                    obRef.state := 0
                    obRef.origState := 0
                    array.set(obArr, pendBullAifob, obRef)
                    pendBullAifob := -1
                else if lastSWLidx >= 0
                    lo = math.min(math.min(lastSWLidx, k), swhIdx)
                    hi = math.max(math.max(lastSWLidx, k), swhIdx)
                    tryCreateIFVGs(fvgArr, hArr, lArr, lo, hi, true, k)
                    fvgBullScanUpto := hi
                    best = -1
                    for x = lo to hi
                        cX = array.get(cArr, x)
                        oX = array.get(oArr, x)
                        okB = false
                        if cX < oX
                            okB := best == -1 or cX < array.get(cArr, best)
                        if okB
                            best := x
                    if best != -1
                        oB = array.get(oArr, best)
                        cB = array.get(cArr, best)
                        addOB(obArr, best, math.min(oB, cB), math.max(oB, cB), true, k, 0)
                if lastSWLidx >= 0
                    addRBFromSwing(rbArr, oArr, hArr, lArr, cArr, lastSWLidx, false, k, 0)
                haveSWH := false
                swhCons := true

            peek2 = ei
            while peek2 < evTotal
                pEv2 = array.get(evArr, peek2)
                if pEv2.confirmIdx != k
                    break
                if pEv2.kind == 0
                    haveSWH := true
                    swhPrice := pEv2.price
                    swhIdx := pEv2.swingIdx
                    pendBullAifob := -1
                    tryBearAOB(obArr, oArr, hArr, lArr, cArr, prevReg, aobSWLi, pEv2.swingIdx, pEv2.price, k)
                    tryBearAFVG(fvgArr, hArr, lArr, prevReg, aobSWLi, pEv2.swingIdx, pEv2.price, k)
                    tryBearARB(rbArr, oArr, hArr, lArr, cArr, prevReg, aobSWLi, pEv2.swingIdx, k)
                    if pendBearAifob == -1
                        r2 = tryBearAIFOB(obArr, oArr, cArr, haveSWL, aobSWLi, lastSWHidx, pEv2.swingIdx, k)
                        if r2 != -1
                            pendBearAifob := r2
                else
                    haveSWL := true
                    swlPrice := pEv2.price
                    swlIdx := pEv2.swingIdx
                    pendBearAifob := -1
                    tryBullAOB(obArr, oArr, hArr, lArr, cArr, prevReg, aobSWHi, pEv2.swingIdx, pEv2.price, k)
                    tryBullAFVG(fvgArr, hArr, lArr, prevReg, aobSWHi, pEv2.swingIdx, pEv2.price, k)
                    tryBullARB(rbArr, oArr, hArr, lArr, cArr, prevReg, aobSWHi, pEv2.swingIdx, k)
                    if pendBullAifob == -1
                        r3 = tryBullAIFOB(obArr, oArr, cArr, haveSWH, aobSWHi, lastSWLidx, pEv2.swingIdx, k)
                        if r3 != -1
                            pendBullAifob := r3
                peek2 += 1

            if haveSWL and array.get(lArr, k) < swlPrice
                if regime == 0
                    regime := 2
                else if regime == 1
                    regime := 2
                    addMss(mssArr, k, swlIdx, swlPrice, false)
                if pendBearAifob != -1
                    obRef2 = array.get(obArr, pendBearAifob)
                    obRef2.state := 0
                    obRef2.origState := 0
                    array.set(obArr, pendBearAifob, obRef2)
                    pendBearAifob := -1
                else if lastSWHidx >= 0
                    lo2 = math.min(math.min(lastSWHidx, k), swlIdx)
                    hi2 = math.max(math.max(lastSWHidx, k), swlIdx)
                    tryCreateIFVGs(fvgArr, hArr, lArr, lo2, hi2, false, k)
                    fvgBearScanUpto := hi2
                    best2 = -1
                    for x = lo2 to hi2
                        cX = array.get(cArr, x)
                        oX = array.get(oArr, x)
                        okB2 = false
                        if cX > oX
                            okB2 := best2 == -1 or cX > array.get(cArr, best2)
                        if okB2
                            best2 := x
                    if best2 != -1
                        oB = array.get(oArr, best2)
                        cB = array.get(cArr, best2)
                        addOB(obArr, best2, math.min(oB, cB), math.max(oB, cB), false, k, 0)
                if lastSWHidx >= 0
                    addRBFromSwing(rbArr, oArr, hArr, lArr, cArr, lastSWHidx, true, k, 0)
                haveSWL := false
                swlCons := true
        else
            if haveSWL and array.get(lArr, k) < swlPrice
                if regime == 0
                    regime := 2
                else if regime == 1
                    regime := 2
                    addMss(mssArr, k, swlIdx, swlPrice, false)
                if pendBearAifob != -1
                    obRef3 = array.get(obArr, pendBearAifob)
                    obRef3.state := 0
                    obRef3.origState := 0
                    array.set(obArr, pendBearAifob, obRef3)
                    pendBearAifob := -1
                else if lastSWHidx >= 0
                    lo3 = math.min(math.min(lastSWHidx, k), swlIdx)
                    hi3 = math.max(math.max(lastSWHidx, k), swlIdx)
                    tryCreateIFVGs(fvgArr, hArr, lArr, lo3, hi3, false, k)
                    fvgBearScanUpto := hi3
                    best3 = -1
                    for x = lo3 to hi3
                        cX = array.get(cArr, x)
                        oX = array.get(oArr, x)
                        okB3 = false
                        if cX > oX
                            okB3 := best3 == -1 or cX > array.get(cArr, best3)
                        if okB3
                            best3 := x
                    if best3 != -1
                        oB = array.get(oArr, best3)
                        cB = array.get(cArr, best3)
                        addOB(obArr, best3, math.min(oB, cB), math.max(oB, cB), false, k, 0)
                if lastSWHidx >= 0
                    addRBFromSwing(rbArr, oArr, hArr, lArr, cArr, lastSWHidx, true, k, 0)
                haveSWL := false
                swlCons := true

            peek3 = ei
            while peek3 < evTotal
                pEv3 = array.get(evArr, peek3)
                if pEv3.confirmIdx != k
                    break
                if pEv3.kind == 0
                    haveSWH := true
                    swhPrice := pEv3.price
                    swhIdx := pEv3.swingIdx
                    pendBullAifob := -1
                    tryBearAOB(obArr, oArr, hArr, lArr, cArr, prevReg, aobSWLi, pEv3.swingIdx, pEv3.price, k)
                    tryBearAFVG(fvgArr, hArr, lArr, prevReg, aobSWLi, pEv3.swingIdx, pEv3.price, k)
                    tryBearARB(rbArr, oArr, hArr, lArr, cArr, prevReg, aobSWLi, pEv3.swingIdx, k)
                    if pendBearAifob == -1
                        r4 = tryBearAIFOB(obArr, oArr, cArr, haveSWL, aobSWLi, lastSWHidx, pEv3.swingIdx, k)
                        if r4 != -1
                            pendBearAifob := r4
                else
                    haveSWL := true
                    swlPrice := pEv3.price
                    swlIdx := pEv3.swingIdx
                    pendBearAifob := -1
                    tryBullAOB(obArr, oArr, hArr, lArr, cArr, prevReg, aobSWHi, pEv3.swingIdx, pEv3.price, k)
                    tryBullAFVG(fvgArr, hArr, lArr, prevReg, aobSWHi, pEv3.swingIdx, pEv3.price, k)
                    tryBullARB(rbArr, oArr, hArr, lArr, cArr, prevReg, aobSWHi, pEv3.swingIdx, k)
                    if pendBullAifob == -1
                        r5 = tryBullAIFOB(obArr, oArr, cArr, haveSWH, aobSWHi, lastSWLidx, pEv3.swingIdx, k)
                        if r5 != -1
                            pendBullAifob := r5
                peek3 += 1

            if haveSWH and array.get(hArr, k) > swhPrice
                if regime == 0
                    regime := 1
                else if regime == 2
                    regime := 1
                    addMss(mssArr, k, swhIdx, swhPrice, true)
                if pendBullAifob != -1
                    obRef4 = array.get(obArr, pendBullAifob)
                    obRef4.state := 0
                    obRef4.origState := 0
                    array.set(obArr, pendBullAifob, obRef4)
                    pendBullAifob := -1
                else if lastSWLidx >= 0
                    lo4 = math.min(math.min(lastSWLidx, k), swhIdx)
                    hi4 = math.max(math.max(lastSWLidx, k), swhIdx)
                    tryCreateIFVGs(fvgArr, hArr, lArr, lo4, hi4, true, k)
                    fvgBullScanUpto := hi4
                    best4 = -1
                    for x = lo4 to hi4
                        cX = array.get(cArr, x)
                        oX = array.get(oArr, x)
                        okB4 = false
                        if cX < oX
                            okB4 := best4 == -1 or cX < array.get(cArr, best4)
                        if okB4
                            best4 := x
                    if best4 != -1
                        oB = array.get(oArr, best4)
                        cB = array.get(cArr, best4)
                        addOB(obArr, best4, math.min(oB, cB), math.max(oB, cB), true, k, 0)
                if lastSWLidx >= 0
                    addRBFromSwing(rbArr, oArr, hArr, lArr, cArr, lastSWLidx, false, k, 0)
                haveSWH := false
                swhCons := true

        if regime == 1 and k >= 2 and k > fvgBullScanUpto
            h1c = array.get(hArr, k - 2)
            l3c = array.get(lArr, k)
            if h1c < l3c
                addFVG(fvgArr, k - 2, h1c, l3c, true, k, 0)
            fvgBullScanUpto := k
        if regime == 2 and k >= 2 and k > fvgBearScanUpto
            l1c = array.get(lArr, k - 2)
            h3c = array.get(hArr, k)
            if l1c > h3c
                addFVG(fvgArr, k - 2, h3c, l1c, false, k, 0)
            fvgBearScanUpto := k

        while ei < evTotal
            sEv = array.get(evArr, ei)
            if sEv.confirmIdx != k
                break
            if sEv.kind == 0
                if not swhCons
                    haveSWH := true
                    swhPrice := sEv.price
                    swhIdx := sEv.swingIdx
                lastSWHidx := sEv.swingIdx
                for z = 0 to array.size(obArr) - 1
                    if z < 0 or z >= array.size(obArr)
                        continue
                    obZ = array.get(obArr, z)
                    if obZ.bullish and obZ.state == 0 and obZ.eligibleK == -1 and k > obZ.triggerK
                        obZ.eligibleK := k
                        array.set(obArr, z, obZ)
                for zf = 0 to array.size(fvgArr) - 1
                    if zf < 0 or zf >= array.size(fvgArr)
                        continue
                    fvgZ = array.get(fvgArr, zf)
                    if fvgZ.bullish and fvgZ.state == 0 and fvgZ.eligibleK == -1 and k > fvgZ.triggerK
                        fvgZ.eligibleK := k
                        array.set(fvgArr, zf, fvgZ)
                for zr = 0 to array.size(rbArr) - 1
                    if zr < 0 or zr >= array.size(rbArr)
                        continue
                    rbZ = array.get(rbArr, zr)
                    if rbZ.bullish and rbZ.state == 0 and rbZ.eligibleK == -1 and k > rbZ.triggerK
                        rbZ.eligibleK := k
                        array.set(rbArr, zr, rbZ)
            else
                if not swlCons
                    haveSWL := true
                    swlPrice := sEv.price
                    swlIdx := sEv.swingIdx
                lastSWLidx := sEv.swingIdx
                for z = 0 to array.size(obArr) - 1
                    if z < 0 or z >= array.size(obArr)
                        continue
                    obZ2 = array.get(obArr, z)
                    if not obZ2.bullish and obZ2.state == 0 and obZ2.eligibleK == -1 and k > obZ2.triggerK
                        obZ2.eligibleK := k
                        array.set(obArr, z, obZ2)
                for zf2 = 0 to array.size(fvgArr) - 1
                    if zf2 < 0 or zf2 >= array.size(fvgArr)
                        continue
                    fvgZ2 = array.get(fvgArr, zf2)
                    if not fvgZ2.bullish and fvgZ2.state == 0 and fvgZ2.eligibleK == -1 and k > fvgZ2.triggerK
                        fvgZ2.eligibleK := k
                        array.set(fvgArr, zf2, fvgZ2)
                for zr2 = 0 to array.size(rbArr) - 1
                    if zr2 < 0 or zr2 >= array.size(rbArr)
                        continue
                    rbZ2 = array.get(rbArr, zr2)
                    if not rbZ2.bullish and rbZ2.state == 0 and rbZ2.eligibleK == -1 and k > rbZ2.triggerK
                        rbZ2.eligibleK := k
                        array.set(rbArr, zr2, rbZ2)
            ei += 1

        obTotal = array.size(obArr)
        hK = array.get(hArr, k)
        lK = array.get(lArr, k)
        for z = 0 to obTotal - 1
            if z < 0 or z >= obTotal
                continue
            obZ3 = array.get(obArr, z)
            if obZ3.state != 3
                zb = obZ3.zb
                zt = obZ3.zt
                bull = obZ3.bullish
                impacted = false
                if obZ3.eligibleK != -1 and k >= obZ3.eligibleK
                    if hK >= zb and lK <= zt
                        obZ3.preSpentState := obZ3.state
                        obZ3.state := 3
                        obZ3.stopK := k
                        array.set(obArr, z, obZ3)
                        impacted := true
                if not impacted and (obZ3.state == 0 or obZ3.state == 1 or obZ3.state == 4) and obZ3.eligibleK != -1
                    isIFOB = obZ3.origState != 1
                    for e2 = evBeforeSwing to evTotal - 1
                        if e2 < 0 or e2 >= evTotal
                            continue
                        stEv = array.get(evArr, e2)
                        if stEv.confirmIdx == k
                            stranded = false
                            if isIFOB
                                if bull and stEv.kind == 1 and stEv.price > zt
                                    stranded := true
                                if not bull and stEv.kind == 0 and stEv.price < zb
                                    stranded := true
                            else
                                if bull and stEv.kind == 0 and stEv.price < zb
                                    stranded := true
                                if not bull and stEv.kind == 1 and stEv.price > zt
                                    stranded := true
                            if stranded
                                obZ3.state := 2
                                array.set(obArr, z, obZ3)

        fvgTotal = array.size(fvgArr)
        for zf3 = 0 to fvgTotal - 1
            if zf3 < 0 or zf3 >= fvgTotal
                continue
            fvgZ3 = array.get(fvgArr, zf3)
            if fvgZ3.state != 3
                zbf = fvgZ3.zb
                ztf = fvgZ3.zt
                bullf = fvgZ3.bullish
                impactedF = false
                if fvgZ3.eligibleK != -1 and k >= fvgZ3.eligibleK
                    if hK >= zbf and lK <= ztf
                        fvgZ3.preSpentState := fvgZ3.state
                        fvgZ3.state := 3
                        fvgZ3.stopK := k
                        array.set(fvgArr, zf3, fvgZ3)
                        impactedF := true
                if not impactedF and (fvgZ3.state == 0 or fvgZ3.state == 1) and fvgZ3.eligibleK != -1 and k >= fvgZ3.eligibleK
                    cK = array.get(cArr, k)
                    closedThrough = bullf ? cK < zbf : cK > ztf
                    if closedThrough
                        fvgZ3.preSpentState := fvgZ3.state
                        fvgZ3.state := 3
                        fvgZ3.stopK := k
                        array.set(fvgArr, zf3, fvgZ3)
                        impactedF := true
                if not impactedF and (fvgZ3.state == 0 or fvgZ3.state == 1) and fvgZ3.eligibleK != -1
                    isIFVG = fvgZ3.origin != 1
                    for e2 = evBeforeSwing to evTotal - 1
                        if e2 < 0 or e2 >= evTotal
                            continue
                        stEv = array.get(evArr, e2)
                        if stEv.confirmIdx == k
                            strandedF = false
                            if isIFVG
                                if bullf and stEv.kind == 1 and stEv.price > ztf
                                    strandedF := true
                                if not bullf and stEv.kind == 0 and stEv.price < zbf
                                    strandedF := true
                            else
                                if bullf and stEv.kind == 0 and stEv.price < zbf
                                    strandedF := true
                                if not bullf and stEv.kind == 1 and stEv.price > ztf
                                    strandedF := true
                            if strandedF
                                fvgZ3.state := 2
                                array.set(fvgArr, zf3, fvgZ3)

        rbTotal = array.size(rbArr)
        for zr3 = 0 to rbTotal - 1
            if zr3 < 0 or zr3 >= rbTotal
                continue
            rbZ3 = array.get(rbArr, zr3)
            if rbZ3.state != 3
                zbr = rbZ3.zb
                ztr = rbZ3.zt
                bullr = rbZ3.bullish
                impactedR = false
                if rbZ3.eligibleK != -1 and k >= rbZ3.eligibleK
                    if hK >= zbr and lK <= ztr
                        rbZ3.preSpentState := rbZ3.state
                        rbZ3.state := 3
                        rbZ3.stopK := k
                        array.set(rbArr, zr3, rbZ3)
                        impactedR := true
                if not impactedR and (rbZ3.state == 0 or rbZ3.state == 1) and rbZ3.eligibleK != -1
                    isIRB = rbZ3.origin != 1
                    for e2 = evBeforeSwing to evTotal - 1
                        if e2 < 0 or e2 >= evTotal
                            continue
                        stEv = array.get(evArr, e2)
                        if stEv.confirmIdx == k
                            strandedR = false
                            if isIRB
                                if bullr and stEv.kind == 1 and stEv.price > ztr
                                    strandedR := true
                                if not bullr and stEv.kind == 0 and stEv.price < zbr
                                    strandedR := true
                            else
                                if bullr and stEv.kind == 0 and stEv.price < zbr
                                    strandedR := true
                                if not bullr and stEv.kind == 1 and stEv.price > ztr
                                    strandedR := true
                            if strandedR
                                rbZ3.state := 2
                                array.set(rbArr, zr3, rbZ3)
    [peakIdx, troughIdx, haveSWH, swhPrice, swhIdx, haveSWL, swlPrice, swlIdx, regime, ei, lastSWHidx, lastSWLidx, pendBullAifob, pendBearAifob, fvgBullScanUpto, fvgBearScanUpto]


// ===================== WEEKLY (bias) ENGINE =====================
// Shared runEngine() above; identical logic for every tier.
if wNewBar
    [wPeakIdx, wTroughIdx, wHaveSWH, wSwhPrice, wSwhIdx, wHaveSWL, wSwlPrice, wSwlIdx, wRegime, wEi, wLastSWHidx, wLastSWLidx, wPendBullAifob, wPendBearAifob, wFvgBullScanUpto, wFvgBearScanUpto] = runEngine(wO, wH, wL, wC, wEvents, wMsses, wObs, wFvgs, wRbs, wSwHighs, wSwLows, wPeakIdx, wTroughIdx, wHaveSWH, wSwhPrice, wSwhIdx, wHaveSWL, wSwlPrice, wSwlIdx, wRegime, wEi, wLastSWHidx, wLastSWLidx, wPendBullAifob, wPendBearAifob, wFvgBullScanUpto, wFvgBearScanUpto)

// ===================== 4H (confirm) ENGINE =====================
// Shared runEngine() above; identical logic for every tier.
if h4NewBar
    [h4PeakIdx, h4TroughIdx, h4HaveSWH, h4SwhPrice, h4SwhIdx, h4HaveSWL, h4SwlPrice, h4SwlIdx, h4Regime, h4Ei, h4LastSWHidx, h4LastSWLidx, h4PendBullAifob, h4PendBearAifob, h4FvgBullScanUpto, h4FvgBearScanUpto] = runEngine(h4O, h4H, h4L, h4C, h4Events, h4Msses, h4Obs, h4Fvgs, h4Rbs, h4SwHighs, h4SwLows, h4PeakIdx, h4TroughIdx, h4HaveSWH, h4SwhPrice, h4SwhIdx, h4HaveSWL, h4SwlPrice, h4SwlIdx, h4Regime, h4Ei, h4LastSWHidx, h4LastSWLidx, h4PendBullAifob, h4PendBearAifob, h4FvgBullScanUpto, h4FvgBearScanUpto)

// ===================== 5M (entry) ENGINE =====================
// Shared runEngine() above; identical logic for every tier.
if m5NewBar
    [m5PeakIdx, m5TroughIdx, m5HaveSWH, m5SwhPrice, m5SwhIdx, m5HaveSWL, m5SwlPrice, m5SwlIdx, m5Regime, m5Ei, m5LastSWHidx, m5LastSWLidx, m5PendBullAifob, m5PendBearAifob, m5FvgBullScanUpto, m5FvgBearScanUpto] = runEngine(m5O, m5H, m5L, m5C, m5Events, m5Msses, m5Obs, m5Fvgs, m5Rbs, m5SwHighs, m5SwLows, m5PeakIdx, m5TroughIdx, m5HaveSWH, m5SwhPrice, m5SwhIdx, m5HaveSWL, m5SwlPrice, m5SwlIdx, m5Regime, m5Ei, m5LastSWHidx, m5LastSWLidx, m5PendBullAifob, m5PendBearAifob, m5FvgBullScanUpto, m5FvgBearScanUpto)

// ===================== S1 CASCADE STATE =====================
// kind: -1 none, 0 OB, 1 FVG, 2 RB
var int   biasKind    = -1
var int   biasIdx     = -1
var int   biasEntryK  = -1
var int   huntStartTime = -1   // ms -- 4H POIs must be formed at/after this

var int   confirmKind   = -1
var int   confirmIdx    = -1
var int   confirmEntryK = -1
var bool  confirmBull   = false
var float confirmZb = na
var float confirmZt = na

var int   entryStage       = 0    // 0 idle, 1 active
var int   entryWatchStart  = -1   // ms -- 4H touch time
var int   entryEnteredIdx  = -1   // m5 candle idx when price entered the confirm zone
var float entrySwingPrice  = na

var line  entryLine = na
var line  slLine    = na
var line  tpLine     = na

var fillTimes  = array.new<int>()
var fillPrices = array.new<float>()
var fillSLs    = array.new<float>()
var fillTPs    = array.new<float>()
var fillBulls  = array.new<bool>()

// ===================== CASCADE HELPERS (one per POI type; reused for bias & confirm) =====================
// "Halal" check: kill condition 1 = a candle BODY closes inside the zone;
// kill condition 2 = the matching-direction swing confirms after entry.
// Wick-only touches never kill it. Same rule for every tier and POI type.
poiHalalOB(array<ObZone> arr, array<float> oArr, array<float> cArr, array<SwEv> evArr, int idx, int entryK, int lc) =>
    z = array.get(arr, idx)
    bodyLo = math.min(array.get(oArr, lc), array.get(cArr, lc))
    bodyHi = math.max(array.get(oArr, lc), array.get(cArr, lc))
    halal = not (bodyHi >= z.zb and bodyLo <= z.zt)
    if halal
        wantHigh = not z.bullish
        for e = 0 to array.size(evArr) - 1
            if e < 0 or e >= array.size(evArr)
                continue
            ev = array.get(evArr, e)
            if ev.confirmIdx > entryK and ((wantHigh and ev.kind == 0) or (not wantHigh and ev.kind == 1))
                halal := false
    halal

poiHalalFVG(array<FvgZone> arr, array<float> oArr, array<float> cArr, array<SwEv> evArr, int idx, int entryK, int lc) =>
    z = array.get(arr, idx)
    bodyLo = math.min(array.get(oArr, lc), array.get(cArr, lc))
    bodyHi = math.max(array.get(oArr, lc), array.get(cArr, lc))
    halal = not (bodyHi >= z.zb and bodyLo <= z.zt)
    if halal
        wantHigh = not z.bullish
        for e = 0 to array.size(evArr) - 1
            if e < 0 or e >= array.size(evArr)
                continue
            ev = array.get(evArr, e)
            if ev.confirmIdx > entryK and ((wantHigh and ev.kind == 0) or (not wantHigh and ev.kind == 1))
                halal := false
    halal

poiHalalRB(array<RbZone> arr, array<float> oArr, array<float> cArr, array<SwEv> evArr, int idx, int entryK, int lc) =>
    z = array.get(arr, idx)
    bodyLo = math.min(array.get(oArr, lc), array.get(cArr, lc))
    bodyHi = math.max(array.get(oArr, lc), array.get(cArr, lc))
    halal = not (bodyHi >= z.zb and bodyLo <= z.zt)
    if halal
        wantHigh = not z.bullish
        for e = 0 to array.size(evArr) - 1
            if e < 0 or e >= array.size(evArr)
                continue
            ev = array.get(evArr, e)
            if ev.confirmIdx > entryK and ((wantHigh and ev.kind == 0) or (not wantHigh and ev.kind == 1))
                halal := false
    halal

// First eligible wick-touch on the tier's just-closed candle lc, among POIs
// formed at/after notBeforeTime (ms) and, if requireDir, matching wantBull.
// Prefers the most recently created candidate. -1 if none.
findTouchOB(array<ObZone> arr, array<float> hArr, array<float> lArr, array<int> btArr, int lc, int notBeforeTime, bool wantBull, bool requireDir) =>
    result = -1
    for z = array.size(arr) - 1 to 0
        if z < 0 or z >= array.size(arr)
            continue
        if result == -1
            ob = array.get(arr, z)
            okDir = requireDir ? ob.bullish == wantBull : true
            if okDir and array.get(btArr, ob.candle) >= notBeforeTime and ob.eligibleK != -1 and lc >= ob.eligibleK
                if array.get(hArr, lc) >= ob.zb and array.get(lArr, lc) <= ob.zt
                    result := z
    result

findTouchFVG(array<FvgZone> arr, array<float> hArr, array<float> lArr, array<int> btArr, int lc, int notBeforeTime, bool wantBull, bool requireDir) =>
    result = -1
    for z = array.size(arr) - 1 to 0
        if z < 0 or z >= array.size(arr)
            continue
        if result == -1
            fv = array.get(arr, z)
            okDir = requireDir ? fv.bullish == wantBull : true
            if okDir and array.get(btArr, fv.leftIdx) >= notBeforeTime and fv.eligibleK != -1 and lc >= fv.eligibleK
                if array.get(hArr, lc) >= fv.zb and array.get(lArr, lc) <= fv.zt
                    result := z
    result

findTouchRB(array<RbZone> arr, array<float> hArr, array<float> lArr, array<int> btArr, int lc, int notBeforeTime, bool wantBull, bool requireDir) =>
    result = -1
    for z = array.size(arr) - 1 to 0
        if z < 0 or z >= array.size(arr)
            continue
        if result == -1
            rb = array.get(arr, z)
            okDir = requireDir ? rb.bullish == wantBull : true
            if okDir and array.get(btArr, rb.leftIdx) >= notBeforeTime and rb.eligibleK != -1 and lc >= rb.eligibleK
                if array.get(hArr, lc) >= rb.zb and array.get(lArr, lc) <= rb.zt
                    result := z
    result

// ===================== S1 CASCADE: TIER 1 — bias (Weekly) =====================
if wNewBar
    lcW = array.size(wO) - 1
    if biasIdx != -1
        halalB = biasKind == 0 ? poiHalalOB(wObs, wO, wC, wEvents, biasIdx, biasEntryK, lcW) : biasKind == 1 ? poiHalalFVG(wFvgs, wO, wC, wEvents, biasIdx, biasEntryK, lcW) : poiHalalRB(wRbs, wO, wC, wEvents, biasIdx, biasEntryK, lcW)
        if not halalB
            biasKind := -1
            biasIdx := -1
            confirmKind := -1
            confirmIdx := -1
            entryStage := 0
            entryEnteredIdx := -1
            entrySwingPrice := na
            if not na(entryLine)
                line.delete(entryLine)
                entryLine := na
            if not na(slLine)
                line.delete(slLine)
                slLine := na
            if not na(tpLine)
                line.delete(tpLine)
                tpLine := na

    if biasIdx == -1
        tOBw = findTouchOB(wObs, wH, wL, wBT, lcW, 0, false, false)
        tFVGw = findTouchFVG(wFvgs, wH, wL, wBT, lcW, 0, false, false)
        tRBw = findTouchRB(wRbs, wH, wL, wBT, lcW, 0, false, false)
        bestKindW = -1
        bestIdxW = -1
        bestTimeW = -1
        if tOBw != -1
            ttw = array.get(wBT, array.get(wObs, tOBw).candle)
            if ttw > bestTimeW
                bestTimeW := ttw
                bestKindW := 0
                bestIdxW := tOBw
        if tFVGw != -1
            ttw2 = array.get(wBT, array.get(wFvgs, tFVGw).leftIdx)
            if ttw2 > bestTimeW
                bestTimeW := ttw2
                bestKindW := 1
                bestIdxW := tFVGw
        if tRBw != -1
            ttw3 = array.get(wBT, array.get(wRbs, tRBw).leftIdx)
            if ttw3 > bestTimeW
                bestTimeW := ttw3
                bestKindW := 2
                bestIdxW := tRBw
        if bestKindW != -1
            biasKind := bestKindW
            biasIdx := bestIdxW
            biasEntryK := lcW
            huntStartTime := array.get(wBT, lcW)
            confirmKind := -1
            confirmIdx := -1
            entryStage := 0
            entryEnteredIdx := -1
            entrySwingPrice := na
            if not na(entryLine)
                line.delete(entryLine)
                entryLine := na
            if not na(slLine)
                line.delete(slLine)
                slLine := na
            if not na(tpLine)
                line.delete(tpLine)
                tpLine := na

// ===================== S1 CASCADE: TIER 2 — confirm (4H) =====================
if h4NewBar
    if biasIdx == -1
        if confirmIdx != -1
            confirmKind := -1
            confirmIdx := -1
            entryStage := 0
            entryEnteredIdx := -1
            entrySwingPrice := na
            if not na(entryLine)
                line.delete(entryLine)
                entryLine := na
            if not na(slLine)
                line.delete(slLine)
                slLine := na
            if not na(tpLine)
                line.delete(tpLine)
                tpLine := na
    else
        lc4 = array.size(h4O) - 1
        if confirmIdx != -1
            halalC = confirmKind == 0 ? poiHalalOB(h4Obs, h4O, h4C, h4Events, confirmIdx, confirmEntryK, lc4) : confirmKind == 1 ? poiHalalFVG(h4Fvgs, h4O, h4C, h4Events, confirmIdx, confirmEntryK, lc4) : poiHalalRB(h4Rbs, h4O, h4C, h4Events, confirmIdx, confirmEntryK, lc4)
            if not halalC
                confirmKind := -1
                confirmIdx := -1
                entryStage := 0
                entryEnteredIdx := -1
                entrySwingPrice := na
                if not na(entryLine)
                    line.delete(entryLine)
                    entryLine := na
                if not na(slLine)
                    line.delete(slLine)
                    slLine := na
                if not na(tpLine)
                    line.delete(tpLine)
                    tpLine := na

        wantBullH4 = biasKind == 0 ? array.get(wObs, biasIdx).bullish : biasKind == 1 ? array.get(wFvgs, biasIdx).bullish : array.get(wRbs, biasIdx).bullish

        if confirmIdx == -1
            tOB4 = findTouchOB(h4Obs, h4H, h4L, h4BT, lc4, huntStartTime, wantBullH4, true)
            tFVG4 = findTouchFVG(h4Fvgs, h4H, h4L, h4BT, lc4, huntStartTime, wantBullH4, true)
            tRB4 = findTouchRB(h4Rbs, h4H, h4L, h4BT, lc4, huntStartTime, wantBullH4, true)
            bestKind4 = -1
            bestIdx4 = -1
            bestTime4 = -1
            if tOB4 != -1
                tt4 = array.get(h4BT, array.get(h4Obs, tOB4).candle)
                if tt4 > bestTime4
                    bestTime4 := tt4
                    bestKind4 := 0
                    bestIdx4 := tOB4
            if tFVG4 != -1
                tt42 = array.get(h4BT, array.get(h4Fvgs, tFVG4).leftIdx)
                if tt42 > bestTime4
                    bestTime4 := tt42
                    bestKind4 := 1
                    bestIdx4 := tFVG4
            if tRB4 != -1
                tt43 = array.get(h4BT, array.get(h4Rbs, tRB4).leftIdx)
                if tt43 > bestTime4
                    bestTime4 := tt43
                    bestKind4 := 2
                    bestIdx4 := tRB4

            if bestKind4 != -1
                zb4 = bestKind4 == 0 ? array.get(h4Obs, bestIdx4).zb : bestKind4 == 1 ? array.get(h4Fvgs, bestIdx4).zb : array.get(h4Rbs, bestIdx4).zb
                zt4 = bestKind4 == 0 ? array.get(h4Obs, bestIdx4).zt : bestKind4 == 1 ? array.get(h4Fvgs, bestIdx4).zt : array.get(h4Rbs, bestIdx4).zt
                overlapsLive = entryStage == 1 and zb4 <= confirmZt and zt4 >= confirmZb
                confirmKind := bestKind4
                confirmIdx := bestIdx4
                confirmEntryK := lc4
                confirmBull := wantBullH4
                if overlapsLive
                    confirmZb := math.min(confirmZb, zb4)
                    confirmZt := math.max(confirmZt, zt4)
                else
                    confirmZb := zb4
                    confirmZt := zt4
                    entryStage := 1
                    entryWatchStart := array.get(h4BT, lc4)
                    entryEnteredIdx := -1
                    entrySwingPrice := na
                    if not na(entryLine)
                        line.delete(entryLine)
                        entryLine := na
                    if not na(slLine)
                        line.delete(slLine)
                        slLine := na
                    if not na(tpLine)
                        line.delete(tpLine)
                        tpLine := na

// ===================== S1 CASCADE: TIER 3 — entry (5M) =====================
if m5NewBar
    if entryStage == 1
        lc5 = array.size(m5O) - 1
        now5 = array.get(m5BT, lc5)
        hh5 = hour(now5)
        inLondon5 = hh5 >= InpLondonStartHour and hh5 < InpLondonStartHour + InpSessionWindowHrs
        inNY5 = hh5 >= InpNewYorkStartHour and hh5 < InpNewYorkStartHour + InpSessionWindowHrs
        sessionOk5 = inLondon5 or inNY5

        if not sessionOk5
            if not na(entryLine)
                line.delete(entryLine)
                entryLine := na
            if not na(slLine)
                line.delete(slLine)
                slLine := na
            if not na(tpLine)
                line.delete(tpLine)
                tpLine := na
            entryEnteredIdx := -1
            entrySwingPrice := na
        else
            if entryEnteredIdx == -1 and now5 >= entryWatchStart
                inside5 = array.get(m5H, lc5) >= confirmZb and array.get(m5L, lc5) <= confirmZt
                if inside5
                    entryEnteredIdx := lc5

            if entryEnteredIdx != -1
                wantKind5 = confirmBull ? 0 : 1
                bestE5 = -1
                bestEConfirm5 = -1
                for e5 = 0 to array.size(m5Events) - 1
                    if e5 < 0 or e5 >= array.size(m5Events)
                        continue
                    ev5 = array.get(m5Events, e5)
                    if ev5.confirmIdx >= entryEnteredIdx and ev5.kind == wantKind5
                        if bestE5 == -1 or ev5.confirmIdx > bestEConfirm5
                            bestE5 := e5
                            bestEConfirm5 := ev5.confirmIdx

                if bestE5 != -1
                    ev5b = array.get(m5Events, bestE5)
                    price5 = ev5b.price
                    swingCandleIdx5 = ev5b.swingIdx
                    sl5 = confirmBull ? array.get(m5L, swingCandleIdx5) - InpPipSize : array.get(m5H, swingCandleIdx5) + InpPipSize
                    riskDist5 = confirmBull ? price5 - sl5 : sl5 - price5

                    if riskDist5 > 0
                        tp5 = confirmBull ? price5 + riskDist5 * InpRR_Target : price5 - riskDist5 * InpRR_Target
                        changed5 = na(entrySwingPrice) or math.abs(price5 - entrySwingPrice) >= syminfo.mintick
                        if changed5
                            entrySwingPrice := price5
                            x1_5 = array.get(m5BT, lc5)
                            x2_5 = x1_5 + 40 * timeframe.in_seconds() * 1000
                            if not na(entryLine)
                                line.delete(entryLine)
                                entryLine := na
                            if not na(slLine)
                                line.delete(slLine)
                                slLine := na
                            if not na(tpLine)
                                line.delete(tpLine)
                                tpLine := na
                            entryLine := line.new(x1_5, price5, x2_5, price5, xloc = xloc.bar_time, color = color.orange, width = 2, extend = extend.right)
                            slLine := line.new(x1_5, sl5, x2_5, sl5, xloc = xloc.bar_time, color = color.red, style = line.style_dashed, extend = extend.right)
                            tpLine := line.new(x1_5, tp5, x2_5, tp5, xloc = xloc.bar_time, color = color.green, style = line.style_dashed, extend = extend.right)

                        filled5 = confirmBull ? array.get(m5H, lc5) >= price5 : array.get(m5L, lc5) <= price5
                        if filled5
                            array.push(fillTimes, array.get(m5BT, lc5))
                            array.push(fillPrices, price5)
                            array.push(fillSLs, sl5)
                            array.push(fillTPs, tp5)
                            array.push(fillBulls, confirmBull)
                            entryEnteredIdx := -1
                            entrySwingPrice := na
                            if not na(entryLine)
                                line.delete(entryLine)
                                entryLine := na
                            if not na(slLine)
                                line.delete(slLine)
                                slLine := na
                            if not na(tpLine)
                                line.delete(tpLine)
                                tpLine := na

// ===================== DRAWING: one tier's swings/MSS/OB/FVG/RB =====================
// Same palette/behavior as ICT_Full_OB_v24.pine, parameterized so it's
// written once and reused for all three tiers (prefix distinguishes them
// in label text, e.g. "W", "4H", "5M").
drawTier(array<int> swHArr, array<int> swLArr, array<MssEv> mssArr, array<ObZone> obArr, array<FvgZone> fvgArr, array<RbZone> rbArr, array<float> hArr, array<float> lArr, array<float> cArr, array<int> btArr, int nArr, string prefix, float swLowGap, int extMs, bool hideOOB, color swhCol, color swlCol) =>

    dispFrom = InpDisplayFrom

    shSz = array.size(swHArr)
    shStart = math.max(0, shSz - InpMaxLabelsPerCategory)
    for s = shStart to shSz - 1
        if s < 0 or s >= shSz
            continue
        idx = array.get(swHArr, s)
        if idx >= 0 and idx < nArr
            bt = array.get(btArr, idx)
            if bt >= dispFrom
                yP = array.get(hArr, idx)
                lbl = label.new(bt, yP, "▲", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = swhCol, size = size.tiny)
                array.push(drawnLabels, lbl)

    slSz = array.size(swLArr)
    slStart = math.max(0, slSz - InpMaxLabelsPerCategory)
    for s = slStart to slSz - 1
        if s < 0 or s >= slSz
            continue
        idx = array.get(swLArr, s)
        if idx >= 0 and idx < nArr
            bt = array.get(btArr, idx)
            if bt >= dispFrom
                yP = array.get(lArr, idx) - swLowGap
                lbl = label.new(bt, yP, "▼", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = swlCol, size = size.tiny)
                array.push(drawnLabels, lbl)

    mssSz = array.size(mssArr)
    mssStart = math.max(0, mssSz - InpMaxLabelsPerCategory)
    for m = mssStart to mssSz - 1
        if m < 0 or m >= mssSz
            continue
        mEv = array.get(mssArr, m)
        bIdx = mEv.brokenIdx
        if bIdx >= 0 and bIdx < nArr
            bt = array.get(btArr, bIdx)
            if bt >= dispFrom
                isUp = mEv.toUp
                yP = isUp ? array.get(hArr, bIdx) : array.get(lArr, bIdx) - swLowGap
                col = isUp ? swhCol : swlCol
                lbl = label.new(bt, yP, prefix + " MSS", xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = col, size = size.tiny)
                array.push(drawnLabels, lbl)

    extT = timenow + extMs

    // --- OB zones ---
    obSzD = array.size(obArr)
    for z = 0 to obSzD - 1
        if z < 0 or z >= obSzD
            continue
        obD = array.get(obArr, z)
        idx = obD.candle
        if idx >= 0 and idx < nArr
            bt = array.get(btArr, idx)
            if bt >= dispFrom
                dSt = obD.state == 3 ? obD.preSpentState : obD.state
                if dSt != 4 and not (dSt == 2 and hideOOB)
                    baseLabel = dSt == 1 ? "AOB" : dSt == 4 ? "AIFOB" : "IFOB"
                    lab = dSt == 2 ? "OOB" : obD.state == 3 ? baseLabel + " (spent)" : baseLabel
                    col = dSt == 0 ? (obD.bullish ? color.blue : color.black) : dSt == 1 ? color.green : dSt == 2 ? color.red : dSt == 4 ? color.orange : (obD.bullish ? color.blue : color.black)
                    stillLive = obD.state == 0 or obD.state == 1 or obD.state == 4
                    leftT = bt
                    rightT = stillLive ? extT : (obD.stopK != -1 and obD.stopK < nArr ? array.get(btArr, obD.stopK) : leftT)
                    bx = box.new(leftT, obD.zt, rightT, obD.zb, border_color = col, border_width = 1, bgcolor = na, xloc = xloc.bar_time)
                    array.push(drawnBoxes, bx)
                    lblo = label.new(leftT, obD.bullish ? obD.zb : obD.zt, prefix + " " + lab, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = col, size = size.tiny)
                    array.push(drawnLabels, lblo)

    // --- FVG zones (dotted border + gray midline) ---
    fvgSzD = array.size(fvgArr)
    ifvgLeft = array.new<int>()
    afvgLeft = array.new<int>()
    for zf = 0 to fvgSzD - 1
        if zf < 0 or zf >= fvgSzD
            continue
        fvScan = array.get(fvgArr, zf)
        if fvScan.origin == 1
            array.push(afvgLeft, fvScan.leftIdx)
        else
            array.push(ifvgLeft, fvScan.leftIdx)
    array.sort(ifvgLeft, order.descending)
    array.sort(afvgLeft, order.descending)
    ifvgCutoff = array.size(ifvgLeft) > 0 ? array.get(ifvgLeft, math.min(InpMaxPoiPerCategory, array.size(ifvgLeft)) - 1) : 999999999
    afvgCutoff = array.size(afvgLeft) > 0 ? array.get(afvgLeft, math.min(InpMaxPoiPerCategory, array.size(afvgLeft)) - 1) : 999999999
    for zf = 0 to fvgSzD - 1
        if zf < 0 or zf >= fvgSzD
            continue
        fvD = array.get(fvgArr, zf)
        idxF = fvD.leftIdx
        catCutoff = fvD.origin == 1 ? afvgCutoff : ifvgCutoff
        if idxF >= catCutoff and idxF >= 0 and idxF < nArr
            btF = array.get(btArr, idxF)
            if btF >= dispFrom
                dStF = fvD.state == 3 ? fvD.preSpentState : fvD.state
                if not (dStF == 2 and hideOOB)
                    labF = dStF == 2 ? "OFVG" : fvD.state == 3 ? (fvD.origin == 1 ? "AFVG (spent)" : "IFVG (spent)") : fvD.origin == 1 ? "AFVG" : "IFVG"
                    colF = dStF == 2 ? color.red : dStF == 1 ? color.green : (fvD.bullish ? color.blue : color.black)
                    stillLiveF = fvD.state == 0 or fvD.state == 1
                    leftTF = btF
                    rightTF = stillLiveF ? extT : (fvD.stopK != -1 and fvD.stopK < nArr ? array.get(btArr, fvD.stopK) : leftTF)
                    bxF = box.new(leftTF, fvD.zt, rightTF, fvD.zb, border_color = colF, border_width = 1, bgcolor = color.new(colF, 90), xloc = xloc.bar_time)
                    array.push(drawnBoxes, bxF)
                    midY = (fvD.zt + fvD.zb) / 2
                    lnF = line.new(leftTF, midY, rightTF, midY, xloc = xloc.bar_time, color = color.gray, style = line.style_dotted, width = 1)
                    array.push(drawnLines, lnF)
                    lblf = label.new(leftTF, fvD.bullish ? fvD.zb : fvD.zt, prefix + " " + labF, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = colF, size = size.tiny)
                    array.push(drawnLabels, lblf)

    // --- RB zones (dashed border, no fill) ---
    rbSzD = array.size(rbArr)
    irbLeft = array.new<int>()
    arbLeft = array.new<int>()
    for zr = 0 to rbSzD - 1
        if zr < 0 or zr >= rbSzD
            continue
        rbScan = array.get(rbArr, zr)
        if rbScan.origin == 1
            array.push(arbLeft, rbScan.leftIdx)
        else
            array.push(irbLeft, rbScan.leftIdx)
    array.sort(irbLeft, order.descending)
    array.sort(arbLeft, order.descending)
    irbCutoff = array.size(irbLeft) > 0 ? array.get(irbLeft, math.min(InpMaxPoiPerCategory, array.size(irbLeft)) - 1) : 999999999
    arbCutoff = array.size(arbLeft) > 0 ? array.get(arbLeft, math.min(InpMaxPoiPerCategory, array.size(arbLeft)) - 1) : 999999999
    for zr = 0 to rbSzD - 1
        if zr < 0 or zr >= rbSzD
            continue
        rbD = array.get(rbArr, zr)
        idxR = rbD.leftIdx
        catCutoffR = rbD.origin == 1 ? arbCutoff : irbCutoff
        if idxR >= catCutoffR and idxR >= 0 and idxR < nArr
            btR = array.get(btArr, idxR)
            if btR >= dispFrom
                dStR = rbD.state == 3 ? rbD.preSpentState : rbD.state
                if not (dStR == 2 and hideOOB)
                    labR = dStR == 2 ? "ORB" : rbD.state == 3 ? (rbD.origin == 1 ? "ARB (spent)" : "IRB (spent)") : rbD.origin == 1 ? "ARB" : "IRB"
                    colR = dStR == 2 ? color.red : dStR == 1 ? color.green : (rbD.bullish ? color.blue : color.black)
                    stillLiveR = rbD.state == 0 or rbD.state == 1
                    leftTR = btR
                    rightTR = stillLiveR ? extT : (rbD.stopK != -1 and rbD.stopK < nArr ? array.get(btArr, rbD.stopK) : leftTR)
                    bxR = box.new(leftTR, rbD.zt, rightTR, rbD.zb, border_color = colR, border_width = 1, border_style = line.style_dashed, bgcolor = na, xloc = xloc.bar_time)
                    array.push(drawnBoxes, bxR)
                    lblr = label.new(leftTR, rbD.bullish ? rbD.zb : rbD.zt, prefix + " " + labR, xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = colR, size = size.tiny)
                    array.push(drawnLabels, lblr)

// ===================== FINAL REDRAW (last bar only) =====================
if barstate.islast
    for lb = 0 to array.size(drawnLabels) - 1
        if lb < 0 or lb >= array.size(drawnLabels)
            continue
        label.delete(array.get(drawnLabels, lb))
    array.clear(drawnLabels)
    for bx = 0 to array.size(drawnBoxes) - 1
        if bx < 0 or bx >= array.size(drawnBoxes)
            continue
        box.delete(array.get(drawnBoxes, bx))
    array.clear(drawnBoxes)
    for ln = 0 to array.size(drawnLines) - 1
        if ln < 0 or ln >= array.size(drawnLines)
            continue
        line.delete(array.get(drawnLines, ln))
    array.clear(drawnLines)

    wExtMs  = 20 * timeframe.in_seconds("W") * 1000
    h4ExtMs = 20 * timeframe.in_seconds("240") * 1000
    m5ExtMs = 20 * timeframe.in_seconds() * 1000

    if InpShowW
        drawTier(wSwHighs, wSwLows, wMsses, wObs, wFvgs, wRbs, wH, wL, wC, wBT, array.size(wO), "W", wSwLowGap, wExtMs, false, color.purple, color.maroon)
    if InpShowH4
        drawTier(h4SwHighs, h4SwLows, h4Msses, h4Obs, h4Fvgs, h4Rbs, h4H, h4L, h4C, h4BT, array.size(h4O), "4H", h4SwLowGap, h4ExtMs, false, color.blue, color.black)
    if InpShowM5
        drawTier(m5SwHighs, m5SwLows, m5Msses, m5Obs, m5Fvgs, m5Rbs, m5H, m5L, m5C, m5BT, array.size(m5O), "5M", m5SwLowGap, m5ExtMs, false, color.teal, color.gray)

    // --- "S1 ENTRY POI" special mark on the currently-escalated 4H zone ---
    if confirmIdx != -1 and entryWatchStart > 0
        poiCol = confirmBull ? color.lime : color.fuchsia
        entryPoiLbl = label.new(entryWatchStart, confirmBull ? confirmZb : confirmZt, "◆ S1 ENTRY POI ◆", xloc = xloc.bar_time, yloc = yloc.price, style = confirmBull ? label.style_label_up : label.style_label_down, color = color.new(poiCol, 70), textcolor = color.white, size = size.small)
        array.push(drawnLabels, entryPoiLbl)
        boxHi = box.new(entryWatchStart, confirmZt, timenow + m5ExtMs, confirmZb, border_color = poiCol, border_width = 3, bgcolor = na, xloc = xloc.bar_time)
        array.push(drawnBoxes, boxHi)

    // --- historical simulated fills: permanent Entry/SL/TP markers ---
    fillStart = math.max(0, array.size(fillTimes) - InpMaxLabelsPerCategory)
    for f = fillStart to array.size(fillTimes) - 1
        if f < 0 or f >= array.size(fillTimes)
            continue
        ft = array.get(fillTimes, f)
        fp = array.get(fillPrices, f)
        fsl = array.get(fillSLs, f)
        ftp = array.get(fillTPs, f)
        fbull = array.get(fillBulls, f)
        icon = fbull ? label.style_triangleup : label.style_triangledown
        lblE = label.new(ft, fp, "S1 " + (fbull ? "BUY" : "SELL") + " " + str.tostring(fp, format.mintick), xloc = xloc.bar_time, yloc = yloc.price, style = icon, color = fbull ? color.lime : color.red, textcolor = color.white, size = size.small)
        array.push(drawnLabels, lblE)
        lnSL = line.new(ft, fsl, ft + m5ExtMs, fsl, xloc = xloc.bar_time, color = color.red, style = line.style_dashed, width = 1)
        array.push(drawnLines, lnSL)
        lblSL = label.new(ft, fsl, "SL " + str.tostring(fsl, format.mintick), xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = color.red, size = size.tiny)
        array.push(drawnLabels, lblSL)
        lnTP = line.new(ft, ftp, ft + m5ExtMs, ftp, xloc = xloc.bar_time, color = color.green, style = line.style_dashed, width = 1)
        array.push(drawnLines, lnTP)
        lblTP = label.new(ft, ftp, "TP " + str.tostring(ftp, format.mintick), xloc = xloc.bar_time, yloc = yloc.price, style = label.style_none, textcolor = color.green, size = size.tiny)
        array.push(drawnLabels, lblTP)

    // --- live status readout ---
    biasTxt = biasIdx == -1 ? "waiting for a fresh Weekly touch" : (biasKind == 0 ? "OB" : biasKind == 1 ? "FVG" : "RB") + " #" + str.tostring(biasIdx) + " (" + ((biasKind == 0 ? array.get(wObs, biasIdx).bullish : biasKind == 1 ? array.get(wFvgs, biasIdx).bullish : array.get(wRbs, biasIdx).bullish) ? "bullish" : "bearish") + ")"
    confirmTxt = confirmIdx == -1 ? "none" : (confirmKind == 0 ? "OB" : confirmKind == 1 ? "FVG" : "RB") + " #" + str.tostring(confirmIdx) + " [" + str.tostring(confirmZb, format.mintick) + "-" + str.tostring(confirmZt, format.mintick) + "]"
    entryTxt = entryStage == 0 ? "idle" : entryEnteredIdx == -1 ? "waiting for 5m to enter zone" : "trailing stop"
    statusTxt = "S1 -- Bias: " + biasTxt + "\nConfirm: " + confirmTxt + "\nEntry: " + entryTxt
    var label statusLbl = na
    if not na(statusLbl)
        label.delete(statusLbl)
    statusLbl := label.new(bar_index, high, statusTxt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = color.new(color.gray, 20), textcolor = color.white, size = size.small)
