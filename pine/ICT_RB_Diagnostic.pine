// ICT_RB_Diagnostic — Pine Script v5
// Standalone diagnostic: Swing highs/lows, MSS flips, and RB (Rejection
// Block) zones only. No OB, no FVG -- isolates RB so it can be verified
// on Daily without the main indicator's OB-picking-loop cost pushing past
// TradingView's 20s execution limit (RE10110), same reasoning as the FVG
// diagnostic before it. Swing/MSS detection is UNCHANGED from
// ICT_Full_OB_v24.pine.
//
// RB spec (confirmed with user before writing this):
// - An RB zone is the WICK of a single swing-pivot candle, not a scanned
//   pick. For a swing high: top=the high (wick tip), bottom=whichever of
//   open/close is closer to the high. Mirrored for a swing low.
// - Two types, same triggers as OB: IRB fires at IFOB's break-confirmation
//   moment (delayed eligibility). ARB fires at AOB's MID-ARM moment (same
//   pReg + reference-validity gate, immediate eligibility, no extra guard
//   needed since nothing is picked from a range).
// - Anchor candle is always the FAR swing, never the one that directly
//   caused the trigger: ARB uses the armed/older swing (e.g. the swing
//   high, for an uptrend hunt). IRB uses the opposite reference swing
//   (e.g. the swing low, for a bullish continuation).
// - Bull/bear label is by RAW WICK TYPE, not by which hunt fired it:
//   swing-high wick -> always bearish. swing-low wick -> always bullish.
//   (So in the same leg, ARB and IRB usually end up on opposite labels
//   from each other -- expected, not a bug.)
// - Stranding: same near/far split by origin as OB/FVG. IRB strands
//   far-side (mirrors IFOB). ARB strands near-side (mirrors AOB). ORB is
//   the shared stranded state for either.
// - Lifecycle: wick IMPACT + STRANDING only. No close-through rule
//   (that's FVG-only).
// - Drawing: dashed border, hollow (no fill). IRB = blue(bull)/black(bear)
//   by its own raw-wick label. ARB = green, fixed. ORB = red, fixed,
//   hidden on 5m/1h/4h like OOB/OFVG (same "never traded there" reasoning
//   -- flag if RB shouldn't follow that convention).
//@version=5
indicator("ICT RB Diagnostic (Swings/MSS/RB only)", overlay=true, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

// ===================== INPUTS =====================
InpMonthsBack  = input.int(6, "Months to display")
InpDisplayFrom = input.time(timestamp("2025-07-25"), "Display from date")
useDisplayFrom = input.bool(true, "Use exact display-from date (else use months)")
InpReplayUpTo  = input.time(0, "Replay up to date (0=show all)")
useReplay      = input.bool(false, "Enable replay mode")
InpMaxLabelsPerCategory = input.int(150, "Max swing-high / swing-low / MSS labels shown (each, most recent kept)", minval=1, maxval=160)
InpSwingLowGapATR = input.float(0.08, "Swing-low arrow / down-MSS gap below the low (x ATR14)", minval=0.0)
InpMaxRbPerCategory = input.int(150, "Max IRB / ARB boxes shown (each category, most recent by chart date)", minval=1, maxval=160)

// ===================== TYPE DEFINITIONS =====================
type SwEv
    int   confirmIdx
    int   kind         // 0=high, 1=low
    int   swingIdx
    float price

type MssEv
    int   atIdx
    int   brokenIdx
    float price
    bool  toUp

// RB zone: the wick of a single swing-pivot candle (see header for the
// full spec). leftIdx is that pivot candle's own bar index -- box starts
// there, same convention as OB/FVG.
type RbZone
    int   leftIdx
    float zb
    float zt
    bool  bullish       // by RAW WICK TYPE: swing-low wick=true, swing-high wick=false
    int   triggerK       // the hunt's firing bar (IFOB/AOB-equivalent break/MID-ARM moment)
    int   eligibleK      // -1 = not yet eligible. Delayed for IRB (mirrors IFOB);
                          // immediate (= triggerK) for ARB (mirrors AOB)
    int   stopK          // -1 = extending
    int   state          // 0=IRB, 1=ARB, 2=ORB, 3=SPENT
    int   origin         // permanent creation-type marker, never changes after
                          // creation: 0=IRB-style (far-side stranding),
                          // 1=ARB-style (near-side stranding)
    int   preSpentState

// ===================== PERSISTENT STATE =====================
var events     = array.new<SwEv>()
var msses      = array.new<MssEv>()
var rbs        = array.new<RbZone>()
var swHighs    = array.new<int>()
var swLows     = array.new<int>()

// OHLC + time storage (absolute indexing, oldest=0)
var O_ = array.new<float>()
var H_ = array.new<float>()
var L_ = array.new<float>()
var C_ = array.new<float>()
var BI = array.new<int>()
var BT = array.new<int>()

// Swing detection trackers
var int peakIdx_   = 0
var int troughIdx_ = 0

// Regime / MSS trackers
var bool  haveSWH   = false
var float swhPrice  = 0.0
var int   swhIdx    = 0
var bool  haveSWL   = false
var float swlPrice  = 0.0
var int   swlIdx    = 0
var int   regime    = 0      // 0=warmup, 1=up, 2=down
var int   ei        = 0
var int   lastSWHidx = -1
var int   lastSWLidx = -1

// Guard: process each bar exactly once
var int lastProcessedBI = -1

// Drawing object arrays (for cleanup on redraw)
var drawnLabels = array.new<label>()
var drawnBoxes  = array.new<box>()

// Replay gate
replayActive = useReplay and InpReplayUpTo > 0
skipBar = replayActive and time > InpReplayUpTo

swLowGapOffset = ta.atr(14) * InpSwingLowGapATR

// ===================== HELPER FUNCTIONS =====================
addSH(int idx) =>
    sz = array.size(swHighs)
    doPush = sz == 0
    if not doPush
        doPush := array.get(swHighs, sz - 1) != idx
    if doPush
        array.push(swHighs, idx)

addSL(int idx) =>
    sz = array.size(swLows)
    doPush = sz == 0
    if not doPush
        doPush := array.get(swLows, sz - 1) != idx
    if doPush
        array.push(swLows, idx)

addEv(int cIdx, int kind, int sIdx, float pr) =>
    array.push(events, SwEv.new(cIdx, kind, sIdx, pr))

addMss(int aIdx, int bIdx, float pr, bool up) =>
    array.push(msses, MssEv.new(aIdx, bIdx, pr, up))

addRB(int leftIdx, float zb, float zt, bool bull, int tK, int st) =>
    // st: 0=IRB (delayed eligibility, far-side stranding later), 1=ARB
    // (immediate eligibility, near-side stranding later).
    eK = (st == 1) ? tK : -1
    array.push(rbs, RbZone.new(leftIdx, zb, zt, bull, tK, eK, -1, st, st, st))

// Builds an RB zone directly from a known swing-pivot candle's wick --
// no scanning, no picking, just that one candle. isHigh=true for a swing
// high (top=wick tip, bottom=closer body edge, bull=false); isHigh=false
// for a swing low (mirrored, bull=true).
addRBFromSwing(int idx, bool isHigh, int tK, int st) =>
    if isHigh
        addRB(idx, math.max(array.get(O_, idx), array.get(C_, idx)), array.get(H_, idx), false, tK, st)
    else
        addRB(idx, array.get(L_, idx), math.min(array.get(O_, idx), array.get(C_, idx)), true, tK, st)

// --- ARB HUNT: Bullish -- mirrors tryBullAOB's range + reference-validity
// gate one-for-one, but instead of scanning/picking a candle, the zone is
// just the armed swing high's own wick (the FAR swing relative to the new
// swing low that triggered this hunt).
tryBullARB(int pReg, int aobSWHi, int newSwlI, float newSwlP, int k) =>
    if pReg == 1 and aobSWHi >= 0
        armedSwhPrice = array.get(H_, aobSWHi)
        refViolated = false
        for v = aobSWHi + 1 to newSwlI
            if array.get(H_, v) >= armedSwhPrice
                refViolated := true
        if not refViolated
            addRBFromSwing(aobSWHi, true, k, 1)

// --- ARB HUNT: Bearish -- mirrors tryBearAOB ---
tryBearARB(int pReg, int aobSWLi, int newSwhI, float newSwhP, int k) =>
    if pReg == 2 and aobSWLi >= 0
        armedSwlPrice = array.get(L_, aobSWLi)
        refViolated = false
        for v = aobSWLi + 1 to newSwhI
            if array.get(L_, v) <= armedSwlPrice
                refViolated := true
        if not refViolated
            addRBFromSwing(aobSWLi, false, k, 1)

// ===================== MAIN PROCESSING =====================
if not skipBar and bar_index != lastProcessedBI
    lastProcessedBI := bar_index

    array.push(O_, open)
    array.push(H_, high)
    array.push(L_, low)
    array.push(C_, close)
    array.push(BI, bar_index)
    array.push(BT, int(time))

    n = array.size(O_)
    if n >= 2
        i = n - 1

        // ========== SWING DETECTION (unchanged) ==========
        isBull   = array.get(C_, i) >= array.get(O_, i)
        brkH     = array.get(H_, i) > array.get(H_, i - 1)
        brkL     = array.get(L_, i) < array.get(L_, i - 1)
        dualAct  = brkH and brkL

        // prevDual: the previous candle confirmed BOTH a swing high and a
        // swing low in one bar (a dual-action/outside-bar candle). We keep
        // the (kind, swingIdx) of BOTH of those events -- not just a plain
        // yes/no flag -- so we can tell a genuine duplicate (this candle
        // re-confirming the EXACT same point again) apart from a totally
        // different, legitimate confirmation that just happens to land the
        // bar right after a dual-action candle (e.g. that same candle's
        // high separately qualifying as its own swing high later). Ported
        // from ICT_OB_Diagnostic.pine's fix (commit 4401edd) -- same bug,
        // same swing-detection code, same fix.
        prevDual = false
        pdKind1 = -1
        pdIdx1 = -1
        pdKind2 = -1
        pdIdx2 = -1
        eCnt = array.size(events)
        if eCnt >= 2
            ev1 = array.get(events, eCnt - 1)
            ev2 = array.get(events, eCnt - 2)
            if (ev1.kind != ev2.kind) and (ev1.confirmIdx == ev2.confirmIdx) and (ev1.confirmIdx == i - 1)
                prevDual := true
                pdKind1 := ev1.kind
                pdIdx1 := ev1.swingIdx
                pdKind2 := ev2.kind
                pdIdx2 := ev2.swingIdx

        evBeforeSwing = array.size(events)

        if not isBull
            if array.get(H_, i) > array.get(H_, peakIdx_)
                peakIdx_ := i
            if brkH
                lk = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                // Would this re-confirm troughIdx_ as a swing LOW when the
                // dual-action candle already confirmed that exact (kind=1,
                // idx) pair? Only block that exact duplicate.
                blockDup = prevDual and not dualAct and ((pdKind1 == 1 and pdIdx1 == troughIdx_) or (pdKind2 == 1 and pdIdx2 == troughIdx_))
                if lk != 1 and not blockDup
                    addSL(troughIdx_)
                    addEv(i, 1, troughIdx_, array.get(L_, troughIdx_))
                    peakIdx_ := i
            if array.get(L_, i) < array.get(L_, troughIdx_)
                troughIdx_ := i
            if brkL
                lk2 = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                blockDup2 = prevDual and not dualAct and ((pdKind1 == 0 and pdIdx1 == peakIdx_) or (pdKind2 == 0 and pdIdx2 == peakIdx_))
                if lk2 != 0 and not blockDup2
                    addSH(peakIdx_)
                    addEv(i, 0, peakIdx_, array.get(H_, peakIdx_))
                    troughIdx_ := i
        else
            if array.get(L_, i) < array.get(L_, troughIdx_)
                troughIdx_ := i
            if brkL
                lk3 = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                blockDup3 = prevDual and not dualAct and ((pdKind1 == 0 and pdIdx1 == peakIdx_) or (pdKind2 == 0 and pdIdx2 == peakIdx_))
                if lk3 != 0 and not blockDup3
                    addSH(peakIdx_)
                    addEv(i, 0, peakIdx_, array.get(H_, peakIdx_))
                    troughIdx_ := i
            if array.get(H_, i) > array.get(H_, peakIdx_)
                peakIdx_ := i
            if brkH
                lk4 = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                blockDup4 = prevDual and not dualAct and ((pdKind1 == 1 and pdIdx1 == troughIdx_) or (pdKind2 == 1 and pdIdx2 == troughIdx_))
                if lk4 != 1 and not blockDup4
                    addSL(troughIdx_)
                    addEv(i, 1, troughIdx_, array.get(L_, troughIdx_))
                    peakIdx_ := i

        // ========== REGIME / MSS / RB ENGINE ==========
        k = i
        evTotal = array.size(events)

        peek0 = ei
        while peek0 < evTotal
            pEv = array.get(events, peek0)
            if pEv.confirmIdx != k
                break
            if pEv.kind == 0
                lastSWHidx := pEv.swingIdx
            else
                lastSWLidx := pEv.swingIdx
            peek0 += 1

        prevReg = regime
        swhCons = false
        swlCons = false
        aobSWHi = swhIdx
        aobSWLi = swlIdx

        kBull = array.get(C_, k) >= array.get(O_, k)

        if not kBull
            // --- BEARISH bar: high first -> SWH break first ---
            if haveSWH and array.get(H_, k) > swhPrice
                if regime == 0
                    regime := 1
                else if regime == 2
                    regime := 1
                    addMss(k, swhIdx, swhPrice, true)
                if lastSWLidx >= 0
                    // IRB: opposite reference (swing LOW) is the far swing
                    // relative to the high that just broke.
                    addRBFromSwing(lastSWLidx, false, k, 0)
                haveSWH := false
                swhCons := true

            // MID-ARM
            peek2 = ei
            while peek2 < evTotal
                pEv2 = array.get(events, peek2)
                if pEv2.confirmIdx != k
                    break
                if pEv2.kind == 0
                    haveSWH  := true
                    swhPrice := pEv2.price
                    swhIdx   := pEv2.swingIdx
                    tryBearARB(prevReg, aobSWLi, pEv2.swingIdx, pEv2.price, k)
                else
                    haveSWL  := true
                    swlPrice := pEv2.price
                    swlIdx   := pEv2.swingIdx
                    tryBullARB(prevReg, aobSWHi, pEv2.swingIdx, pEv2.price, k)
                peek2 += 1

            // Second break: SWL
            if haveSWL and array.get(L_, k) < swlPrice
                if regime == 0
                    regime := 2
                else if regime == 1
                    regime := 2
                    addMss(k, swlIdx, swlPrice, false)
                if lastSWHidx >= 0
                    addRBFromSwing(lastSWHidx, true, k, 0)
                haveSWL := false
                swlCons := true

        else
            // --- BULLISH bar: low first -> SWL break first ---
            if haveSWL and array.get(L_, k) < swlPrice
                if regime == 0
                    regime := 2
                else if regime == 1
                    regime := 2
                    addMss(k, swlIdx, swlPrice, false)
                if lastSWHidx >= 0
                    addRBFromSwing(lastSWHidx, true, k, 0)
                haveSWL := false
                swlCons := true

            // MID-ARM
            peek3 = ei
            while peek3 < evTotal
                pEv3 = array.get(events, peek3)
                if pEv3.confirmIdx != k
                    break
                if pEv3.kind == 0
                    haveSWH  := true
                    swhPrice := pEv3.price
                    swhIdx   := pEv3.swingIdx
                    tryBearARB(prevReg, aobSWLi, pEv3.swingIdx, pEv3.price, k)
                else
                    haveSWL  := true
                    swlPrice := pEv3.price
                    swlIdx   := pEv3.swingIdx
                    tryBullARB(prevReg, aobSWHi, pEv3.swingIdx, pEv3.price, k)
                peek3 += 1

            // Second break: SWH
            if haveSWH and array.get(H_, k) > swhPrice
                if regime == 0
                    regime := 1
                else if regime == 2
                    regime := 1
                    addMss(k, swhIdx, swhPrice, true)
                if lastSWLidx >= 0
                    addRBFromSwing(lastSWLidx, false, k, 0)
                haveSWH := false
                swhCons := true

        // STEP 2: arm swings (consumed check) + IRB eligibility
        while ei < evTotal
            sEv = array.get(events, ei)
            if sEv.confirmIdx != k
                break
            if sEv.kind == 0
                if not swhCons
                    haveSWH  := true
                    swhPrice := sEv.price
                    swhIdx   := sEv.swingIdx
                lastSWHidx := sEv.swingIdx
                rbSz = array.size(rbs)
                for zr = 0 to rbSz - 1
                    if zr < 0 or zr >= rbSz
                        continue
                    rbZ = array.get(rbs, zr)
                    if rbZ.bullish and rbZ.state == 0 and rbZ.eligibleK == -1 and k > rbZ.triggerK
                        rbZ.eligibleK := k
                        array.set(rbs, zr, rbZ)
            else
                if not swlCons
                    haveSWL  := true
                    swlPrice := sEv.price
                    swlIdx   := sEv.swingIdx
                lastSWLidx := sEv.swingIdx
                rbSz2 = array.size(rbs)
                for zr2 = 0 to rbSz2 - 1
                    if zr2 < 0 or zr2 >= rbSz2
                        continue
                    rbZ2 = array.get(rbs, zr2)
                    if not rbZ2.bullish and rbZ2.state == 0 and rbZ2.eligibleK == -1 and k > rbZ2.triggerK
                        rbZ2.eligibleK := k
                        array.set(rbs, zr2, rbZ2)
            ei += 1

        // STEP 3: RB lifecycle at this candle -- IMPACT + STRANDING only
        // (no close-through rule, that's FVG-only).
        hK = array.get(H_, k)
        lK = array.get(L_, k)
        rbTotal = array.size(rbs)
        for zr3 = 0 to rbTotal - 1
            if zr3 < 0 or zr3 >= rbTotal
                continue
            rbZ3 = array.get(rbs, zr3)
            if rbZ3.state == 3
                continue

            zbr = rbZ3.zb
            ztr = rbZ3.zt
            bullr = rbZ3.bullish

            // IMPACT: any wick reaching into the zone, once eligible, ends it.
            if rbZ3.eligibleK != -1 and k >= rbZ3.eligibleK
                if hK >= zbr and lK <= ztr
                    rbZ3.preSpentState := rbZ3.state
                    rbZ3.state := 3
                    rbZ3.stopK := k
                    array.set(rbs, zr3, rbZ3)
                    continue

            // STRANDING -> ORB: origin decides the rule -- IRB-style
            // (origin 0) strands far-side, mirroring IFOB; ARB-style
            // (origin 1) strands near-side, mirroring AOB.
            if (rbZ3.state == 0 or rbZ3.state == 1) and rbZ3.eligibleK != -1
                isIRB = rbZ3.origin != 1
                for e2 = evBeforeSwing to evTotal - 1
                    if e2 < 0 or e2 >= evTotal
                        continue
                    stEv = array.get(events, e2)
                    if stEv.confirmIdx != k
                        continue
                    strandedR = false
                    if isIRB
                        if bullr and stEv.kind == 1 and stEv.price > ztr
                            strandedR := true
                        if not bullr and stEv.kind == 0 and stEv.price < zbr
                            strandedR := true
                    else
                        // ARB's bull/bear tag is RAW WICK TYPE, opposite of
                        // AFVG's hunt-direction tag: tryBearARB (pReg==2)
                        // anchors a swing-LOW wick -> bullish; tryBullARB
                        // (pReg==1) anchors a swing-HIGH wick -> bearish.
                        // So the correct near-side check is the OPPOSITE
                        // kind/side pairing from AFVG's formula, not a
                        // literal copy of it -- a bullish ARB (low-wick,
                        // price above it) strands on a new swing LOW that
                        // tops out above its own top; a bearish ARB
                        // (high-wick, price below it) strands on a new
                        // swing HIGH that bottoms out below its own bottom.
                        if bullr and stEv.kind == 1 and stEv.price > ztr
                            strandedR := true
                        if not bullr and stEv.kind == 0 and stEv.price < zbr
                            strandedR := true
                    if strandedR
                        rbZ3.state := 2
                        array.set(rbs, zr3, rbZ3)
                        break

// ===================== DRAWING (last bar only) =====================
if barstate.islast
    lblSzD = array.size(drawnLabels)
    for lb = 0 to lblSzD - 1
        if lb < 0 or lb >= lblSzD
            continue
        label.delete(array.get(drawnLabels, lb))
    array.clear(drawnLabels)
    boxSzD = array.size(drawnBoxes)
    for bx = 0 to boxSzD - 1
        if bx < 0 or bx >= boxSzD
            continue
        box.delete(array.get(drawnBoxes, bx))
    array.clear(drawnBoxes)

    nArr = array.size(O_)
    if nArr < 2
        runtime.error("Insufficient data")

    dispFrom = useDisplayFrom ? InpDisplayFrom : (time - InpMonthsBack * 30 * 24 * 60 * 60 * 1000)

    // ORB hidden on 5m/1h/4h, same treatment as OOB/OFVG -- flag if RB
    // shouldn't follow that convention.
    hideOOBHere = timeframe.period == "5" or timeframe.period == "60" or timeframe.period == "240"

    // --- Swing HIGHS: blue up arrow ---
    shSz = array.size(swHighs)
    shStart = math.max(0, shSz - InpMaxLabelsPerCategory)
    for s = shStart to shSz - 1
        if s < 0 or s >= shSz
            continue
        idx = array.get(swHighs, s)
        if idx < 0 or idx >= nArr
            continue
        bt = array.get(BT, idx)
        if bt < dispFrom
            continue
        yP = array.get(H_, idx)
        lbl = label.new(bt, yP, "▲", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=color.blue, size=size.small)
        array.push(drawnLabels, lbl)

    // --- Swing LOWS: black down arrow ---
    slSz = array.size(swLows)
    slStart = math.max(0, slSz - InpMaxLabelsPerCategory)
    for s = slStart to slSz - 1
        if s < 0 or s >= slSz
            continue
        idx = array.get(swLows, s)
        if idx < 0 or idx >= nArr
            continue
        bt = array.get(BT, idx)
        if bt < dispFrom
            continue
        yP = array.get(L_, idx) - swLowGapOffset
        lbl = label.new(bt, yP, "▼", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=color.black, size=size.small)
        array.push(drawnLabels, lbl)

    // --- MSS flips: cross mark at broken swing's location ---
    mssSz = array.size(msses)
    mssStart = math.max(0, mssSz - InpMaxLabelsPerCategory)
    for m = mssStart to mssSz - 1
        if m < 0 or m >= mssSz
            continue
        mEv = array.get(msses, m)
        bIdx = mEv.brokenIdx
        if bIdx < 0 or bIdx >= nArr
            continue
        bt = array.get(BT, bIdx)
        if bt < dispFrom
            continue
        isUp = mEv.toUp
        yP = isUp ? array.get(H_, bIdx) : array.get(L_, bIdx) - swLowGapOffset
        col = isUp ? color.blue : color.black
        lbl = label.new(bt, yP, "✕", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=col, size=size.small)
        array.push(drawnLabels, lbl)

    extT = time + 50 * timeframe.in_seconds() * 1000

    // --- RB zones: dashed hollow box, no fill, no midline. Live IRB:
    // blue(bull)/black(bear) by its own raw-wick label. Live ARB: green,
    // fixed. ORB (either origin, once stranded): red, fixed, hidden on
    // 5m/1h/4h. Capped independently per category (IRB vs ARB, by
    // origin), and by chronological leftIdx rather than raw array-
    // insertion position -- same fix already applied to IFVG/AFVG, built
    // in from the start here instead of discovered later.
    rbSzD = array.size(rbs)
    irbLeft = array.new<int>()
    arbLeft = array.new<int>()
    for zr = 0 to rbSzD - 1
        rbScan = array.get(rbs, zr)
        if rbScan.origin == 1
            array.push(arbLeft, rbScan.leftIdx)
        else
            array.push(irbLeft, rbScan.leftIdx)
    array.sort(irbLeft, order.descending)
    array.sort(arbLeft, order.descending)
    irbCutoff = array.size(irbLeft) > 0 ? array.get(irbLeft, math.min(InpMaxRbPerCategory, array.size(irbLeft)) - 1) : 999999999
    arbCutoff = array.size(arbLeft) > 0 ? array.get(arbLeft, math.min(InpMaxRbPerCategory, array.size(arbLeft)) - 1) : 999999999
    for zr = 0 to rbSzD - 1
        rbD = array.get(rbs, zr)
        idxR = rbD.leftIdx
        if idxR < 0 or idxR >= nArr
            continue
        catCutoffR = rbD.origin == 1 ? arbCutoff : irbCutoff
        if idxR < catCutoffR
            continue

        btR = array.get(BT, idxR)
        if btR < dispFrom
            continue

        dStR = rbD.state == 3 ? rbD.preSpentState : rbD.state
        if dStR == 2 and hideOOBHere
            continue

        leftTR = btR
        rightTR = extT
        if rbD.stopK != -1 and rbD.stopK < nArr
            rightTR := array.get(BT, rbD.stopK)

        colR = dStR == 2 ? color.red : dStR == 1 ? color.green : (rbD.bullish ? color.blue : color.black)

        bxR = box.new(leftTR, rbD.zt, rightTR, rbD.zb, border_color=colR, border_width=1,
                      border_style=line.style_dashed, bgcolor=na, xloc=xloc.bar_time)
        array.push(drawnBoxes, bxR)
