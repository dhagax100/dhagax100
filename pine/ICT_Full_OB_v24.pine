// ICT_Full_OB_v24 — Pine Script v5
// Faithful port of ICT_Full_OB_v24 MQL5 indicator.
// Draws swing highs, swing lows, MSS flips, and Order Block zones
// (IFOB, AOB, AIFOB, OOB, SPENT) with identical logic.
// Also draws IFVG (Fair Value Gap, continuation-only for now -- AFVG/AIFVG
// not yet implemented): mirrors IFOB's trigger/range/eligibility/stranding
// rules one-for-one, but picks EVERY qualifying 3-candle gap in that range
// instead of one best-body candle. See docs/trading_logic.md section 4.
// Diagnostic PrintFormat calls omitted (no console in Pine Script).
//@version=5
indicator("ICT Full OB v24", overlay=true, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

// ===================== INPUTS =====================
InpMonthsBack  = input.int(6, "Months to display")
InpDisplayFrom = input.time(timestamp("2025-07-25"), "Display from date")
useDisplayFrom = input.bool(true, "Use exact display-from date (else use months)")
InpReplayUpTo  = input.time(0, "Replay up to date (0=show all)")
useReplay      = input.bool(false, "Enable replay mode")
InpFocusOB     = input.int(0, "Focus OB (0=show all in window, N=Nth from end)")
InpMaxLabelsPerCategory = input.int(150, "Max swing-high / swing-low / MSS labels shown (each, most recent kept)", minval=1, maxval=160)
InpSwingLowGapATR = input.float(0.08, "Swing-low arrow / down-MSS gap below the low (x ATR14)", minval=0.0)
InpMaxFvgPerCategory = input.int(150, "Max IFVG boxes shown (most recent kept)", minval=1, maxval=160)
InpFvgFillTransparency = input.int(85, "IFVG fill transparency % (0=solid, 100=invisible)", minval=0, maxval=100)

// ===================== TYPE DEFINITIONS =====================
type SwEv
    int   confirmIdx
    int   kind         // 0=high, 1=low
    int   swingIdx
    float price

type MssEv
    int   atIdx
    int   brokenIdx
    float price
    bool  toUp

type ObZone
    int   candle
    float zb
    float zt
    bool  bullish
    int   triggerK
    int   eligibleK     // -1 = not yet eligible
    int   stopK         // -1 = extending
    int   state         // 0=IFOB, 1=AOB, 2=OOB, 3=SPENT, 4=AIFOB
    int   origState
    int   preSpentState

// IFVG only for now (mirrors IFOB one-for-one: same trigger/range/eligibility/
// stranding rules, just picks EVERY qualifying 3-candle gap in that range
// instead of one best-body candle). AFVG/AIFVG not implemented yet, so no
// origState needed -- only one creation type exists, and stranding always
// uses the IFOB-style rule (no AOB-style opposite direction to choose between).
type FvgZone
    int   leftIdx        // candle1 of the 3-candle gap (left edge of the box)
    float zb
    float zt
    bool  bullish
    int   triggerK       // the leg's breakout candle -- same k as the IFOB
                          // created from this same leg, per spec
    int   eligibleK      // -1 = not yet eligible (delayed, mirrors IFOB)
    int   stopK          // -1 = extending
    int   state          // 0=IFVG, 2=OFVG, 3=SPENT
    int   preSpentState

// ===================== PERSISTENT STATE =====================
var events     = array.new<SwEv>()
var msses      = array.new<MssEv>()
var obs        = array.new<ObZone>()
var fvgs       = array.new<FvgZone>()
var swHighs    = array.new<int>()
var swLows     = array.new<int>()

// OHLC + time storage (absolute indexing, oldest=0)
var O_ = array.new<float>()
var H_ = array.new<float>()
var L_ = array.new<float>()
var C_ = array.new<float>()
var BI = array.new<int>()      // bar_index of each bar
var BT = array.new<int>()      // bar time (ms) of each bar

// Swing detection trackers
var int peakIdx_   = 0
var int troughIdx_ = 0

// Regime / MSS / OB trackers
var bool  haveSWH   = false
var float swhPrice  = 0.0
var int   swhIdx    = 0
var bool  haveSWL   = false
var float swlPrice  = 0.0
var int   swlIdx    = 0
var int   regime    = 0      // 0=warmup, 1=up, 2=down
var int   ei        = 0      // event pointer
var int   lastSWHidx = -1
var int   lastSWLidx = -1
var int   pendBullAifob = -1
var int   pendBearAifob = -1
var int   fvgBullScanUpto = -1   // last bar index whose bullish 3-candle window was checked for a gap
var int   fvgBearScanUpto = -1   // same, bearish side

// Guard: process each bar exactly once
var int lastProcessedBI = -1

// Drawing object arrays (for cleanup on redraw)
var drawnLabels = array.new<label>()
var drawnBoxes  = array.new<box>()
var drawnLines  = array.new<line>()   // IFVG 50% midpoint lines

// Replay gate
replayActive = useReplay and InpReplayUpTo > 0
skipBar = replayActive and time > InpReplayUpTo

// ATR-scaled visual gap for the swing-low arrow (see DRAWING section) --
// computed unconditionally every bar like any other ta.* series, not just
// inside the barstate.islast draw block, so its running calculation stays
// correct.
swLowGapOffset = ta.atr(14) * InpSwingLowGapATR

// ===================== HELPER FUNCTIONS =====================
addSH(int idx) =>
    sz = array.size(swHighs)
    doPush = sz == 0
    if not doPush
        doPush := array.get(swHighs, sz - 1) != idx
    if doPush
        array.push(swHighs, idx)

addSL(int idx) =>
    sz = array.size(swLows)
    doPush = sz == 0
    if not doPush
        doPush := array.get(swLows, sz - 1) != idx
    if doPush
        array.push(swLows, idx)

addEv(int cIdx, int kind, int sIdx, float pr) =>
    array.push(events, SwEv.new(cIdx, kind, sIdx, pr))

addMss(int aIdx, int bIdx, float pr, bool up) =>
    array.push(msses, MssEv.new(aIdx, bIdx, pr, up))

addOB(int cand, float zb, float zt, bool bull, int tK, int st) =>
    eK = (st == 1 or st == 4) ? tK : -1
    array.push(obs, ObZone.new(cand, zb, zt, bull, tK, eK, -1, st, st, st))

addFVG(int leftIdx, float zb, float zt, bool bull, int tK) =>
    // Delayed eligibility (-1), mirroring IFOB -- NOT immediate like AOB.
    array.push(fvgs, FvgZone.new(leftIdx, zb, zt, bull, tK, -1, -1, 0, 0))

// Scans [lo,hi] -- the SAME range an IFOB is picked from -- for EVERY
// qualifying 3-candle gap (not just one best candle, per spec). Called
// alongside IFOB creation at all four break-check sites, using the same
// lo/hi/direction/triggerK already computed there, independent of whether
// an IFOB candle was actually found in that range.
tryCreateIFVGs(int lo, int hi, bool bullish, int triggerK) =>
    if hi >= lo + 2
        for c3 = lo + 2 to hi
            c1 = c3 - 2
            if bullish
                h1 = array.get(H_, c1)
                l3 = array.get(L_, c3)
                if h1 < l3
                    addFVG(c1, h1, l3, true, triggerK)
            else
                l1 = array.get(L_, c1)
                h3 = array.get(H_, c3)
                if l1 > h3
                    addFVG(c1, h3, l1, false, triggerK)

// --- AOB HUNT: Bullish ---
tryBullAOB(int pReg, int aobSWHi, int newSwlI, float newSwlP, int k) =>
    if pReg == 1 and aobSWHi >= 0
        // Reference-validity guard: the armed swing high is captured once,
        // then used later once the retracement's swing low finally confirms.
        // The only thing gating that wait is chronological order (low
        // confirms after high) -- nothing checks whether the armed high
        // itself got exceeded by a LATER candle somewhere in between before
        // this hunt ever fires. If any candle from right after the armed
        // high through to the new swing low already broke above it, the
        // reference is stale -- reject the whole hunt, not just check the
        // one candle we end up picking against it.
        armedSwhPrice = array.get(H_, aobSWHi)
        refViolated = false
        for v = aobSWHi + 1 to newSwlI
            if array.get(H_, v) >= armedSwhPrice
                refViolated := true
        if not refViolated
            lo2 = math.max(0, math.min(aobSWHi - 1, newSwlI))
            hi2 = math.max(aobSWHi - 1, newSwlI)
            best2 = -1
            for x = lo2 to hi2
                if x < 0
                    continue
                cX = array.get(C_, x)
                oX = array.get(O_, x)
                okB2 = false
                if cX > oX
                    if best2 == -1
                        okB2 := true
                    else
                        okB2 := cX > array.get(C_, best2)
                if okB2
                    best2 := x
            if best2 != -1
                // Near-side guard: picked candle can't straddle the new swing
                // low that triggered this hunt (that candle IS the pivot, not
                // a candle inside the retracement).
                if array.get(L_, best2) > newSwlP
                    oB = array.get(O_, best2)
                    cB = array.get(C_, best2)
                    addOB(best2, math.min(oB, cB), math.max(oB, cB), true, k, 1)

// --- AOB HUNT: Bearish ---
tryBearAOB(int pReg, int aobSWLi, int newSwhI, float newSwhP, int k) =>
    if pReg == 2 and aobSWLi >= 0
        // Reference-validity guard, mirrored from the bullish hunt: reject
        // the whole thing if the armed swing low already got broken by a
        // later candle before this hunt fires, instead of only checking the
        // one candle we end up picking against it.
        armedSwlPrice = array.get(L_, aobSWLi)
        refViolated = false
        for v = aobSWLi + 1 to newSwhI
            if array.get(L_, v) <= armedSwlPrice
                refViolated := true
        if not refViolated
            lo2 = math.max(0, math.min(aobSWLi - 1, newSwhI))
            hi2 = math.max(aobSWLi - 1, newSwhI)
            best2 = -1
            for x = lo2 to hi2
                if x < 0
                    continue
                cX = array.get(C_, x)
                oX = array.get(O_, x)
                okB2 = false
                if cX < oX
                    if best2 == -1
                        okB2 := true
                    else
                        okB2 := cX < array.get(C_, best2)
                if okB2
                    best2 := x
            if best2 != -1
                // Near-side guard: picked candle can't straddle the new swing
                // high that triggered this hunt.
                if array.get(H_, best2) < newSwhP
                    oB = array.get(O_, best2)
                    cB = array.get(C_, best2)
                    addOB(best2, math.min(oB, cB), math.max(oB, cB), false, k, 1)

// --- AIFOB HUNT: Bullish (returns obs[] index or -1) ---
tryBullAIFOB(int pReg, bool pHaveSWH, int pSwhI, int pLastSWLi, int newSwlI, int k) =>
    result = -1
    if pReg == 1 and pHaveSWH and pSwhI >= 0 and pLastSWLi >= 0
        lo = math.max(0, math.min(math.min(pLastSWLi, newSwlI), pSwhI - 1))
        hi = math.max(math.max(pLastSWLi, newSwlI), pSwhI - 1)
        best = -1
        for x = lo to hi
            if x < 0
                continue
            cX = array.get(C_, x)
            oX = array.get(O_, x)
            okB = false
            if cX < oX
                if best == -1
                    okB := true
                else
                    okB := cX < array.get(C_, best)
            if okB
                best := x
        if best != -1
            oB = array.get(O_, best)
            cB = array.get(C_, best)
            addOB(best, math.min(oB, cB), math.max(oB, cB), true, k, 4)
            result := array.size(obs) - 1
    result

// --- AIFOB HUNT: Bearish (returns obs[] index or -1) ---
tryBearAIFOB(int pReg, bool pHaveSWL, int pSwlI, int pLastSWHi, int newSwhI, int k) =>
    result = -1
    if pReg == 2 and pHaveSWL and pSwlI >= 0 and pLastSWHi >= 0
        lo = math.max(0, math.min(math.min(pLastSWHi, newSwhI), pSwlI - 1))
        hi = math.max(math.max(pLastSWHi, newSwhI), pSwlI - 1)
        best = -1
        for x = lo to hi
            if x < 0
                continue
            cX = array.get(C_, x)
            oX = array.get(O_, x)
            okB = false
            if cX > oX
                if best == -1
                    okB := true
                else
                    okB := cX > array.get(C_, best)
            if okB
                best := x
        if best != -1
            oB = array.get(O_, best)
            cB = array.get(C_, best)
            addOB(best, math.min(oB, cB), math.max(oB, cB), false, k, 4)
            result := array.size(obs) - 1
    result

// ===================== MAIN PROCESSING =====================
// Process each bar exactly once (matches MQL5 lastN guard)
if not skipBar and bar_index != lastProcessedBI
    lastProcessedBI := bar_index

    // Push current bar data
    array.push(O_, open)
    array.push(H_, high)
    array.push(L_, low)
    array.push(C_, close)
    array.push(BI, bar_index)
    array.push(BT, int(time))

    n = array.size(O_)
    if n >= 2
        i = n - 1    // current bar index in our arrays

        // ========== SWING DETECTION ==========
        isBull   = array.get(C_, i) >= array.get(O_, i)
        brkH     = array.get(H_, i) > array.get(H_, i - 1)
        brkL     = array.get(L_, i) < array.get(L_, i - 1)
        dualAct  = brkH and brkL

        // detect previous dual-action
        prevDual = false
        eCnt = array.size(events)
        if eCnt >= 2
            ev1 = array.get(events, eCnt - 1)
            ev2 = array.get(events, eCnt - 2)
            prevDual := (ev1.kind != ev2.kind) and (ev1.confirmIdx == ev2.confirmIdx) and (ev1.confirmIdx == i - 1)

        blockPD = prevDual and not dualAct

        evBeforeSwing = array.size(events)  // save for STEP 3

        if not isBull
            // BEARISH: High first, then Low
            if array.get(H_, i) > array.get(H_, peakIdx_)
                peakIdx_ := i
            if brkH
                lk = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                if lk != 1 and not blockPD
                    addSL(troughIdx_)
                    addEv(i, 1, troughIdx_, array.get(L_, troughIdx_))
                    peakIdx_ := i
            if array.get(L_, i) < array.get(L_, troughIdx_)
                troughIdx_ := i
            if brkL
                lk2 = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                if lk2 != 0 and not blockPD
                    addSH(peakIdx_)
                    addEv(i, 0, peakIdx_, array.get(H_, peakIdx_))
                    troughIdx_ := i
        else
            // BULLISH: Low first, then High
            if array.get(L_, i) < array.get(L_, troughIdx_)
                troughIdx_ := i
            if brkL
                lk3 = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                if lk3 != 0 and not blockPD
                    addSH(peakIdx_)
                    addEv(i, 0, peakIdx_, array.get(H_, peakIdx_))
                    troughIdx_ := i
            if array.get(H_, i) > array.get(H_, peakIdx_)
                peakIdx_ := i
            if brkH
                lk4 = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                if lk4 != 1 and not blockPD
                    addSL(troughIdx_)
                    addEv(i, 1, troughIdx_, array.get(L_, troughIdx_))
                    peakIdx_ := i

        // ========== REGIME / MSS / OB ENGINE ==========
        k = i
        evTotal = array.size(events)

        // STEP 0: peek-ahead — update lastSWHidx/lastSWLidx
        peek0 = ei
        while peek0 < evTotal
            pEv = array.get(events, peek0)
            if pEv.confirmIdx != k
                break
            if pEv.kind == 0
                lastSWHidx := pEv.swingIdx
            else
                lastSWLidx := pEv.swingIdx
            peek0 += 1

        prevReg = regime
        swhCons = false
        swlCons = false
        aobSWHi = swhIdx
        aobSWLi = swlIdx

        // STEP 1 + MID-ARM: break checks, MSS, IFOB, AOB, AIFOB
        kBull = array.get(C_, k) >= array.get(O_, k)

        if not kBull
            // --- BEARISH bar: high first -> SWH break first ---
            if haveSWH and array.get(H_, k) > swhPrice
                if regime == 0
                    regime := 1
                else if regime == 2
                    regime := 1
                    addMss(k, swhIdx, swhPrice, true)
                // IFOB or promote AIFOB
                if pendBullAifob != -1
                    obRef = array.get(obs, pendBullAifob)
                    obRef.state     := 0
                    obRef.origState := 0
                    array.set(obs, pendBullAifob, obRef)
                    pendBullAifob := -1
                else if lastSWLidx >= 0
                    lo = math.min(math.min(lastSWLidx, k), swhIdx)
                    hi = math.max(math.max(lastSWLidx, k), swhIdx)
                    tryCreateIFVGs(lo, hi, true, k)
                    fvgBullScanUpto := hi
                    best = -1
                    for x = lo to hi
                        cX = array.get(C_, x)
                        oX = array.get(O_, x)
                        okB = false
                        if cX < oX
                            if best == -1
                                okB := true
                            else
                                okB := cX < array.get(C_, best)
                        if okB
                            best := x
                    if best != -1
                        oB = array.get(O_, best)
                        cB = array.get(C_, best)
                        addOB(best, math.min(oB, cB), math.max(oB, cB), true, k, 0)
                haveSWH := false
                swhCons := true

            // MID-ARM
            peek2 = ei
            while peek2 < evTotal
                pEv2 = array.get(events, peek2)
                if pEv2.confirmIdx != k
                    break
                if pEv2.kind == 0
                    haveSWH  := true
                    swhPrice := pEv2.price
                    swhIdx   := pEv2.swingIdx
                    pendBullAifob := -1
                    tryBearAOB(prevReg, aobSWLi, pEv2.swingIdx, pEv2.price, k)
                    if pendBearAifob == -1
                        r2 = tryBearAIFOB(prevReg, haveSWL, aobSWLi, lastSWHidx, pEv2.swingIdx, k)
                        if r2 != -1
                            pendBearAifob := r2
                else
                    haveSWL  := true
                    swlPrice := pEv2.price
                    swlIdx   := pEv2.swingIdx
                    pendBearAifob := -1
                    tryBullAOB(prevReg, aobSWHi, pEv2.swingIdx, pEv2.price, k)
                    if pendBullAifob == -1
                        r3 = tryBullAIFOB(prevReg, haveSWH, aobSWHi, lastSWLidx, pEv2.swingIdx, k)
                        if r3 != -1
                            pendBullAifob := r3
                peek2 += 1

            // Second break: SWL
            if haveSWL and array.get(L_, k) < swlPrice
                if regime == 0
                    regime := 2
                else if regime == 1
                    regime := 2
                    addMss(k, swlIdx, swlPrice, false)
                if pendBearAifob != -1
                    obRef2 = array.get(obs, pendBearAifob)
                    obRef2.state     := 0
                    obRef2.origState := 0
                    array.set(obs, pendBearAifob, obRef2)
                    pendBearAifob := -1
                else if lastSWHidx >= 0
                    lo2 = math.min(math.min(lastSWHidx, k), swlIdx)
                    hi2 = math.max(math.max(lastSWHidx, k), swlIdx)
                    tryCreateIFVGs(lo2, hi2, false, k)
                    fvgBearScanUpto := hi2
                    best2 = -1
                    for x = lo2 to hi2
                        cX = array.get(C_, x)
                        oX = array.get(O_, x)
                        okB2 = false
                        if cX > oX
                            if best2 == -1
                                okB2 := true
                            else
                                okB2 := cX > array.get(C_, best2)
                        if okB2
                            best2 := x
                    if best2 != -1
                        oB = array.get(O_, best2)
                        cB = array.get(C_, best2)
                        addOB(best2, math.min(oB, cB), math.max(oB, cB), false, k, 0)
                haveSWL := false
                swlCons := true

        else
            // --- BULLISH bar: low first -> SWL break first ---
            if haveSWL and array.get(L_, k) < swlPrice
                if regime == 0
                    regime := 2
                else if regime == 1
                    regime := 2
                    addMss(k, swlIdx, swlPrice, false)
                if pendBearAifob != -1
                    obRef3 = array.get(obs, pendBearAifob)
                    obRef3.state     := 0
                    obRef3.origState := 0
                    array.set(obs, pendBearAifob, obRef3)
                    pendBearAifob := -1
                else if lastSWHidx >= 0
                    lo3 = math.min(math.min(lastSWHidx, k), swlIdx)
                    hi3 = math.max(math.max(lastSWHidx, k), swlIdx)
                    tryCreateIFVGs(lo3, hi3, false, k)
                    fvgBearScanUpto := hi3
                    best3 = -1
                    for x = lo3 to hi3
                        cX = array.get(C_, x)
                        oX = array.get(O_, x)
                        okB3 = false
                        if cX > oX
                            if best3 == -1
                                okB3 := true
                            else
                                okB3 := cX > array.get(C_, best3)
                        if okB3
                            best3 := x
                    if best3 != -1
                        oB = array.get(O_, best3)
                        cB = array.get(C_, best3)
                        addOB(best3, math.min(oB, cB), math.max(oB, cB), false, k, 0)
                haveSWL := false
                swlCons := true

            // MID-ARM
            peek3 = ei
            while peek3 < evTotal
                pEv3 = array.get(events, peek3)
                if pEv3.confirmIdx != k
                    break
                if pEv3.kind == 0
                    haveSWH  := true
                    swhPrice := pEv3.price
                    swhIdx   := pEv3.swingIdx
                    pendBullAifob := -1
                    tryBearAOB(prevReg, aobSWLi, pEv3.swingIdx, pEv3.price, k)
                    if pendBearAifob == -1
                        r4 = tryBearAIFOB(prevReg, haveSWL, aobSWLi, lastSWHidx, pEv3.swingIdx, k)
                        if r4 != -1
                            pendBearAifob := r4
                else
                    haveSWL  := true
                    swlPrice := pEv3.price
                    swlIdx   := pEv3.swingIdx
                    pendBearAifob := -1
                    tryBullAOB(prevReg, aobSWHi, pEv3.swingIdx, pEv3.price, k)
                    if pendBullAifob == -1
                        r5 = tryBullAIFOB(prevReg, haveSWH, aobSWHi, lastSWLidx, pEv3.swingIdx, k)
                        if r5 != -1
                            pendBullAifob := r5
                peek3 += 1

            // Second break: SWH
            if haveSWH and array.get(H_, k) > swhPrice
                if regime == 0
                    regime := 1
                else if regime == 2
                    regime := 1
                    addMss(k, swhIdx, swhPrice, true)
                if pendBullAifob != -1
                    obRef4 = array.get(obs, pendBullAifob)
                    obRef4.state     := 0
                    obRef4.origState := 0
                    array.set(obs, pendBullAifob, obRef4)
                    pendBullAifob := -1
                else if lastSWLidx >= 0
                    lo4 = math.min(math.min(lastSWLidx, k), swhIdx)
                    hi4 = math.max(math.max(lastSWLidx, k), swhIdx)
                    tryCreateIFVGs(lo4, hi4, true, k)
                    fvgBullScanUpto := hi4
                    best4 = -1
                    for x = lo4 to hi4
                        cX = array.get(C_, x)
                        oX = array.get(O_, x)
                        okB4 = false
                        if cX < oX
                            if best4 == -1
                                okB4 := true
                            else
                                okB4 := cX < array.get(C_, best4)
                        if okB4
                            best4 := x
                    if best4 != -1
                        oB = array.get(O_, best4)
                        cB = array.get(C_, best4)
                        addOB(best4, math.min(oB, cB), math.max(oB, cB), true, k, 0)
                haveSWH := false
                swhCons := true

        // STEP 1b: continuous IFVG scan — keeps checking the newest 3-candle
        // window every bar for as long as the current regime persists, not
        // just once at the exceedance moment. Covers (a) gaps that form on
        // continuation candles after the exceedance, before the next same-
        // direction swing confirms, and (b) every later leg of the same
        // trend (including AIFOB-sourced legs), since it only stops when
        // regime itself reverses. The batch scans above already cover the
        // one-time retrospective breakout leg at each exceedance/reversal;
        // this just picks up from there, bar by bar, with no double count
        // (fvgBull/BearScanUpto is bumped to hi/hi2/hi3/hi4 right after each
        // batch scan, so the window ending on the same bar isn't rechecked).
        if regime == 1 and k >= 2 and k > fvgBullScanUpto
            h1c = array.get(H_, k - 2)
            l3c = array.get(L_, k)
            if h1c < l3c
                addFVG(k - 2, h1c, l3c, true, k)
            fvgBullScanUpto := k
        if regime == 2 and k >= 2 and k > fvgBearScanUpto
            l1c = array.get(L_, k - 2)
            h3c = array.get(H_, k)
            if l1c > h3c
                addFVG(k - 2, h3c, l1c, false, k)
            fvgBearScanUpto := k

        // STEP 2: arm swings (consumed check) + IFOB/IFVG eligibility
        while ei < evTotal
            sEv = array.get(events, ei)
            if sEv.confirmIdx != k
                break
            if sEv.kind == 0
                if not swhCons
                    haveSWH  := true
                    swhPrice := sEv.price
                    swhIdx   := sEv.swingIdx
                lastSWHidx := sEv.swingIdx
                obSz = array.size(obs)
                for z = 0 to obSz - 1
                    if z < 0 or z >= obSz
                        continue
                    obZ = array.get(obs, z)
                    if obZ.bullish and obZ.state == 0 and obZ.eligibleK == -1 and k > obZ.triggerK
                        obZ.eligibleK := k
                        array.set(obs, z, obZ)
                fvgSz = array.size(fvgs)
                for zf = 0 to fvgSz - 1
                    if zf < 0 or zf >= fvgSz
                        continue
                    fvgZ = array.get(fvgs, zf)
                    if fvgZ.bullish and fvgZ.state == 0 and fvgZ.eligibleK == -1 and k > fvgZ.triggerK
                        fvgZ.eligibleK := k
                        array.set(fvgs, zf, fvgZ)
            else
                if not swlCons
                    haveSWL  := true
                    swlPrice := sEv.price
                    swlIdx   := sEv.swingIdx
                lastSWLidx := sEv.swingIdx
                obSz2 = array.size(obs)
                for z = 0 to obSz2 - 1
                    if z < 0 or z >= obSz2
                        continue
                    obZ2 = array.get(obs, z)
                    if not obZ2.bullish and obZ2.state == 0 and obZ2.eligibleK == -1 and k > obZ2.triggerK
                        obZ2.eligibleK := k
                        array.set(obs, z, obZ2)
                fvgSz2 = array.size(fvgs)
                for zf2 = 0 to fvgSz2 - 1
                    if zf2 < 0 or zf2 >= fvgSz2
                        continue
                    fvgZ2 = array.get(fvgs, zf2)
                    if not fvgZ2.bullish and fvgZ2.state == 0 and fvgZ2.eligibleK == -1 and k > fvgZ2.triggerK
                        fvgZ2.eligibleK := k
                        array.set(fvgs, zf2, fvgZ2)
            ei += 1

        // STEP 3: OB lifecycle at this candle
        obTotal = array.size(obs)
        hK = array.get(H_, k)
        lK = array.get(L_, k)
        for z = 0 to obTotal - 1
            if z < 0 or z >= obTotal
                continue
            obZ3 = array.get(obs, z)
            if obZ3.state == 3
                continue

            zb = obZ3.zb
            zt = obZ3.zt
            bull = obZ3.bullish

            // IMPACT
            if obZ3.eligibleK != -1 and k >= obZ3.eligibleK
                if hK >= zb and lK <= zt
                    obZ3.preSpentState := obZ3.state
                    obZ3.state := 3
                    obZ3.stopK := k
                    array.set(obs, z, obZ3)
                    continue

            // STRANDING -> OOB
            if (obZ3.state == 0 or obZ3.state == 1 or obZ3.state == 4) and obZ3.eligibleK != -1
                isIFOB = obZ3.origState != 1
                // scan only events confirmed at THIS bar (they start at evBeforeSwing in worst case,
                // but are contiguous at end of events array for this bar)
                for e2 = evBeforeSwing to evTotal - 1
                    if e2 < 0 or e2 >= evTotal
                        continue
                    stEv = array.get(events, e2)
                    if stEv.confirmIdx != k
                        continue
                    stranded = false
                    if isIFOB
                        if bull and stEv.kind == 1 and stEv.price > zt
                            stranded := true
                        if not bull and stEv.kind == 0 and stEv.price < zb
                            stranded := true
                    else
                        if bull and stEv.kind == 0 and stEv.price < zb
                            stranded := true
                        if not bull and stEv.kind == 1 and stEv.price > zt
                            stranded := true
                    if stranded
                        obZ3.state := 2
                        array.set(obs, z, obZ3)
                        break

        // STEP 3b: IFVG lifecycle at this candle -- same order as OB (impact
        // before stranding), so a zone that just became eligible THIS bar
        // still gets checked against THIS bar's own high/low, same as OB.
        fvgTotal = array.size(fvgs)
        for zf3 = 0 to fvgTotal - 1
            if zf3 < 0 or zf3 >= fvgTotal
                continue
            fvgZ3 = array.get(fvgs, zf3)
            if fvgZ3.state == 3
                continue

            zbf = fvgZ3.zb
            ztf = fvgZ3.zt
            bullf = fvgZ3.bullish

            // IMPACT: same rule as OB -- any wick reaching into the gap, once
            // eligible, ends it.
            if fvgZ3.eligibleK != -1 and k >= fvgZ3.eligibleK
                if hK >= zbf and lK <= ztf
                    fvgZ3.preSpentState := fvgZ3.state
                    fvgZ3.state := 3
                    fvgZ3.stopK := k
                    array.set(fvgs, zf3, fvgZ3)
                    continue

            // CLOSE-THROUGH INVALIDATION: a candle's body closing all the way
            // through the gap's FAR edge (below zb for bullish, above zt for
            // bearish) -- checked independently of, and before, the
            // structural OFVG check below, per spec. Leads to the same
            // SPENT terminal state as an ordinary wick touch (a close-through
            // necessarily also touches the gap). Gated by eligibility, same
            // as impact/stranding -- a zone not yet watched isn't checked.
            if fvgZ3.state == 0 and fvgZ3.eligibleK != -1 and k >= fvgZ3.eligibleK
                cK = array.get(C_, k)
                closedThrough = bullf ? cK < zbf : cK > ztf
                if closedThrough
                    fvgZ3.preSpentState := fvgZ3.state
                    fvgZ3.state := 3
                    fvgZ3.stopK := k
                    array.set(fvgs, zf3, fvgZ3)
                    continue

            // STRANDING -> OFVG: mirrors IFOB's rule exactly (only one
            // creation type exists for FVG so far -- no AOB-style opposite
            // direction to choose between).
            if fvgZ3.state == 0 and fvgZ3.eligibleK != -1
                for e2 = evBeforeSwing to evTotal - 1
                    if e2 < 0 or e2 >= evTotal
                        continue
                    stEv = array.get(events, e2)
                    if stEv.confirmIdx != k
                        continue
                    strandedF = false
                    if bullf and stEv.kind == 1 and stEv.price > ztf
                        strandedF := true
                    if not bullf and stEv.kind == 0 and stEv.price < zbf
                        strandedF := true
                    if strandedF
                        fvgZ3.state := 2
                        array.set(fvgs, zf3, fvgZ3)
                        break

// ===================== DRAWING (last bar only) =====================
if barstate.islast
    // Delete previous drawings
    lblSzD = array.size(drawnLabels)
    for lb = 0 to lblSzD - 1
        if lb < 0 or lb >= lblSzD
            continue
        label.delete(array.get(drawnLabels, lb))
    array.clear(drawnLabels)
    boxSzD = array.size(drawnBoxes)
    for bx = 0 to boxSzD - 1
        if bx < 0 or bx >= boxSzD
            continue
        box.delete(array.get(drawnBoxes, bx))
    array.clear(drawnBoxes)
    lnSzD = array.size(drawnLines)
    for ln = 0 to lnSzD - 1
        if ln < 0 or ln >= lnSzD
            continue
        line.delete(array.get(drawnLines, ln))
    array.clear(drawnLines)

    nArr = array.size(O_)
    if nArr < 2
        runtime.error("Insufficient data")

    // Compute display-from time threshold (milliseconds)
    dispFrom = useDisplayFrom ? InpDisplayFrom : (time - InpMonthsBack * 30 * 24 * 60 * 60 * 1000)

    // OOB is never traded off 5m/1h/4h (see docs/trading_logic.md's cascade),
    // so its box is hidden on those chart timeframes only -- see OOB draw skip below.
    hideOOBHere = timeframe.period == "5" or timeframe.period == "60" or timeframe.period == "240"

    // --- Swing HIGHS: blue up arrow ---
    // Trim to the most recent InpMaxLabelsPerCategory before drawing -- swing
    // highs/lows/MSS all share Pine's single 500-label budget, and on noisy
    // timeframes (5m/1h) the raw count can blow past that, causing Pine to
    // silently auto-evict the OLDEST-created labels first. Since this loop
    // runs first (creating the oldest labels of the pass), swing highs were
    // the first to get silently wiped, then swing lows -- MSS (created last)
    // was never touched. Trimming ourselves, per category, in recency order
    // makes what's shown deterministic instead of leaving it to Pine's
    // creation-order eviction.
    shSz = array.size(swHighs)
    shStart = math.max(0, shSz - InpMaxLabelsPerCategory)
    for s = shStart to shSz - 1
        if s < 0 or s >= shSz
            continue
        idx = array.get(swHighs, s)
        if idx < 0 or idx >= nArr
            continue
        bt = array.get(BT, idx)
        if bt < dispFrom
            continue
        yP = array.get(H_, idx)
        lbl = label.new(bt, yP, "▲", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=color.blue, size=size.small)
        array.push(drawnLabels, lbl)

    // --- Swing LOWS: black down arrow ---
    slSz = array.size(swLows)
    slStart = math.max(0, slSz - InpMaxLabelsPerCategory)
    for s = slStart to slSz - 1
        if s < 0 or s >= slSz
            continue
        idx = array.get(swLows, s)
        if idx < 0 or idx >= nArr
            continue
        bt = array.get(BT, idx)
        if bt < dispFrom
            continue
        // Pushed slightly below the literal low (ATR-scaled, see
        // swLowGapOffset above) to match the small visual gap the swing-high
        // arrow already has above its high -- style_none appears to anchor
        // "▲" and "▼" differently even at the same yloc.price value, so this
        // nudges the low arrow to look the same way, not a change to the
        // detected swing-low price itself.
        yP = array.get(L_, idx) - swLowGapOffset
        lbl = label.new(bt, yP, "▼", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=color.black, size=size.small)
        array.push(drawnLabels, lbl)

    // --- MSS flips: cross mark at broken swing's location ---
    mssSz = array.size(msses)
    mssStart = math.max(0, mssSz - InpMaxLabelsPerCategory)
    for m = mssStart to mssSz - 1
        if m < 0 or m >= mssSz
            continue
        mEv = array.get(msses, m)
        bIdx = mEv.brokenIdx
        if bIdx < 0 or bIdx >= nArr
            continue
        bt = array.get(BT, bIdx)
        if bt < dispFrom
            continue
        isUp = mEv.toUp
        // Down-MSS shares the same swLowGapOffset nudge as the swing-low
        // arrow (both sit at a candle's low with the same style_none glyph-
        // anchor issue); up-MSS is left at the literal high, same as the
        // swing-high arrow.
        yP = isUp ? array.get(H_, bIdx) : array.get(L_, bIdx) - swLowGapOffset
        col = isUp ? color.blue : color.black
        lbl = label.new(bt, yP, "✕", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=col, size=size.small)
        array.push(drawnLabels, lbl)

    // --- OB zones: hollow boxes ---
    // IFOB bull=blue, IFOB bear=black, AOB=green, OOB=red, AIFOB=orange
    // SPENT uses preSpentState color
    obSzD = array.size(obs)
    extT = time + 50 * timeframe.in_seconds() * 1000

    for z = 0 to obSzD - 1
        if z < 0 or z >= obSzD
            continue
        obD = array.get(obs, z)
        idx = obD.candle
        if idx < 0 or idx >= nArr
            continue

        // Focus filter
        if InpFocusOB > 0
            if obSzD - z != InpFocusOB
                continue
        else
            bt = array.get(BT, idx)
            if bt < dispFrom
                continue

        leftT = array.get(BT, idx)
        rightT = extT
        if obD.stopK != -1 and obD.stopK < nArr
            rightT := array.get(BT, obD.stopK)

        // Color
        dSt = obD.state == 3 ? obD.preSpentState : obD.state
        // AIFOB display disabled by request -- creation/promotion/eligibility/
        // lifecycle logic above is untouched (a pending AIFOB still tracks its
        // armed swing and still promotes to a real IFOB, state 0, the same as
        // before); this only skips drawing a box for zones still classified
        // as AIFOB (dSt==4) whether live or SPENT-while-still-AIFOB. Once a
        // zone promotes to IFOB it draws normally again, unaffected.
        if dSt == 4
            continue
        // OOB display disabled by request on 5m/1h/4h -- never used at those
        // timeframes per the trading cascade (docs/trading_logic.md), so hide
        // the clutter there. Stranding detection/lifecycle above (a zone can
        // still go OOB and later flip to SPENT on touch) is untouched, and
        // OOB still draws normally on Daily/Weekly/Monthly/any other TF.
        if dSt == 2 and hideOOBHere
            continue
        col = color.blue
        if dSt == 0
            col := obD.bullish ? color.blue : color.black
        else if dSt == 1
            col := color.green
        else if dSt == 2
            col := color.red
        else if dSt == 4
            col := color.orange
        else
            col := obD.bullish ? color.blue : color.black

        bx = box.new(leftT, obD.zt, rightT, obD.zb, border_color=col, border_width=1, bgcolor=na, xloc=xloc.bar_time)
        array.push(drawnBoxes, bx)

    // --- IFVG zones: filled box (solid border) + gray dotted 50% midline ---
    // Live IFVG: bullish=blue, bearish=black. OFVG (and any SPENT zone whose
    // preSpentState was OFVG): red, same as OOB, but keeps its shading +
    // dotted midline so it's still visually distinct from a hollow OOB box.
    // OFVG's visibility also differs from a live zone (hidden on 5m/1h/4h,
    // same treatment as OOB, via hideOOBHere computed above). History capped
    // to the most recent InpMaxFvgPerCategory, same pattern as swings/MSS,
    // since "every qualifying gap in a leg counts" can produce far more
    // zones than OB's one-pick-per-leg ever does.
    fvgSzD = array.size(fvgs)
    fvgStart = math.max(0, fvgSzD - InpMaxFvgPerCategory)
    for zf = fvgStart to fvgSzD - 1
        if zf < 0 or zf >= fvgSzD
            continue
        fvD = array.get(fvgs, zf)
        idxF = fvD.leftIdx
        if idxF < 0 or idxF >= nArr
            continue

        btF = array.get(BT, idxF)
        if btF < dispFrom
            continue

        dStF = fvD.state == 3 ? fvD.preSpentState : fvD.state
        if dStF == 2 and hideOOBHere
            continue

        leftTF = btF
        rightTF = extT
        if fvD.stopK != -1 and fvD.stopK < nArr
            rightTF := array.get(BT, fvD.stopK)

        colF = dStF == 2 ? color.red : (fvD.bullish ? color.blue : color.black)

        bxF = box.new(leftTF, fvD.zt, rightTF, fvD.zb, border_color=colF, border_width=1,
                      bgcolor=color.new(colF, InpFvgFillTransparency), xloc=xloc.bar_time)
        array.push(drawnBoxes, bxF)

        midY = (fvD.zt + fvD.zb) / 2
        lnF = line.new(leftTF, midY, rightTF, midY, xloc=xloc.bar_time, color=color.gray,
                       style=line.style_dotted, width=1)
        array.push(drawnLines, lnF)
