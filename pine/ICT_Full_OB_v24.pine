//@version=6
// Port of ICT_Full_OB_v24.mq5 to Pine Script for TradingView.
// Ported by hand from the MQL5 state machine; not compiled/tested in the
// Pine Editor -- treat as a first draft and expect a small fix-up pass.
//
// Differences from the MQL5 version, by design:
// - Pine executes one bar at a time (oldest to newest), so the two-pass
//   MQL5 design (swing detection pass, then a second OB-engine pass with a
//   "peek-ahead" step) collapses into ONE per-bar pass here: swing
//   detection runs first, then immediately the OB engine consumes
//   whatever it just confirmed on the SAME bar. This is equivalent, not
//   an approximation.
// - Verbose PrintFormat/"HUNT"/"AUDIT" diagnostics from the MQL5 build
//   were debugging aids for that conversation and are omitted here.
// - Pine hard-caps boxes/labels/lines at 500 each. This script only
//   draws objects for OBs/swings/MSS whose own bar is at or after
//   displayFromInput, so keep that input reasonably close-in if your
//   history is long, or you may hit the cap on very old charts.

indicator("ICT Full OB v24 (Port)", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_bars_back = 5000)

// ============================== INPUTS ==============================
displayFromInput = input.time(timestamp("2025-07-25 00:00 +0000"), title = "Display From")
colHighSwing     = input.color(color.blue,   title = "Swing High Color")
colLowSwing      = input.color(color.black,  title = "Swing Low Color")
colMSSUp         = input.color(color.blue,   title = "MSS Up Color")
colMSSDown       = input.color(color.black,  title = "MSS Down Color")
colIFOBBull      = input.color(color.blue,   title = "IFOB Bullish Color")
colIFOBBear      = input.color(color.black,  title = "IFOB Bearish Color")
colAOB           = input.color(color.green,  title = "AOB Color")
colOOB           = input.color(color.red,    title = "OOB Color")

// ============================== TYPES ==============================
// state: 0=IFOB, 1=AOB, 2=OOB, 3=SPENT (AIFOB/state 4 removed -- see
// REMOVED FEATURE comment below the AOB hunts)
type ObZone
    int   candleIdx
    int   candleTime  // time of candleIdx's bar, captured at creation (when
                       // the historical offset is still small/safe) so the
                       // draw loop never needs a large-offset [] lookup later
    float zb
    float zt
    bool  bullish
    int   triggerK
    int   eligibleK
    int   stopK
    int   stopTime  // time of stopK's bar, captured at the moment it's set
                     // (offset 0, always safe) so the draw loop's box
                     // right-edge never needs a large-offset [] lookup either
    int   state
    int   origState
    int   preSpentState
    int   lastDrawnState  // state at the last box redraw, -1 = never drawn;
                           // lets the draw loop stop touching a zone's box
                           // once it's no longer changing (see DRAW section)
    box   zoneBox

// ============================== STATE ==============================
var array<ObZone> obList  = array.new<ObZone>()
// Indices into obList that still need per-bar attention (eligibility,
// lifecycle/stranding, touch, redraw). Every zone starts here at creation;
// pruned once SPENT(3) -- the only truly terminal state (OOB zones stay in
// this list forever since they can still get touched and flip to SPENT
// later, per the spec). Without this, the STEP2/STEP3/DRAW loops below
// would rescan the FULL history of every zone ever created on every single
// bar, which is what actually blew Pine's 500ms-per-bar budget on a 1H
// chart loaded with a lot of history (RE10022) -- unrelated to AIFOB,
// this would have hit the same wall with AIFOB still in place too, just
// at a larger history size.
var array<int>     liveIdx = array.new_int()

// swing-detection running trackers (mirror MQL5's peakIdx/troughIdx, with
// their price shadowed alongside so H[peakIdx]/L[troughIdx] never need a
// separate historical lookup)
var int   peakIdx   = 0
var float peakH     = na
var int   troughIdx = 0
var float troughL   = na

// confirmed-event log (mirrors g_ev[]: kind 0=high, 1=low)
var array<int>   evConfirmIdx = array.new_int()
var array<int>   evKind       = array.new_int()
var array<int>   evSwingIdx   = array.new_int()
var array<float> evPrice      = array.new_float()

// regime / OB engine trackers
var bool  haveSWH    = false
var float swhPrice   = na
var int   swhIdx     = 0
var bool  haveSWL    = false
var float swlPrice   = na
var int   swlIdx     = 0
var int   regime     = 0     // 0 warmup, 1 up, 2 down
var int   lastSWHidx = -1
var int   lastSWLidx = -1

// ============================== HELPERS ==============================
barTimeAt(idx) => time[bar_index - idx]

f_addEv(confirmIdx, kind, swingIdx, price) =>
    array.push(evConfirmIdx, confirmIdx)
    array.push(evKind, kind)
    array.push(evSwingIdx, swingIdx)
    array.push(evPrice, price)

// rank by body extremity (close), not wick -- zones are drawn open-to-close
f_pickLowestBearish(lo, hi) =>
    int best = -1
    float bestClose = na
    if hi >= lo
        for x = lo to hi
            offs = bar_index - x
            if close[offs] < open[offs] and (best == -1 or close[offs] < bestClose)
                best := x
                bestClose := close[offs]
    best

f_pickHighestBullish(lo, hi) =>
    int best = -1
    float bestClose = na
    if hi >= lo
        for x = lo to hi
            offs = bar_index - x
            if close[offs] > open[offs] and (best == -1 or close[offs] > bestClose)
                best := x
                bestClose := close[offs]
    best

f_addOB(candleIdx, zb, zt, bullish, triggerK, st) =>
    int elig = (st == 1) ? triggerK : -1
    int cTime = time[bar_index - candleIdx]
    z = ObZone.new(candleIdx = candleIdx, candleTime = cTime, zb = zb, zt = zt, bullish = bullish, triggerK = triggerK,
                   eligibleK = elig, stopK = -1, stopTime = na, state = st, origState = st, preSpentState = st,
                   lastDrawnState = -1, zoneBox = na)
    array.push(obList, z)
    newIdx = array.size(obList) - 1
    array.push(liveIdx, newIdx)
    newIdx

// AOB hunts -- must run regardless of the confirming candle's own body
// direction (both are called from all four MID-ARM sites below).
f_tryBullishAOB(prevRegime, aobSWHidx, newSwlIdx, newSwlPrice) =>
    int result = -1
    if prevRegime == 1 and aobSWHidx >= 0
        lo = math.max(0, math.min(aobSWHidx - 1, newSwlIdx))
        hi = math.max(aobSWHidx - 1, newSwlIdx)
        best = f_pickHighestBullish(lo, hi)
        if best != -1
            offs = bar_index - best
            if low[offs] > newSwlPrice
                result := f_addOB(best, math.min(open[offs], close[offs]), math.max(open[offs], close[offs]), true, bar_index, 1)
    result

f_tryBearishAOB(prevRegime, aobSWLidx, newSwhIdx, newSwhPrice) =>
    int result = -1
    if prevRegime == 2 and aobSWLidx >= 0
        lo = math.max(0, math.min(aobSWLidx - 1, newSwhIdx))
        hi = math.max(aobSWLidx - 1, newSwhIdx)
        best = f_pickLowestBearish(lo, hi)
        if best != -1
            offs = bar_index - best
            if high[offs] < newSwhPrice
                result := f_addOB(best, math.min(open[offs], close[offs]), math.max(open[offs], close[offs]), false, bar_index, 1)
    result

// ============================================================================
// REMOVED FEATURE -- AIFOB (state 4), removed at the user's request. Kept
// here as a reference writeup, not code, in case this needs reimplementing.
//
// Concept: an IFOB created EARLY -- before the swing it depends on has
// actually been exceeded -- because the opposite (retracement) swing
// already confirmed while the engine was still waiting for that exceedance.
//
// Creation rule (former f_tryBullishAIFOB/f_tryBearishAIFOB, called from
// the swing-confirm MID-ARM branch alongside f_tryBullish/BearishAOB
// whenever the AOB path did NOT already fire): same range/pick rule as a
// real IFOB (strongest opposite-color body in the range), where the range
// was [min(lastOppositeSwingIdx, newRetracementSwingIdx) .. armedSwingIdx - 1],
// gated on: previous regime already established in the target direction,
// the armed swing (haveSWH_/haveSWL_) actually existing, and
// lastSWLidx_/lastSWHidx_ >= 0.
//
// Promotion rule (former pendingBullAifobIdx/pendingBearAifobIdx trackers):
// when the armed swing DID later get exceeded (the normal IFOB-creation
// branch), if a pending AIFOB index was recorded, that zone's state/
// origState were flipped from 4 to 0 in place (promoted to a real IFOB,
// not duplicated) instead of running the normal candle-pick logic again.
//
// Supersession rule: each time a FRESH swing of either kind confirmed
// before that promotion happened, the pending index for the opposite AIFOB
// slot was cleared (set to -1) -- i.e. a fresher swing invalidates a stale
// pending AIFOB and the zone just continues on as a normal (unpromoted)
// AIFOB from then on.
// ============================================================================

// ============================== SWING DETECTION (this bar) ==============================
evCountBefore = array.size(evKind)

if bar_index == 0
    peakIdx := 0
    peakH := high
    troughIdx := 0
    troughL := low
else
    bool bullishBar     = close >= open
    bool breaksPrevHigh = high > high[1]
    bool breaksPrevLow  = low  < low[1]
    bool dualAction     = breaksPrevHigh and breaksPrevLow

    bool prevDual = false
    if array.size(evKind) >= 2
        n1 = array.size(evKind) - 1
        n2 = array.size(evKind) - 2
        bool diffKinds     = array.get(evKind, n1) != array.get(evKind, n2)
        bool sameConfirm   = array.get(evConfirmIdx, n1) == array.get(evConfirmIdx, n2)
        bool wasLastCandle = array.get(evConfirmIdx, n1) == bar_index - 1
        prevDual := diffKinds and sameConfirm and wasLastCandle
    bool blockPostDual = prevDual and not dualAction

    if not bullishBar
        // BEARISH: high reached first, then low
        if high > peakH
            peakIdx := bar_index
            peakH := high
        if breaksPrevHigh
            bool lastWasLow = array.size(evKind) > 0 and array.get(evKind, array.size(evKind) - 1) == 1
            if not lastWasLow and not blockPostDual
                f_addEv(bar_index, 1, troughIdx, troughL)
                peakIdx := bar_index
                peakH := high
        if low < troughL
            troughIdx := bar_index
            troughL := low
        if breaksPrevLow
            bool lastWasHigh = array.size(evKind) > 0 and array.get(evKind, array.size(evKind) - 1) == 0
            if not lastWasHigh and not blockPostDual
                f_addEv(bar_index, 0, peakIdx, peakH)
                troughIdx := bar_index
                troughL := low
    else
        // BULLISH: low reached first, then high
        if low < troughL
            troughIdx := bar_index
            troughL := low
        if breaksPrevLow
            bool lastWasHigh = array.size(evKind) > 0 and array.get(evKind, array.size(evKind) - 1) == 0
            if not lastWasHigh and not blockPostDual
                f_addEv(bar_index, 0, peakIdx, peakH)
                troughIdx := bar_index
                troughL := low
        if high > peakH
            peakIdx := bar_index
            peakH := high
        if breaksPrevHigh
            bool lastWasLow = array.size(evKind) > 0 and array.get(evKind, array.size(evKind) - 1) == 1
            if not lastWasLow and not blockPostDual
                f_addEv(bar_index, 1, troughIdx, troughL)
                peakIdx := bar_index
                peakH := high

evCountAfter = array.size(evKind)

// draw newly confirmed swing points
if evCountAfter > evCountBefore
    for idx = evCountBefore to evCountAfter - 1
        kind  = array.get(evKind, idx)
        sIdx  = array.get(evSwingIdx, idx)
        pr    = array.get(evPrice, idx)
        if barTimeAt(sIdx) >= displayFromInput
            if kind == 0
                label.new(x = sIdx, y = pr, style = label.style_arrowup, color = colHighSwing, size = size.tiny)
            else
                label.new(x = sIdx, y = pr, style = label.style_arrowdown, color = colLowSwing, size = size.tiny)

// ============================== REGIME / OB ENGINE (this bar) ==============================
// STEP 0: peek-ahead -- update lastSWHidx/lastSWLidx from events confirmed
// THIS bar, before break checks run.
if evCountAfter > evCountBefore
    for idx = evCountBefore to evCountAfter - 1
        if array.get(evKind, idx) == 0
            lastSWHidx := array.get(evSwingIdx, idx)
        else
            lastSWLidx := array.get(evSwingIdx, idx)

prevRegime = regime
bool swhConsumed = false
bool swlConsumed = false
aobSWHidx = swhIdx   // save armed indices before this bar's changes
aobSWLidx = swlIdx

bool kBullish = close >= open

if not kBullish
    // bearish: high happened first -> check the armed SWH break first
    if haveSWH and high > swhPrice
        if regime == 0
            regime := 1
        else if regime == 2
            regime := 1
            if barTimeAt(swhIdx) >= displayFromInput
                label.new(x = swhIdx, y = swhPrice, style = label.style_xcross, color = colMSSUp, size = size.tiny)
        if lastSWLidx >= 0
            lo = math.min(math.min(lastSWLidx, bar_index), swhIdx)
            hi = math.max(math.max(lastSWLidx, bar_index), swhIdx)
            best = f_pickLowestBearish(lo, hi)
            if best != -1
                offs = bar_index - best
                f_addOB(best, math.min(open[offs], close[offs]), math.max(open[offs], close[offs]), true, bar_index, 0)
        haveSWH := false
        swhConsumed := true

    // MID-ARM: process this bar's new events, create AOBs
    if evCountAfter > evCountBefore
        for idx = evCountBefore to evCountAfter - 1
            kind = array.get(evKind, idx)
            sIdx = array.get(evSwingIdx, idx)
            pr   = array.get(evPrice, idx)
            if kind == 0
                haveSWH := true
                swhPrice := pr
                swhIdx := sIdx
                f_tryBearishAOB(prevRegime, aobSWLidx, sIdx, pr)
            else
                haveSWL := true
                swlPrice := pr
                swlIdx := sIdx
                f_tryBullishAOB(prevRegime, aobSWHidx, sIdx, pr)

    if haveSWL and low < swlPrice
        if regime == 0
            regime := 2
        else if regime == 1
            regime := 2
            if barTimeAt(swlIdx) >= displayFromInput
                label.new(x = swlIdx, y = swlPrice, style = label.style_xcross, color = colMSSDown, size = size.tiny)
        if lastSWHidx >= 0
            lo = math.min(math.min(lastSWHidx, bar_index), swlIdx)
            hi = math.max(math.max(lastSWHidx, bar_index), swlIdx)
            best = f_pickHighestBullish(lo, hi)
            if best != -1
                offs = bar_index - best
                f_addOB(best, math.min(open[offs], close[offs]), math.max(open[offs], close[offs]), false, bar_index, 0)
        haveSWL := false
        swlConsumed := true
else
    // bullish: low happened first -> check the armed SWL break first
    if haveSWL and low < swlPrice
        if regime == 0
            regime := 2
        else if regime == 1
            regime := 2
            if barTimeAt(swlIdx) >= displayFromInput
                label.new(x = swlIdx, y = swlPrice, style = label.style_xcross, color = colMSSDown, size = size.tiny)
        if lastSWHidx >= 0
            lo = math.min(math.min(lastSWHidx, bar_index), swlIdx)
            hi = math.max(math.max(lastSWHidx, bar_index), swlIdx)
            best = f_pickHighestBullish(lo, hi)
            if best != -1
                offs = bar_index - best
                f_addOB(best, math.min(open[offs], close[offs]), math.max(open[offs], close[offs]), false, bar_index, 0)
        haveSWL := false
        swlConsumed := true

    // MID-ARM: process this bar's new events, create AOBs
    if evCountAfter > evCountBefore
        for idx = evCountBefore to evCountAfter - 1
            kind = array.get(evKind, idx)
            sIdx = array.get(evSwingIdx, idx)
            pr   = array.get(evPrice, idx)
            if kind == 0
                haveSWH := true
                swhPrice := pr
                swhIdx := sIdx
                f_tryBearishAOB(prevRegime, aobSWLidx, sIdx, pr)
            else
                haveSWL := true
                swlPrice := pr
                swlIdx := sIdx
                f_tryBullishAOB(prevRegime, aobSWHidx, sIdx, pr)

    if haveSWH and high > swhPrice
        if regime == 0
            regime := 1
        else if regime == 2
            regime := 1
            if barTimeAt(swhIdx) >= displayFromInput
                label.new(x = swhIdx, y = swhPrice, style = label.style_xcross, color = colMSSUp, size = size.tiny)
        if lastSWLidx >= 0
            lo = math.min(math.min(lastSWLidx, bar_index), swhIdx)
            hi = math.max(math.max(lastSWLidx, bar_index), swhIdx)
            best = f_pickLowestBearish(lo, hi)
            if best != -1
                offs = bar_index - best
                f_addOB(best, math.min(open[offs], close[offs]), math.max(open[offs], close[offs]), true, bar_index, 0)
        haveSWH := false
        swhConsumed := true

// STEP 2: arm swings (redundant with MID-ARM except for the *Consumed guard
// and eligibility-granting) + IFOB eligibility
if evCountAfter > evCountBefore
    for idx = evCountBefore to evCountAfter - 1
        kind = array.get(evKind, idx)
        sIdx = array.get(evSwingIdx, idx)
        pr   = array.get(evPrice, idx)
        if kind == 0
            if not swhConsumed
                haveSWH := true
                swhPrice := pr
                swhIdx := sIdx
            lastSWHidx := sIdx
            if array.size(liveIdx) > 0
                for li = 0 to array.size(liveIdx) - 1
                    zone = array.get(obList, array.get(liveIdx, li))
                    if zone.bullish and zone.state == 0 and zone.eligibleK == -1 and bar_index > zone.triggerK
                        zone.eligibleK := bar_index
        else
            if not swlConsumed
                haveSWL := true
                swlPrice := pr
                swlIdx := sIdx
            lastSWLidx := sIdx
            if array.size(liveIdx) > 0
                for li = 0 to array.size(liveIdx) - 1
                    zone = array.get(obList, array.get(liveIdx, li))
                    if (not zone.bullish) and zone.state == 0 and zone.eligibleK == -1 and bar_index > zone.triggerK
                        zone.eligibleK := bar_index

// STEP 3: OB lifecycle at this bar
if array.size(liveIdx) > 0
    for li = 0 to array.size(liveIdx) - 1
        zone = array.get(obList, array.get(liveIdx, li))
        if zone.state != 3
            zb = zone.zb
            zt = zone.zt
            bull = zone.bullish
            bool impacted = false

            // IMPACT: first touch after eligible -> SPENT
            if zone.eligibleK != -1 and bar_index >= zone.eligibleK
                if high >= zb and low <= zt
                    zone.preSpentState := zone.state
                    zone.state := 3
                    zone.stopK := bar_index
                    zone.stopTime := time
                    impacted := true

            // STRANDING -> OLD: which swing proves it depends on which leg the
            // zone was built from (IFOB = breakout leg, mirrored direction;
            // AOB = retracement leg, opposite mirrored direction).
            if (not impacted) and (zone.state == 0 or zone.state == 1) and zone.eligibleK != -1
                bool isIFOB = zone.origState != 1
                if evCountAfter > evCountBefore
                    for idx = evCountBefore to evCountAfter - 1
                        kind = array.get(evKind, idx)
                        pr   = array.get(evPrice, idx)
                        if isIFOB
                            if bull and kind == 1 and pr > zt
                                zone.state := 2
                            if (not bull) and kind == 0 and pr < zb
                                zone.state := 2
                        else
                            if bull and kind == 0 and pr < zb
                                zone.state := 2
                            if (not bull) and kind == 1 and pr > zt
                                zone.state := 2

// ============================== DRAW / UPDATE OB BOXES ==============================
if array.size(liveIdx) > 0
    for li = 0 to array.size(liveIdx) - 1
        zone = array.get(obList, array.get(liveIdx, li))
        // Once a zone stops changing (no longer IFOB/AOB/OOB -- i.e. it's
        // SPENT) its box only needs ONE more redraw to catch that final
        // state -- not one every bar forever. lastDrawnState != zone.state
        // catches exactly that one transition, then skips it on every bar
        // after. OOB(2) must stay in "still live" here too: an unimpacted
        // OOB zone stays in liveIdx precisely because it can still be
        // touched and flip to SPENT later (see the liveIdx comment above),
        // so its box needs to keep extending to the current bar every bar
        // until that happens -- excluding it here was the bug (it made
        // OOB boxes freeze at the exact bar they turned OOB instead of
        // extending, since lastDrawnState == state on every bar after that
        // single post-transition redraw).
        bool stillLive = zone.state == 0 or zone.state == 1 or zone.state == 2
        if zone.candleTime >= displayFromInput and (stillLive or zone.lastDrawnState != zone.state)
            int drawState = zone.state == 3 ? zone.preSpentState : zone.state
            color col = zone.bullish ? colIFOBBull : colIFOBBear
            if drawState == 1
                col := colAOB
            else if drawState == 2
                col := colOOB
            // Time-based addressing (xloc.bar_time), not bar-index: a zone's
            // origin candle can end up far enough in the past (e.g. picked
            // from a long-armed swing's full range once it finally resolves)
            // that box.new()'s bar-index `left` argument errors out ("too
            // far from the current bar index") on intraday charts with a
            // lot of loaded history. Time values have no such distance cap.
            int rightEdgeTime = not na(zone.stopTime) ? zone.stopTime : time
            if na(zone.zoneBox)
                zone.zoneBox := box.new(left = zone.candleTime, top = zone.zt, bottom = zone.zb, right = rightEdgeTime,
                                         xloc = xloc.bar_time, border_color = col, bgcolor = na, border_width = 1)
            else
                box.set_right(zone.zoneBox, rightEdgeTime)
                box.set_border_color(zone.zoneBox, col)
            zone.lastDrawnState := zone.state

// Prune SPENT(3) zones out of liveIdx now that they've had their final
// redraw above -- they need no further eligibility/lifecycle/touch/draw
// attention ever again. Walked backward so removal never shifts an
// index still to be visited. OOB(2) zones deliberately stay in liveIdx:
// per the spec they can still be touched and flip to SPENT later.
if array.size(liveIdx) > 0
    for li = array.size(liveIdx) - 1 to 0
        if array.get(obList, array.get(liveIdx, li)).state == 3
            array.remove(liveIdx, li)
