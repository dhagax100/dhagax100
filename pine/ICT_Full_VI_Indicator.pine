// ICT_Full_VI_Indicator — Pine Script v5
// Standalone VI-only companion to ICT_Full_OB_v24 and ICT_Full_FVG_Indicator:
// draws swing highs, swing lows, MSS flips, IVI (continuation-only Volume
// Imbalance) and AVI (Anticipatory VI, mirrors AOB/AFVG) using the identical
// swing/MSS engine as the other three scripts. No OB, no FVG -- VI-only, by
// design, same reasoning as the FVG-only split (see below).
//
// What a Volume Imbalance is, and how it differs from an FVG: an FVG is a
// 3-candle gap (candle1 vs candle3, candle2 is the impulse in between). A
// VI is the 2-candle version -- between candle1's CLOSE and candle2's OPEN,
// not wicks. If candle2 opens away from where candle1 closed, that gap
// (the space between close[1] and open[2]) never traded during the session
// transition -- that's the "volume imbalance." Bullish VI = open[2] above
// close[1] (price gapped up between the two). Bearish VI = open[2] below
// close[1] (gapped down).
//
// Design choices confirmed with the user before writing this (so a future
// session doesn't need to re-derive them):
// - Zone boundary: close[1]/open[2], NOT wicks. This is what makes a VI a
//   VI instead of just a smaller FVG.
// - IVI naming: shape-based, matching IFVG exactly -- rising gap (close[1]
//   < open[2]) = bullish, falling gap (close[1] > open[2]) = bearish,
//   regardless of which hunt found it.
// - AVI naming: hunt-direction-based, matching AFVG/AOB exactly -- tagged
//   by which trade it sets up (buy zone found during an uptrend's
//   down-pullback = bullish), not by the raw shape of the two candles.
// - AVI's near-side straddle guard still checks WICKS (high/low) of both
//   candles against the guard price, not close/open -- the guard's job is
//   "has price already traded past this level," which is a wick question
//   regardless of what defines the zone's own boundary. Flagged for the
//   user to confirm this is what they want; easy to switch to close/open
//   if not.
//
// Lessons from the FVG/RB build applied here from day one, instead of
// found later the hard way:
// - The dual-action-candle swing-detection bug (OB commit 4401edd, later
//   found again in RB and FVG) is fixed from the start -- never had the
//   old blanket blockPD version.
// - CLOSE-THROUGH invalidation is IVI-only (origin 0) from the start --
//   AVI zones start already on the far side of price by design (waiting
//   for a later return visit), so that check would kill them on day one
//   of eligibility if applied. This was FVG issue 2's whole bug; AVI never
//   gets it in the first place here.
// - liveIdx/pendingEligIdx perf lists are in from the start, not
//   retrofitted after hitting the 20s script-execution limit.
// - Same standalone, cost-bounded debug-label tool as the finalized FVG
//   file (InpDebugValues + a date picker, one label max, not per-zone).
//
// Why this is a separate script, same reasoning as the FVG split: Daily
// bars go back decades, and any picking/scanning loop that runs once per
// exceedance event across the whole loaded history adds up past
// TradingView's 20s limit (RE10110) if it's bundled with everything else.
// Splitting VI out lets it run standalone on Daily without that risk, and
// keeps this file simple enough to verify against real chart data one
// concept at a time -- same process FVG and RB went through.
//@version=5
indicator("ICT Full VI Indicator", overlay=true, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)

// ===================== INPUTS =====================
InpMonthsBack  = input.int(6, "Months to display")
InpDisplayFrom = input.time(timestamp("2025-07-25"), "Display from date")
useDisplayFrom = input.bool(true, "Use exact display-from date (else use months)")
InpReplayUpTo  = input.time(0, "Replay up to date (0=show all)")
useReplay      = input.bool(false, "Enable replay mode")
InpMaxLabelsPerCategory = input.int(150, "Max swing-high / swing-low / MSS labels shown (each, most recent kept)", minval=1, maxval=160)
InpSwingLowGapATR = input.float(0.08, "Swing-low arrow / down-MSS gap below the low (x ATR14)", minval=0.0)
InpMaxViPerCategory = input.int(150, "Max IVI / AVI boxes shown (each category, most recent by chart date)", minval=1, maxval=160)
InpViFillTransparency = input.int(85, "IVI fill transparency % (0=solid, 100=invisible)", minval=0, maxval=100)
InpDebugValues = input.bool(false, "Show debug labels on VI zones (state/origin/trigger/eligible/stop)")
InpFocusViDate = input.time(timestamp("2025-07-31"), "Debug label: only show for the VI zone whose leftIdx candle is nearest this date")

// ===================== TYPE DEFINITIONS =====================
type SwEv
    int   confirmIdx
    int   kind         // 0=high, 1=low
    int   swingIdx
    float price

type MssEv
    int   atIdx
    int   brokenIdx
    float price
    bool  toUp

type ViZone
    int   leftIdx        // candle1 of the 2-candle gap (left edge of the box)
    float zb
    float zt
    bool  bullish
    int   triggerK       // the leg's breakout candle (IVI) or AOB-hunt
                          // trigger candle (AVI)
    int   eligibleK      // -1 = not yet eligible. Delayed for IVI (mirrors
                          // IFOB); immediate (= triggerK) for AVI (mirrors AOB)
    int   stopK          // -1 = extending
    int   state          // 0=IVI, 1=AVI, 2=OVI, 3=SPENT
    int   origin         // permanent creation-type marker, never changes
                          // after creation: 0=IVI-style (far-side stranding),
                          // 1=AVI-style (near-side stranding) -- decides
                          // which stranding rule applies even after state
                          // moves on to 2/3
    int   preSpentState

// ===================== PERSISTENT STATE =====================
var events     = array.new<SwEv>()
var msses      = array.new<MssEv>()
var vis        = array.new<ViZone>()
var swHighs    = array.new<int>()
var swLows     = array.new<int>()

// Small "still needs checking" index lists into vis -- see STEP 2 / STEP 3
// below. Built in from the start (FVG needed a real 20s-timeout bug to
// discover why this matters; not repeating that here).
var liveIdx        = array.new<int>()   // zones not yet SPENT (state != 3)
var pendingEligIdx = array.new<int>()   // zones still waiting on eligibility

// OHLC + time storage (absolute indexing, oldest=0)
var O_ = array.new<float>()
var H_ = array.new<float>()
var L_ = array.new<float>()
var C_ = array.new<float>()
var BI = array.new<int>()      // bar_index of each bar
var BT = array.new<int>()      // bar time (ms) of each bar

// Swing detection trackers
var int peakIdx_   = 0
var int troughIdx_ = 0

// Regime / MSS trackers
var bool  haveSWH   = false
var float swhPrice  = 0.0
var int   swhIdx    = 0
var bool  haveSWL   = false
var float swlPrice  = 0.0
var int   swlIdx    = 0
var int   regime    = 0      // 0=warmup, 1=up, 2=down
var int   ei        = 0      // event pointer
var int   lastSWHidx = -1
var int   lastSWLidx = -1
var int   viBullScanUpto = -1   // last bar index whose bullish 2-candle window was checked for a gap
var int   viBearScanUpto = -1   // same, bearish side

// Guard: process each bar exactly once
var int lastProcessedBI = -1

// Drawing object arrays (for cleanup on redraw)
var drawnLabels = array.new<label>()
var drawnBoxes  = array.new<box>()
var drawnLines  = array.new<line>()   // IVI 50% midpoint lines

// Replay gate
replayActive = useReplay and InpReplayUpTo > 0
skipBar = replayActive and time > InpReplayUpTo

// ATR-scaled visual gap for the swing-low arrow (see DRAWING section) --
// computed unconditionally every bar like any other ta.* series.
swLowGapOffset = ta.atr(14) * InpSwingLowGapATR

// ===================== HELPER FUNCTIONS =====================
addSH(int idx) =>
    sz = array.size(swHighs)
    doPush = sz == 0
    if not doPush
        doPush := array.get(swHighs, sz - 1) != idx
    if doPush
        array.push(swHighs, idx)

addSL(int idx) =>
    sz = array.size(swLows)
    doPush = sz == 0
    if not doPush
        doPush := array.get(swLows, sz - 1) != idx
    if doPush
        array.push(swLows, idx)

addEv(int cIdx, int kind, int sIdx, float pr) =>
    array.push(events, SwEv.new(cIdx, kind, sIdx, pr))

addMss(int aIdx, int bIdx, float pr, bool up) =>
    array.push(msses, MssEv.new(aIdx, bIdx, pr, up))

addVI(int leftIdx, float zb, float zt, bool bull, int tK, int st) =>
    // st: 0=IVI (delayed eligibility, far-side stranding later), 1=AVI
    // (immediate eligibility, near-side stranding later) -- mirrors
    // addFVG's st param one-for-one; origin is stamped once, forever.
    eK = (st == 1) ? tK : -1
    array.push(vis, ViZone.new(leftIdx, zb, zt, bull, tK, eK, -1, st, st, st))
    // Track the new zone in the small index lists instead of relying on
    // full rescans of vis -- keeps per-bar work bounded from day one.
    newViIdx = array.size(vis) - 1
    array.push(liveIdx, newViIdx)
    if eK == -1
        array.push(pendingEligIdx, newViIdx)

// Scans [lo,hi] for EVERY qualifying 2-candle gap (not just one). Called
// at each break-check site, using the same lo/hi/direction/triggerK an
// IFOB-equivalent break would use. Shape-based: the "bullish" param IS the
// raw gap shape here (matches IFVG's own convention), not hunt intent.
tryCreateIVIs(int lo, int hi, bool bullish, int triggerK) =>
    if hi >= lo + 1
        for c2 = lo + 1 to hi
            c1 = c2 - 1
            cl1 = array.get(C_, c1)
            op2 = array.get(O_, c2)
            if bullish
                if cl1 < op2
                    addVI(c1, cl1, op2, true, triggerK, 0)
            else
                if cl1 > op2
                    addVI(c1, op2, cl1, false, triggerK, 0)

// Scans [lo,hi] -- the SAME range an AOB/AFVG is picked/scanned from --
// for EVERY qualifying 2-candle gap left by the retracement leg ITSELF
// continuing in its own direction. A bullish hunt (uptrend, down-pullback)
// scans for the falling-shape gap (close[c1] > open[c2]) that an ordinary
// down-leg leaves behind; a bearish hunt (downtrend, up-pullback) scans
// for the rising-shape gap (close[c1] < open[c2]). Classified by hunt
// direction (bull hunt -> bullish zone), same as AFVG -- the zone's job
// downstream is about the trend being hunted, not the raw candle shape.
// Guard checks WICKS of both candles against guardPrice (see file header
// for why wicks, not close/open, even though the zone itself is
// close/open) -- either edge candle's wick already reaching the guard
// price disqualifies the gap, same straddle logic as AFVG's guard.
tryCreateAVIs(int lo, int hi, bool bullish, int triggerK, float guardPrice) =>
    if hi >= lo + 1
        for c2 = lo + 1 to hi
            c1 = c2 - 1
            cl1 = array.get(C_, c1)
            op2 = array.get(O_, c2)
            if bullish
                if cl1 > op2
                    l1 = array.get(L_, c1)
                    l2 = array.get(L_, c2)
                    if l1 > guardPrice and l2 > guardPrice
                        addVI(c1, op2, cl1, true, triggerK, 1)
            else
                if cl1 < op2
                    h1 = array.get(H_, c1)
                    h2 = array.get(H_, c2)
                    if h1 < guardPrice and h2 < guardPrice
                        addVI(c1, cl1, op2, false, triggerK, 1)

// --- AVI HUNT: Bullish -- mirrors tryBullAFVG's range + reference-
// validity gate one-for-one. Range upper bound extends one candle past
// newSwlI when it's safe to: the 2-candle gap's closing candle (c2) very
// often sits right after the swing point itself, same reasoning as
// AFVG's fix (commit b4b13d9/d99a0de) -- built in here from the start
// instead of needing to be rediscovered.
tryBullAVI(int pReg, int aobSWHi, int newSwlI, float newSwlP, int k) =>
    if pReg == 1 and aobSWHi >= 0
        armedSwhPrice = array.get(H_, aobSWHi)
        refViolated = false
        for v = aobSWHi + 1 to newSwlI
            if array.get(H_, v) >= armedSwhPrice
                refViolated := true
        if not refViolated
            swlExt = (newSwlI + 1) <= (k - 1) ? newSwlI + 1 : newSwlI
            lo2 = math.max(0, math.min(aobSWHi - 1, swlExt))
            hi2 = math.max(aobSWHi - 1, swlExt)
            tryCreateAVIs(lo2, hi2, true, k, newSwlP)

// --- AVI HUNT: Bearish -- mirrors tryBearAFVG --- (same reasoning as
// tryBullAVI above, mirrored for the swing-high pivot.)
tryBearAVI(int pReg, int aobSWLi, int newSwhI, float newSwhP, int k) =>
    if pReg == 2 and aobSWLi >= 0
        armedSwlPrice = array.get(L_, aobSWLi)
        refViolated = false
        for v = aobSWLi + 1 to newSwhI
            if array.get(L_, v) <= armedSwlPrice
                refViolated := true
        if not refViolated
            swhExt = (newSwhI + 1) <= (k - 1) ? newSwhI + 1 : newSwhI
            lo2 = math.max(0, math.min(aobSWLi - 1, swhExt))
            hi2 = math.max(aobSWLi - 1, swhExt)
            tryCreateAVIs(lo2, hi2, false, k, newSwhP)

// ===================== MAIN PROCESSING =====================
// Process each bar exactly once
if not skipBar and bar_index != lastProcessedBI
    lastProcessedBI := bar_index

    // Push current bar data
    array.push(O_, open)
    array.push(H_, high)
    array.push(L_, low)
    array.push(C_, close)
    array.push(BI, bar_index)
    array.push(BT, int(time))

    n = array.size(O_)
    if n >= 2
        i = n - 1    // current bar index in our arrays

        // ========== SWING DETECTION ==========
        isBull   = array.get(C_, i) >= array.get(O_, i)
        brkH     = array.get(H_, i) > array.get(H_, i - 1)
        brkL     = array.get(L_, i) < array.get(L_, i - 1)
        dualAct  = brkH and brkL

        // prevDual: the previous candle confirmed BOTH a swing high and a
        // swing low in one bar (a dual-action/outside-bar candle). We keep
        // the (kind, swingIdx) of BOTH of those events -- not just a plain
        // yes/no flag -- so we can tell a genuine duplicate (this candle
        // re-confirming the EXACT same point again) apart from a totally
        // different, legitimate confirmation that just happens to land the
        // bar right after a dual-action candle. Same fix as OB (4401edd),
        // RB, and FVG -- built in here from day one.
        prevDual = false
        pdKind1 = -1
        pdIdx1 = -1
        pdKind2 = -1
        pdIdx2 = -1
        eCnt = array.size(events)
        if eCnt >= 2
            ev1 = array.get(events, eCnt - 1)
            ev2 = array.get(events, eCnt - 2)
            if (ev1.kind != ev2.kind) and (ev1.confirmIdx == ev2.confirmIdx) and (ev1.confirmIdx == i - 1)
                prevDual := true
                pdKind1 := ev1.kind
                pdIdx1 := ev1.swingIdx
                pdKind2 := ev2.kind
                pdIdx2 := ev2.swingIdx

        evBeforeSwing = array.size(events)

        if not isBull
            // BEARISH: High first, then Low
            if array.get(H_, i) > array.get(H_, peakIdx_)
                peakIdx_ := i
            if brkH
                lk = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                blockDup = prevDual and not dualAct and ((pdKind1 == 1 and pdIdx1 == troughIdx_) or (pdKind2 == 1 and pdIdx2 == troughIdx_))
                if lk != 1 and not blockDup
                    addSL(troughIdx_)
                    addEv(i, 1, troughIdx_, array.get(L_, troughIdx_))
                    peakIdx_ := i
            if array.get(L_, i) < array.get(L_, troughIdx_)
                troughIdx_ := i
            if brkL
                lk2 = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                blockDup2 = prevDual and not dualAct and ((pdKind1 == 0 and pdIdx1 == peakIdx_) or (pdKind2 == 0 and pdIdx2 == peakIdx_))
                if lk2 != 0 and not blockDup2
                    addSH(peakIdx_)
                    addEv(i, 0, peakIdx_, array.get(H_, peakIdx_))
                    troughIdx_ := i
        else
            // BULLISH: Low first, then High
            if array.get(L_, i) < array.get(L_, troughIdx_)
                troughIdx_ := i
            if brkL
                lk3 = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                blockDup3 = prevDual and not dualAct and ((pdKind1 == 0 and pdIdx1 == peakIdx_) or (pdKind2 == 0 and pdIdx2 == peakIdx_))
                if lk3 != 0 and not blockDup3
                    addSH(peakIdx_)
                    addEv(i, 0, peakIdx_, array.get(H_, peakIdx_))
                    troughIdx_ := i
            if array.get(H_, i) > array.get(H_, peakIdx_)
                peakIdx_ := i
            if brkH
                lk4 = array.size(events) > 0 ? array.get(events, array.size(events) - 1).kind : -1
                blockDup4 = prevDual and not dualAct and ((pdKind1 == 1 and pdIdx1 == troughIdx_) or (pdKind2 == 1 and pdIdx2 == troughIdx_))
                if lk4 != 1 and not blockDup4
                    addSL(troughIdx_)
                    addEv(i, 1, troughIdx_, array.get(L_, troughIdx_))
                    peakIdx_ := i

        // ========== REGIME / MSS / IVI ENGINE ==========
        k = i
        evTotal = array.size(events)

        // STEP 0: peek-ahead — update lastSWHidx/lastSWLidx
        peek0 = ei
        while peek0 < evTotal
            pEv = array.get(events, peek0)
            if pEv.confirmIdx != k
                break
            if pEv.kind == 0
                lastSWHidx := pEv.swingIdx
            else
                lastSWLidx := pEv.swingIdx
            peek0 += 1

        prevReg = regime
        swhCons = false
        swlCons = false
        aobSWHi = swhIdx
        aobSWLi = swlIdx

        // STEP 1 + MID-ARM: break checks, MSS, IVI, AVI
        kBull = array.get(C_, k) >= array.get(O_, k)

        if not kBull
            // --- BEARISH bar: high first -> SWH break first ---
            if haveSWH and array.get(H_, k) > swhPrice
                if regime == 0
                    regime := 1
                else if regime == 2
                    regime := 1
                    addMss(k, swhIdx, swhPrice, true)
                if lastSWLidx >= 0
                    lo = math.min(math.min(lastSWLidx, k), swhIdx)
                    hi = math.max(math.max(lastSWLidx, k), swhIdx)
                    tryCreateIVIs(lo, hi, true, k)
                    viBullScanUpto := hi
                haveSWH := false
                swhCons := true

            // MID-ARM
            peek2 = ei
            while peek2 < evTotal
                pEv2 = array.get(events, peek2)
                if pEv2.confirmIdx != k
                    break
                if pEv2.kind == 0
                    haveSWH  := true
                    swhPrice := pEv2.price
                    swhIdx   := pEv2.swingIdx
                    tryBearAVI(prevReg, aobSWLi, pEv2.swingIdx, pEv2.price, k)
                else
                    haveSWL  := true
                    swlPrice := pEv2.price
                    swlIdx   := pEv2.swingIdx
                    tryBullAVI(prevReg, aobSWHi, pEv2.swingIdx, pEv2.price, k)
                peek2 += 1

            // Second break: SWL
            if haveSWL and array.get(L_, k) < swlPrice
                if regime == 0
                    regime := 2
                else if regime == 1
                    regime := 2
                    addMss(k, swlIdx, swlPrice, false)
                if lastSWHidx >= 0
                    lo2 = math.min(math.min(lastSWHidx, k), swlIdx)
                    hi2 = math.max(math.max(lastSWHidx, k), swlIdx)
                    tryCreateIVIs(lo2, hi2, false, k)
                    viBearScanUpto := hi2
                haveSWL := false
                swlCons := true

        else
            // --- BULLISH bar: low first -> SWL break first ---
            if haveSWL and array.get(L_, k) < swlPrice
                if regime == 0
                    regime := 2
                else if regime == 1
                    regime := 2
                    addMss(k, swlIdx, swlPrice, false)
                if lastSWHidx >= 0
                    lo3 = math.min(math.min(lastSWHidx, k), swlIdx)
                    hi3 = math.max(math.max(lastSWHidx, k), swlIdx)
                    tryCreateIVIs(lo3, hi3, false, k)
                    viBearScanUpto := hi3
                haveSWL := false
                swlCons := true

            // MID-ARM
            peek3 = ei
            while peek3 < evTotal
                pEv3 = array.get(events, peek3)
                if pEv3.confirmIdx != k
                    break
                if pEv3.kind == 0
                    haveSWH  := true
                    swhPrice := pEv3.price
                    swhIdx   := pEv3.swingIdx
                    tryBearAVI(prevReg, aobSWLi, pEv3.swingIdx, pEv3.price, k)
                else
                    haveSWL  := true
                    swlPrice := pEv3.price
                    swlIdx   := pEv3.swingIdx
                    tryBullAVI(prevReg, aobSWHi, pEv3.swingIdx, pEv3.price, k)
                peek3 += 1

            // Second break: SWH
            if haveSWH and array.get(H_, k) > swhPrice
                if regime == 0
                    regime := 1
                else if regime == 2
                    regime := 1
                    addMss(k, swhIdx, swhPrice, true)
                if lastSWLidx >= 0
                    lo4 = math.min(math.min(lastSWLidx, k), swhIdx)
                    hi4 = math.max(math.max(lastSWLidx, k), swhIdx)
                    tryCreateIVIs(lo4, hi4, true, k)
                    viBullScanUpto := hi4
                haveSWH := false
                swhCons := true

        // STEP 1b: continuous IVI scan — keeps checking the newest 2-candle
        // window every bar for as long as the current regime persists, not
        // just once at the exceedance moment. 2-candle version of FVG's
        // STEP 1b (close[k-1] vs open[k] instead of high[k-2] vs low[k]).
        if regime == 1 and k >= 1 and k > viBullScanUpto
            cl1c = array.get(C_, k - 1)
            op2c = array.get(O_, k)
            if cl1c < op2c
                addVI(k - 1, cl1c, op2c, true, k, 0)
            viBullScanUpto := k
        if regime == 2 and k >= 1 and k > viBearScanUpto
            cl1d = array.get(C_, k - 1)
            op2d = array.get(O_, k)
            if cl1d > op2d
                addVI(k - 1, op2d, cl1d, false, k, 0)
            viBearScanUpto := k

        // STEP 2: arm swings (consumed check) + IVI eligibility. Same
        // pendingEligIdx-bounded design as the finalized FVG file (this
        // was a 20s-timeout fix there; here it's just how it's built).
        while ei < evTotal
            sEv = array.get(events, ei)
            if sEv.confirmIdx != k
                break
            if sEv.kind == 0
                if not swhCons
                    haveSWH  := true
                    swhPrice := sEv.price
                    swhIdx   := sEv.swingIdx
                lastSWHidx := sEv.swingIdx
                p0 = array.size(pendingEligIdx) - 1
                while p0 >= 0
                    zfP = array.get(pendingEligIdx, p0)
                    viZP = array.get(vis, zfP)
                    if viZP.bullish and viZP.state == 0 and viZP.eligibleK == -1 and k > viZP.triggerK
                        viZP.eligibleK := k
                        array.set(vis, zfP, viZP)
                        lastP0 = array.size(pendingEligIdx) - 1
                        array.set(pendingEligIdx, p0, array.get(pendingEligIdx, lastP0))
                        array.pop(pendingEligIdx)
                    p0 -= 1
            else
                if not swlCons
                    haveSWL  := true
                    swlPrice := sEv.price
                    swlIdx   := sEv.swingIdx
                lastSWLidx := sEv.swingIdx
                p1 = array.size(pendingEligIdx) - 1
                while p1 >= 0
                    zfP2 = array.get(pendingEligIdx, p1)
                    viZP2 = array.get(vis, zfP2)
                    if not viZP2.bullish and viZP2.state == 0 and viZP2.eligibleK == -1 and k > viZP2.triggerK
                        viZP2.eligibleK := k
                        array.set(vis, zfP2, viZP2)
                        lastP1 = array.size(pendingEligIdx) - 1
                        array.set(pendingEligIdx, p1, array.get(pendingEligIdx, lastP1))
                        array.pop(pendingEligIdx)
                    p1 -= 1
            ei += 1

        // STEP 3: IVI/AVI lifecycle at this candle. Same liveIdx-bounded
        // design as the finalized FVG file.
        hK = array.get(H_, k)
        lK = array.get(L_, k)
        m3 = array.size(liveIdx) - 1
        while m3 >= 0
            zf3 = array.get(liveIdx, m3)
            viZ3 = array.get(vis, zf3)
            becameSpent = false

            zbf = viZ3.zb
            ztf = viZ3.zt
            bullf = viZ3.bullish

            // IMPACT: any wick reaching into the gap, once eligible, ends it.
            if viZ3.eligibleK != -1 and k >= viZ3.eligibleK
                if hK >= zbf and lK <= ztf
                    viZ3.preSpentState := viZ3.state
                    viZ3.state := 3
                    viZ3.stopK := k
                    array.set(vis, zf3, viZ3)
                    becameSpent := true

            // CLOSE-THROUGH INVALIDATION -- IVI only (origin 0). See file
            // header for why: an AVI zone starts already on the far side
            // of price by design, so this check would kill it on day one
            // of eligibility if applied to it (FVG issue 2's bug, never
            // introduced here).
            if not becameSpent and viZ3.origin != 1 and viZ3.state == 0 and viZ3.eligibleK != -1 and k >= viZ3.eligibleK
                cK = array.get(C_, k)
                closedThrough = bullf ? cK < zbf : cK > ztf
                if closedThrough
                    viZ3.preSpentState := viZ3.state
                    viZ3.state := 3
                    viZ3.stopK := k
                    array.set(vis, zf3, viZ3)
                    becameSpent := true

            // STRANDING -> OVI: origin decides the rule -- IVI-style
            // (origin 0) strands on the FAR side, mirroring IFOB/IFVG;
            // AVI-style (origin 1) strands on the NEAR side, mirroring
            // AOB/AFVG. Safe to mirror AFVG's exact formula here (unlike
            // RB's ARB, which had a DIFFERENT bull/bear tagging convention
            // and needed the formula flipped) -- VI's AVI uses the SAME
            // hunt-direction tagging as AFVG, so the geometry lines up
            // identically.
            if not becameSpent and (viZ3.state == 0 or viZ3.state == 1) and viZ3.eligibleK != -1
                isIviLike = viZ3.origin != 1
                for e2 = evBeforeSwing to evTotal - 1
                    if e2 < 0 or e2 >= evTotal
                        continue
                    stEv = array.get(events, e2)
                    if stEv.confirmIdx != k
                        continue
                    strandedV = false
                    if isIviLike
                        if bullf and stEv.kind == 1 and stEv.price > ztf
                            strandedV := true
                        if not bullf and stEv.kind == 0 and stEv.price < zbf
                            strandedV := true
                    else
                        if bullf and stEv.kind == 0 and stEv.price < zbf
                            strandedV := true
                        if not bullf and stEv.kind == 1 and stEv.price > ztf
                            strandedV := true
                    if strandedV
                        viZ3.state := 2
                        array.set(vis, zf3, viZ3)
                        break

            if becameSpent
                lastM3 = array.size(liveIdx) - 1
                array.set(liveIdx, m3, array.get(liveIdx, lastM3))
                array.pop(liveIdx)
            m3 -= 1

// ===================== DRAWING (last bar only) =====================
if barstate.islast
    // Delete previous drawings
    lblSzD = array.size(drawnLabels)
    for lb = 0 to lblSzD - 1
        if lb < 0 or lb >= lblSzD
            continue
        label.delete(array.get(drawnLabels, lb))
    array.clear(drawnLabels)
    boxSzD = array.size(drawnBoxes)
    for bx = 0 to boxSzD - 1
        if bx < 0 or bx >= boxSzD
            continue
        box.delete(array.get(drawnBoxes, bx))
    array.clear(drawnBoxes)
    lnSzD = array.size(drawnLines)
    for ln = 0 to lnSzD - 1
        if ln < 0 or ln >= lnSzD
            continue
        line.delete(array.get(drawnLines, ln))
    array.clear(drawnLines)

    nArr = array.size(O_)
    if nArr < 2
        runtime.error("Insufficient data")

    // Compute display-from time threshold (milliseconds)
    dispFrom = useDisplayFrom ? InpDisplayFrom : (time - InpMonthsBack * 30 * 24 * 60 * 60 * 1000)

    // OVI hidden on 5m/1h/4h, same treatment as OOB/OFVG in the other scripts.
    hideOOBHere = timeframe.period == "5" or timeframe.period == "60" or timeframe.period == "240"

    // --- Swing HIGHS: blue up arrow ---
    shSz = array.size(swHighs)
    shStart = math.max(0, shSz - InpMaxLabelsPerCategory)
    for s = shStart to shSz - 1
        if s < 0 or s >= shSz
            continue
        idx = array.get(swHighs, s)
        if idx < 0 or idx >= nArr
            continue
        bt = array.get(BT, idx)
        if bt < dispFrom
            continue
        yP = array.get(H_, idx)
        lbl = label.new(bt, yP, "▲", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=color.blue, size=size.small)
        array.push(drawnLabels, lbl)

    // --- Swing LOWS: black down arrow ---
    slSz = array.size(swLows)
    slStart = math.max(0, slSz - InpMaxLabelsPerCategory)
    for s = slStart to slSz - 1
        if s < 0 or s >= slSz
            continue
        idx = array.get(swLows, s)
        if idx < 0 or idx >= nArr
            continue
        bt = array.get(BT, idx)
        if bt < dispFrom
            continue
        yP = array.get(L_, idx) - swLowGapOffset
        lbl = label.new(bt, yP, "▼", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=color.black, size=size.small)
        array.push(drawnLabels, lbl)

    // --- MSS flips: cross mark at broken swing's location ---
    mssSz = array.size(msses)
    mssStart = math.max(0, mssSz - InpMaxLabelsPerCategory)
    for m = mssStart to mssSz - 1
        if m < 0 or m >= mssSz
            continue
        mEv = array.get(msses, m)
        bIdx = mEv.brokenIdx
        if bIdx < 0 or bIdx >= nArr
            continue
        bt = array.get(BT, bIdx)
        if bt < dispFrom
            continue
        isUp = mEv.toUp
        yP = isUp ? array.get(H_, bIdx) : array.get(L_, bIdx) - swLowGapOffset
        col = isUp ? color.blue : color.black
        lbl = label.new(bt, yP, "✕", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_none, textcolor=col, size=size.small)
        array.push(drawnLabels, lbl)

    extT = time + 50 * timeframe.in_seconds() * 1000

    // --- IVI/AVI zones: filled box (solid border) + gray dotted 50%
    // midline. Live IVI: blue/black by direction. Live AVI: green,
    // matching AOB/AFVG. OVI (either origin, once stranded): red, same as
    // OOB/OFVG. SPENT zones are colored by preSpentState (dStV), same as
    // FVG -- shown as whatever they were right before getting hit.
    //
    // Capped independently per category (IVI vs AVI, by origin), AND by
    // chronological leftIdx rather than raw array-insertion position --
    // same reasoning as FVG's drawing loop (a single break-time scan can
    // push a batch of gaps at once, while the continuous per-bar scan
    // pushes one at a time; slicing by insertion order would let months of
    // continuous-scan pushes bury an entire still-relevant historical
    // batch).
    viSzD = array.size(vis)
    iviLeft = array.new<int>()
    aviLeft = array.new<int>()
    for zf = 0 to viSzD - 1
        vScan = array.get(vis, zf)
        if vScan.origin == 1
            array.push(aviLeft, vScan.leftIdx)
        else
            array.push(iviLeft, vScan.leftIdx)
    array.sort(iviLeft, order.descending)
    array.sort(aviLeft, order.descending)
    iviCutoff = array.size(iviLeft) > 0 ? array.get(iviLeft, math.min(InpMaxViPerCategory, array.size(iviLeft)) - 1) : 999999999
    aviCutoff = array.size(aviLeft) > 0 ? array.get(aviLeft, math.min(InpMaxViPerCategory, array.size(aviLeft)) - 1) : 999999999
    for zf = 0 to viSzD - 1
        vD = array.get(vis, zf)
        idxV = vD.leftIdx
        if idxV < 0 or idxV >= nArr
            continue
        catCutoff = vD.origin == 1 ? aviCutoff : iviCutoff
        if idxV < catCutoff
            continue

        btV = array.get(BT, idxV)
        if btV < dispFrom
            continue

        dStV = vD.state == 3 ? vD.preSpentState : vD.state
        if dStV == 2 and hideOOBHere
            continue

        leftTV = btV
        rightTV = extT
        if vD.stopK != -1 and vD.stopK < nArr
            rightTV := array.get(BT, vD.stopK)

        colV = dStV == 2 ? color.red : dStV == 1 ? color.green : (vD.bullish ? color.blue : color.black)

        bxV = box.new(leftTV, vD.zt, rightTV, vD.zb, border_color=colV, border_width=1,
                      bgcolor=color.new(colV, InpViFillTransparency), xloc=xloc.bar_time)
        array.push(drawnBoxes, bxV)

        midY = (vD.zt + vD.zb) / 2
        lnV = line.new(leftTV, midY, rightTV, midY, xloc=xloc.bar_time, color=color.gray,
                       style=line.style_dotted, width=1)
        array.push(drawnLines, lnV)

    // Opt-in debug label: shows the SINGLE zone whose leftIdx candle is
    // nearest InpFocusViDate -- same cost-bounded standalone scan as the
    // finalized FVG file (no label/string work per entry, at most one
    // label drawn regardless of history size).
    if InpDebugValues
        nearestZf = -1
        nearestDiff = -1
        for zfN = 0 to viSzD - 1
            vN = array.get(vis, zfN)
            idxN = vN.leftIdx
            if idxN < 0 or idxN >= nArr
                continue
            diffN = math.abs(array.get(BT, idxN) - InpFocusViDate)
            if nearestZf == -1 or diffN < nearestDiff
                nearestZf := zfN
                nearestDiff := diffN
        if nearestZf != -1
            vNear = array.get(vis, nearestZf)
            btNear = array.get(BT, vNear.leftIdx)
            dbgTxtV = "state=" + str.tostring(vNear.state) + " orig=" + str.tostring(vNear.origin) +
                      "\nleftIdx=" + str.tostring(vNear.leftIdx) + " trigK=" + str.tostring(vNear.triggerK) +
                      " eligK=" + str.tostring(vNear.eligibleK) + " stopK=" + str.tostring(vNear.stopK)
            lblV = label.new(btNear, vNear.zt, dbgTxtV, xloc=xloc.bar_time, yloc=yloc.price,
                             style=label.style_label_down, color=color.purple, textcolor=color.white, size=size.small)
            array.push(drawnLabels, lblV)
